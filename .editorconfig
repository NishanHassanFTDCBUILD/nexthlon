# Editor settings shared by every editor (VS Code, WebStorm, Vim...), so code is
# typed in the same style that Prettier writes. https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[*.ejs]
max_line_length = off
