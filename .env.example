# Copy this file to .env and fill in the values. Never commit .env to Git.
NODE_ENV=development
PORT=3000
# Local: mongodb://127.0.0.1:27017/nexthlon
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexthlon?retryWrites=true&w=majority
# Replace <password> (special characters URL-encoded) and keep the database name (/nexthlon) before the ?.
# Test it with: npm run db:check   (step by step: docs/HOSTING-SETUP.md)
MONGODB_URI=mongodb://127.0.0.1:27017/nexthlon
# Connections to MongoDB per copy of the app, 1 to 100 (default 20). Atlas's free tier allows 500 in all.
MONGODB_MAX_POOL=

# Make a long random secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts. All three may be left empty to use the defaults shown in the comments.
#
# The ACCESS token is the JWT in the nx_token / nx_admin cookie. It is sent on every request and
# cannot be withdrawn once issued, so it is deliberately short. Default 15m, never more than 1h.
ACCESS_TOKEN_EXPIRES_IN=
# The REFRESH token is the random string in the nx_refresh cookie. It is only ever sent to
# POST /api/auth/refresh, it is stored (hashed) in the database and so it CAN be revoked at any
# time. This is how long someone stays signed in without typing their password. Default 7d, max 30d.
REFRESH_TOKEN_EXPIRES_IN=
# The same for the admin console, which is kept shorter. Default 1d, max 7d.
ADMIN_REFRESH_TOKEN_EXPIRES_IN=

# JWT_EXPIRES_IN is no longer read: ACCESS_TOKEN_EXPIRES_IN replaced it.

# The private address of the admin console, for example /nx-console-7f3k (one path segment).
# Pick something hard to guess and share it only with your admins. Defaults to /admin if empty.
ADMIN_PATH=

# Used by "npm run seed:admin" to create the first administrator.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay (online payments). Use TEST MODE keys from https://dashboard.razorpay.com
# (Settings > API Keys). The webhook secret is the one you type when you add the webhook
# (Settings > Webhooks) pointing at https://<your-domain>/api/payments/razorpay/webhook
# with the events payment.captured, payment.failed and refund.processed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP) for order emails, cart reminders and campaigns. Leave empty in development:
# the emails are then printed to the console instead of being sent.
# Email: MAIL_DRIVER=smtp (SMTP_* below) or brevo (BREVO_API_KEY, works from any host over HTTPS).
MAIL_DRIVER=smtp
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# The store's public address: no path, no trailing slash, and https in production. REQUIRED in production:
# password-reset and email-confirmation emails link to it (it is never taken from the request, because a
# forged Host header could point a reset link at someone else's website). For example https://www.nexthlon.in
SITE_URL=

# Every admin must turn on two-step login (Admin > Security) before they can use the console.
# On by default in production (an admin without it is sent to the Security page to set it up first).
# false turns it off (not recommended on a live store); true also turns it on while developing.
ADMIN_REQUIRE_2FA=

# Production only: how many proxies sit in front of the app, from 0 to 5. A hosting platform's load
# balancer is 1 (the default in production); Cloudflare in front of a host is 2. Too low, and every
# visitor looks like the proxy, so one rate limit covers everyone. Too high, and a visitor can fake
# their address. Leave empty in development (no proxy).
TRUST_PROXY=

# Error alerts (Sentry, https://sentry.io). Leave SENTRY_DSN empty to switch them off. Cookies,
# headers, request bodies and visitors' details are never sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Which build is running, shown in alerts. Set it to the Git commit in your deploy, e.g. $(git rev-parse --short HEAD).
APP_RELEASE=

# Logging: error, warn, info or debug (default info). Secrets and card details are never logged.
LOG_LEVEL=info
# text (default, easy to read in a terminal) or json (one object per line, for log tools).
LOG_FORMAT=

# Where uploaded product photos are kept.
#   local  this server's disk (public/uploads): for development. A host wipes its disk on every deploy.
#   s3     a bucket (Cloudflare R2, Amazon S3...), served from STORAGE_PUBLIC_URL: for production.
# Cloudflare R2 example (see docs/HOSTING-SETUP.md):
STORAGE_DRIVER=local
# Cloudinary (no card for the free plan): STORAGE_DRIVER=cloudinary and the three values from its dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where visitors download photos from, no trailing slash. Use your own domain from day one: the address is
# saved with every photo.
STORAGE_PUBLIC_URL=

# ---------- Scaling out (docs/SCALING.md) ----------
# Copies of the app on this server: "auto" is one per CPU core (empty or 1: a single copy).
# Keep WEB_CONCURRENCY x MONGODB_MAX_POOL x number of servers under 500 on Atlas's free tier.
WEB_CONCURRENCY=
# How long a CDN (Cloudflare) may keep a page for signed-out visitors, 0 to 600 seconds
# (empty: 60 in production, off in development). Browsers never keep it.
PUBLIC_CACHE_SECONDS=
# Optional Redis (rediss://...): rate limits and cache clearing shared by every copy and server.
# Leave empty with one server.
REDIS_URL=

# Background jobs (order emails, cart reminders). They run inside the web server; for a separate
# worker set JOBS_ENABLED=false on the web copies and run `npm run worker` elsewhere.
JOBS_ENABLED=true
JOBS_CONCURRENCY=2
# true: remind abandoned carts automatically every hour (otherwise only the admin button sends them)
CART_RECOVERY_AUTO=false

# ---------- Store details (footer, policy pages, invoices, emails) ----------
# India's e-commerce rules and Razorpay need the real ones before you go live; the startup check warns
# in production while any is missing (the site shows a [placeholder] instead).
STORE_LEGAL_NAME=
STORE_ADDRESS=
STORE_GSTIN=
# The state your GST registration is in, spelled as in the address form (decides CGST + SGST or IGST).
STORE_STATE=Kerala
# regular (tax invoices with GST shown) or composition (a "bill of supply" without tax)
STORE_GST_SCHEME=regular
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
STORE_GRIEVANCE_OFFICER=
