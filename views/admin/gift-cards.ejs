<%- include('../partials/admin-start', { section: 'gift-cards', page: 'gift-cards' }) %>
<header class="admin-top">
  <div>
    <span class="section-kicker">Sales</span>
    <h1>Gift cards</h1>
    <p class="muted">Cards issued when a gift card order is paid. A code works once. Switch one off if it was issued by mistake or lost.</p>
  </div>
</header>
<nav class="admin-filter-chips" aria-label="Filter by status">
  <a href="<%= adminPath %>/gift-cards" class="<%= !status ? 'is-active' : '' %>">All</a>
  <a href="<%= adminPath %>/gift-cards?status=active" class="<%= status === 'active' ? 'is-active' : '' %>">Active</a>
  <a href="<%= adminPath %>/gift-cards?status=redeemed" class="<%= status === 'redeemed' ? 'is-active' : '' %>">Redeemed</a>
  <a href="<%= adminPath %>/gift-cards?status=disabled" class="<%= status === 'disabled' ? 'is-active' : '' %>">Switched off</a>
</nav>
<div class="table-wrap">
  <table class="table">
    <thead>
      <tr><th scope="col">Code</th><th scope="col">Value</th><th scope="col">Status</th><th scope="col">Order</th><th scope="col">Redeemed by</th><th scope="col">Expires</th><th scope="col"><span class="sr-only">Actions</span></th></tr>
    </thead>
    <tbody>
      <% if (!cards.length) { %>
      <tr><td colspan="7" class="muted">No gift cards yet. They appear here once a gift card order is paid.</td></tr>
      <% } %>
      <% cards.forEach(function (c) { %>
      <tr>
        <td data-label="Code"><code><%= c.code %></code></td>
        <td data-label="Value"><%= formatPrice(c.amount) %></td>
        <td data-label="Status"><span class="pill <%= c.status === 'active' ? 'pill-green' : c.status === 'redeemed' ? 'pill-grey' : 'pill-red' %>"><%= c.status === 'active' ? 'Active' : c.status === 'redeemed' ? 'Redeemed' : 'Switched off' %></span></td>
        <td data-label="Order"><%= c.order ? String(c.order) : '—' %></td>
        <td data-label="Redeemed by"><%= c.redeemedBy ? c.redeemedBy.email : '—' %></td>
        <td data-label="Expires"><%= formatDate(c.expiresAt) %></td>
        <td data-label="Actions"><% if (c.status === 'active') { %><button type="button" class="btn btn-ghost btn-sm" data-gift-disable="<%= c._id %>">Switch off</button><% } %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/admin-end') %>
