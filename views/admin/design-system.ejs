<%- include('../partials/head', { bodyClass: 'admin-body' }) %>

<%
  const colours = [
    ['--brand', 'Brand orange'], ['--brand-ink', 'Brand ink'], ['--brand-soft', 'Brand soft'], ['--navy-900', 'Navy 900'], ['--navy-700', 'Navy 700'],
    ['--success', 'Success'], ['--warning', 'Warning'], ['--danger', 'Danger'], ['--info', 'Info'], ['--deal', 'Deal'],
    ['--bg', 'Page'], ['--surface', 'Surface'], ['--surface-2', 'Surface 2'], ['--surface-3', 'Surface 3'], ['--line', 'Line'],
    ['--ink', 'Ink'], ['--ink-2', 'Ink 2'], ['--muted', 'Muted']
  ];
  const type = [['--text-display', 'Display'], ['--text-hero', 'Hero'], ['--text-4xl', '4XL'], ['--text-3xl', '3XL'], ['--text-2xl', '2XL'], ['--text-xl', 'XL'], ['--text-lg', 'LG'], ['--text-md', 'MD'], ['--text-base', 'Base'], ['--text-sm', 'SM'], ['--text-xs', 'XS']];
  const spaces = ['--space-half', '--space-1', '--space-1h', '--space-2', '--space-3', '--space-4', '--space-5', '--space-6', '--space-8', '--space-10'];
  const radii = ['--radius-xs', '--radius-sm', '--radius', '--radius-lg', '--radius-xl', '--radius-pill'];
  const shadows = ['--shadow-xs', '--shadow-sm', '--shadow-md', '--shadow-lg', '--shadow-xl', '--shadow-brand'];
  const arts = ['cart', 'heart', 'package-check', 'search', 'wallet', 'users', 'box', 'check'];
%>
<div class="admin-shell">
  <%- include('../partials/admin-sidebar') %>

  <main id="main" class="admin-main ds" data-design-system>
    <header class="admin-top">
      <div>
        <span class="section-kicker">Design system</span>
        <h1>Nexthlon UI kit</h1>
        <p class="muted">Every token and component the store and the admin are built from. All of them follow light and dark mode.</p>
      </div>
      <div class="admin-top-actions">
        <div class="segmented" role="group" aria-label="Theme">
          <button type="button" class="ds-theme" data-ds-theme="system"><%- icon('monitor', 'i-sm') %> System</button>
          <button type="button" class="ds-theme" data-ds-theme="light"><%- icon('sun', 'i-sm') %> Light</button>
          <button type="button" class="ds-theme" data-ds-theme="dark"><%- icon('moon', 'i-sm') %> Dark</button>
        </div>
      </div>
    </header>

    <section class="panel ds-section" data-reveal aria-labelledby="ds-colours">
      <h2 id="ds-colours" class="panel-title">Colours</h2>
      <ul class="ds-swatches">
        <% colours.forEach(function ([token, label]) { %>
          <li><span class="ds-swatch" style="background: var(<%= token %>)"></span><strong><%= label %></strong><code><%= token %></code></li>
        <% }) %>
      </ul>
    </section>

    <section class="panel ds-section" data-reveal aria-labelledby="ds-type">
      <h2 id="ds-type" class="panel-title">Type scale <span class="muted">(fluid from 360px to 1440px)</span></h2>
      <ul class="ds-type">
        <% type.forEach(function ([token, label]) { %>
          <li><code><%= label %></code><span style="font-size: var(<%= token %>)" class="<%= ['--text-display', '--text-hero', '--text-4xl'].includes(token) ? 'ds-display' : '' %>">Built for every athlete</span></li>
        <% }) %>
      </ul>
    </section>

    <div class="ds-grid">
      <section class="panel ds-section" data-reveal aria-labelledby="ds-space">
        <h2 id="ds-space" class="panel-title">Spacing (8px scale)</h2>
        <ul class="ds-spaces">
          <% spaces.forEach(function (token) { %><li><span class="ds-space" style="width: var(<%= token %>)"></span><code><%= token %></code></li><% }) %>
        </ul>
      </section>
      <section class="panel ds-section" data-reveal aria-labelledby="ds-shape">
        <h2 id="ds-shape" class="panel-title">Radius and elevation</h2>
        <div class="ds-shapes">
          <% radii.forEach(function (token) { %><span class="ds-radius" style="border-radius: var(<%= token %>)"><code><%= token.replace('--radius', 'r') || 'r' %></code></span><% }) %>
        </div>
        <div class="ds-shapes">
          <% shadows.forEach(function (token) { %><span class="ds-shadow" style="box-shadow: var(<%= token %>)"><code><%= token.replace('--shadow-', '') %></code></span><% }) %>
        </div>
      </section>
    </div>

    <section class="panel ds-section" data-reveal aria-labelledby="ds-buttons">
      <h2 id="ds-buttons" class="panel-title">Buttons</h2>
      <div class="ds-row">
        <button type="button" class="btn btn-primary">Primary</button>
        <button type="button" class="btn btn-gradient">Gradient</button>
        <button type="button" class="btn btn-secondary">Secondary</button>
        <button type="button" class="btn btn-ghost">Ghost</button>
        <button type="button" class="btn btn-danger">Danger</button>
        <button type="button" class="btn btn-danger-soft">Danger soft</button>
        <button type="button" class="btn btn-primary" disabled>Disabled</button>
        <button type="button" class="btn btn-primary" data-ds-loading>Click to load</button>
      </div>
      <div class="ds-row">
        <button type="button" class="btn btn-primary btn-xs">Extra small</button>
        <button type="button" class="btn btn-primary btn-sm">Small</button>
        <button type="button" class="btn btn-primary">Medium</button>
        <button type="button" class="btn btn-primary btn-lg">Large</button>
        <button type="button" class="btn btn-ghost btn-pill"><%- icon('heart', 'i-sm') %> Pill</button>
        <button type="button" class="icon-btn" aria-label="Search" data-tooltip="Search"><%- icon('search') %></button>
        <button type="button" class="icon-btn icon-btn-outline" aria-label="Wishlist" data-tooltip="Wishlist"><%- icon('heart') %></button>
        <button type="button" class="icon-btn icon-btn-brand" aria-label="Add to cart" data-tooltip="Add to cart"><%- icon('cart') %></button>
      </div>
    </section>

    <div class="ds-grid">
      <section class="panel ds-section" data-reveal aria-labelledby="ds-forms">
        <h2 id="ds-forms" class="panel-title">Form controls</h2>
        <form class="form ds-form" novalidate data-ds-form>
          <div class="float-field">
            <input id="ds-name" name="name" placeholder=" " autocomplete="off">
            <label for="ds-name">Full name (floating label)</label>
          </div>
          <div class="float-field">
            <input id="ds-email" name="email" placeholder=" " aria-invalid="true" aria-describedby="ds-email-error" value="not-an-email">
            <label for="ds-email">Email</label>
            <p class="field-error" id="ds-email-error">Enter a valid email address.</p>
          </div>
          <div class="float-field">
            <select id="ds-sport" name="sport"><option>Running</option><option>Football</option><option>Cricket</option></select>
            <label for="ds-sport">Sport (select)</label>
            <%- icon('chevron-down', 'i-sm select-caret') %>
          </div>
          <div class="ds-row">
            <label class="switch"><input type="checkbox" role="switch" checked><span class="switch-track" aria-hidden="true"></span> Email offers</label>
            <label class="check"><input type="checkbox" checked> Checkbox</label>
            <label class="radio"><input type="radio" name="ds-radio" checked> Radio</label>
            <label class="radio"><input type="radio" name="ds-radio"> Another</label>
          </div>
          <div class="option-grid">
            <label class="option-card"><input type="radio" name="ds-plan" checked><span class="option-card-body"><strong>Standard delivery</strong><span class="muted">3 to 5 days · Free</span></span></label>
            <label class="option-card"><input type="radio" name="ds-plan"><span class="option-card-body"><strong>Express</strong><span class="muted">Tomorrow · ₹99</span></span></label>
          </div>
        </form>
      </section>

      <section class="panel ds-section" data-reveal aria-labelledby="ds-badges">
        <h2 id="ds-badges" class="panel-title">Badges, chips, stock and price</h2>
        <div class="ds-row">
          <span class="badge badge-brand">New</span><span class="badge badge-success">In stock</span><span class="badge badge-warning">Low</span><span class="badge badge-danger">Sold out</span><span class="badge badge-deal">Deal</span>
        </div>
        <div class="ds-row">
          <span class="pill pill-blue">Placed</span><span class="pill pill-green">Delivered</span><span class="pill pill-amber">Return requested</span><span class="pill pill-red">Cancelled</span>
          <%- include('../partials/pay-status', { status: 'paid', method: 'razorpay' }) %>
          <%- include('../partials/pay-status', { status: 'pending', method: 'razorpay' }) %>
        </div>
        <div class="chip-group">
          <span class="chip">Running <button type="button" class="chip-remove" aria-label="Remove Running"><%- icon('x') %></button></span>
          <span class="chip">Under ₹2,000 <button type="button" class="chip-remove" aria-label="Remove Under ₹2,000"><%- icon('x') %></button></span>
          <a class="chip chip-plain" href="#ds-badges">4★ and up</a>
        </div>
        <div class="ds-row">
          <span class="stock stock-ok">In stock</span><span class="stock stock-low">Only 3 left</span><span class="stock stock-out">Out of stock</span>
          <span class="rating" style="--rating: 4.3" role="img" aria-label="Rated 4.3 out of 5"></span>
        </div>
        <div class="price-block">
          <div class="price-row"><span class="price price-lg">₹3,899</span><span class="mrp">M.R.P. <s>₹5,999</s></span><span class="off">35% off</span></div>
          <span class="saving">You save ₹2,100</span>
        </div>
        <div class="ds-row">
          <div class="qty" role="group" aria-label="Quantity">
            <button type="button" class="qty-btn" aria-label="Decrease" data-ds-qty="-1"><%- icon('minus', 'i-sm') %></button>
            <span class="qty-value" data-ds-qty-value aria-live="polite">1</span>
            <button type="button" class="qty-btn" aria-label="Increase" data-ds-qty="1"><%- icon('plus', 'i-sm') %></button>
          </div>
          <nav class="breadcrumb" aria-label="Example breadcrumb"><a href="#main">Home</a> <%- icon('chevron-right', 'i-xs') %> <a href="#main">Running</a> <%- icon('chevron-right', 'i-xs') %> <span>Shoes</span></nav>
        </div>
      </section>
    </div>

    <section class="panel ds-section" data-reveal aria-labelledby="ds-overlays">
      <h2 id="ds-overlays" class="panel-title">Overlays and feedback</h2>
      <div class="ds-row">
        <button type="button" class="btn btn-ghost" data-dialog-open="ds-modal">Open modal</button>
        <button type="button" class="btn btn-ghost" data-dialog-open="ds-drawer">Open side drawer</button>
        <button type="button" class="btn btn-ghost" data-dialog-open="ds-sheet">Open bottom sheet</button>
        <button type="button" class="btn btn-ghost" data-ds-confirm>Confirm popup</button>
        <button type="button" class="btn btn-ghost" data-ds-toast="success">Success toast</button>
        <button type="button" class="btn btn-ghost" data-ds-toast="error">Error toast</button>
      </div>
      <div class="ds-grid ds-grid-tight">
        <div class="skeleton-card" aria-hidden="true"><span class="skeleton skeleton-media"></span><span class="skeleton skeleton-line"></span><span class="skeleton skeleton-line is-short"></span></div>
        <div class="state-box"><span class="spinner" aria-hidden="true"></span> Loading orders…</div>
        <div class="state-box is-error"><%- icon('alert', 'i-sm') %> Could not load. Try again.</div>
      </div>
    </section>

    <div class="ds-grid">
      <section class="panel ds-section" data-reveal aria-labelledby="ds-tabs">
        <h2 id="ds-tabs" class="panel-title">Tabs and accordion</h2>
        <div data-tabs>
          <div class="tabs-list" role="tablist" aria-label="Example tabs">
            <button type="button" class="tab" role="tab" id="ds-tab-1" aria-controls="ds-panel-1" aria-selected="true">Details</button>
            <button type="button" class="tab" role="tab" id="ds-tab-2" aria-controls="ds-panel-2" aria-selected="false">Reviews</button>
          </div>
          <div class="tab-panel" role="tabpanel" id="ds-panel-1" aria-labelledby="ds-tab-1" tabindex="0"><p>Breathable mesh upper and a grippy outsole.</p></div>
          <div class="tab-panel" role="tabpanel" id="ds-panel-2" aria-labelledby="ds-tab-2" tabindex="0" hidden><p>4.4 out of 5 from 128 runners.</p></div>
        </div>
        <div class="accordion">
          <details open><summary>How fast is delivery? <%- icon('chevron-down', 'i-sm') %></summary><div class="accordion-body">Most orders arrive in 3 to 5 days.</div></details>
          <details><summary>Can I return it? <%- icon('chevron-down', 'i-sm') %></summary><div class="accordion-body">Yes, within 7 days of delivery.</div></details>
        </div>
      </section>

      <section class="panel ds-section" data-reveal aria-labelledby="ds-table">
        <h2 id="ds-table" class="panel-title">Data table and pagination</h2>
        <div class="data-table-wrap">
          <table class="data-table">
            <thead><tr><th scope="col" aria-sort="descending"><button type="button">Order <%- icon('chevron-down', 'i-xs') %></button></th><th scope="col">Status</th><th scope="col" class="num">Total</th></tr></thead>
            <tbody>
              <tr><td>NX-2026-000123</td><td><span class="pill pill-green">Delivered</span></td><td class="num">₹3,899</td></tr>
              <tr class="is-selected"><td>NX-2026-000122</td><td><span class="pill pill-blue">Shipped</span></td><td class="num">₹1,250</td></tr>
              <tr><td>NX-2026-000121</td><td><span class="pill pill-red">Cancelled</span></td><td class="num">₹799</td></tr>
            </tbody>
          </table>
        </div>
        <%- include('../partials/pagination', { pagination: { page: 2, pages: 5 }, link: function (o) { return '#ds-table'; } }) %>
      </section>
    </div>

    <section class="panel ds-section" data-reveal aria-labelledby="ds-empty">
      <h2 id="ds-empty" class="panel-title">Empty-state illustrations</h2>
      <ul class="ds-arts">
        <% arts.forEach(function (name) { %><li><%- include('../partials/empty-art', { art: name }) %><code><%= name %></code></li><% }) %>
      </ul>
    </section>
  </main>
</div>

<dialog class="modal" id="ds-modal" aria-labelledby="ds-modal-title">
  <div class="modal-head"><h2 id="ds-modal-title">Modal</h2><button type="button" class="icon-btn" data-dialog-close aria-label="Close"><%- icon('x') %></button></div>
  <div class="modal-body"><p>Focus stays inside, and Escape closes it.</p></div>
  <div class="modal-foot"><button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button><button type="button" class="btn btn-primary" data-dialog-close>Save</button></div>
</dialog>
<dialog class="drawer drawer-right" id="ds-drawer" aria-labelledby="ds-drawer-title">
  <div class="drawer-head"><h2 id="ds-drawer-title">Side drawer</h2><button type="button" class="icon-btn" data-dialog-close aria-label="Close"><%- icon('x') %></button></div>
  <div class="drawer-body"><p class="ds-pad">Used for the mini cart and the phone menu.</p></div>
</dialog>
<dialog class="modal sheet" id="ds-sheet" aria-labelledby="ds-sheet-title">
  <span class="sheet-grip" aria-hidden="true"></span>
  <div class="modal-head"><h2 id="ds-sheet-title">Bottom sheet</h2><button type="button" class="icon-btn" data-dialog-close aria-label="Close"><%- icon('x') %></button></div>
  <div class="modal-body"><p>On phones this slides up from the bottom; on wide screens it is a modal.</p></div>
</dialog>

<%- include('../partials/scripts', { scripts: ['design-system'] }) %>
