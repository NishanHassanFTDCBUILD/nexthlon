<%- include('../partials/head', { bodyClass: 'au-body cr-body', styles: ['auth'], preload3d: ['auth3d'] }) %>

<%# The admin "control room": a WebGL wireframe globe with glowing data points, a scanning line and a
    terminal that types a greeting. One glass card to sign in; no sign-up here. %>
<main id="main" class="cr" data-auth data-mode="admin">
  <div class="cr-scene" data-globe-scene aria-hidden="true">
    <canvas class="cr-canvas" data-globe-canvas></canvas>
    <div class="cr-fallback"><span></span><span></span></div>
    <div class="cr-grid"></div>
    <div class="cr-scan"></div>
  </div>

  <header class="au-top cr-top">
    <a class="brand brand-light" href="/">
      <span class="brand-mark"><%- icon('bolt') %></span>
      <span class="brand-word">NEXTHLON<small>Control room</small></span><span class="sr-only">, store home</span>
    </a>
    <a class="au-back" href="/"><%- icon('chevron-left', 'i-sm') %> Back to store</a>
  </header>

  <section class="cr-panel" aria-labelledby="cr-title">
    <div class="cr-terminal" aria-hidden="true">
      <span class="cr-terminal-dots"><i></i><i></i><i></i></span>
      <p data-terminal data-text="> Secure admin access…|> Session: encrypted, HttpOnly cookie|> Awaiting credentials">&gt; Secure admin access…</p>
    </div>

    <div class="au-card cr-card" data-tilt-card>
      <div class="au-card-head">
        <span class="cr-badge"><%- icon('shield', 'i-xs') %> Restricted area</span>
        <h1 class="au-title" id="cr-title" data-title>Admin sign in</h1>
        <p class="muted" data-lead>For Nexthlon staff only. Every attempt is rate limited.</p>
      </div>
      <% if (reason === 'blocked') { %>
        <div class="alert alert-danger" role="alert"><%- icon('alert') %> <span>This account has been blocked.</span></div>
      <% } else if (reason === 'expired') { %>
        <div class="alert alert-info" role="status"><%- icon('info') %> <span>Your session has ended. Please sign in again.</span></div>
      <% } %>
      <form class="au-form" data-auth-form data-endpoint="/api/admin/login" data-kind="admin" data-first-step novalidate>
        <div class="form-alert" data-form-alert aria-live="assertive"></div>
        <input type="hidden" name="next" value="<%= next %>">
        <%- include('../partials/auth-field', { id: 'admin-email', name: 'email', label: 'Admin email', type: 'email', fieldIcon: 'mail', autocomplete: 'username', max: 254, hint: '' }) %>
        <%- include('../partials/auth-field', { id: 'admin-password', name: 'password', label: 'Password', type: 'password', fieldIcon: 'lock', autocomplete: 'current-password', max: 64, hint: '<span class="au-caps" data-caps hidden>Caps Lock is on</span>' }) %>
        <input type="hidden" name="pendingToken" value="">
          <div class="au-twofactor" data-twofactor hidden>
            <label class="au-label" for="admin-code">Code from your authenticator app</label>
            <input id="admin-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="12" placeholder="6-digit code or a recovery code">
          </div>
          <button class="au-submit" type="submit" data-submit data-magnetic>
          <span class="au-submit-label">Enter the console</span>
          <svg class="au-submit-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
          <svg class="au-submit-tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        </button>
      </form>
      <p class="au-foot muted"><%- icon('user', 'i-xs') %> Shopping instead? <a href="/login">Customer sign in</a></p>
    </div>
  </section>
  <div class="au-zoom" data-auth-zoom aria-hidden="true"></div>
</main>

<%- include('../partials/scripts', { scripts: ['auth'], modules: ['auth3d'] }) %>
