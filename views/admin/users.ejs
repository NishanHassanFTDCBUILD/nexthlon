
<%
  const pageList = [];
  for (let n = 1; n <= pagination.pages; n++) {
    if (n === 1 || n === pagination.pages || Math.abs(n - pagination.page) <= 1) pageList.push(n);
    else if (pageList[pageList.length - 1] !== '…') pageList.push('…');
  }
%>
<%- include('../partials/admin-start', { section: 'customers' }) %>
    <header class="admin-top">
      <div>
        <span class="section-kicker">People</span>
        <h1>Customers</h1>
        <p class="muted"><%= pagination.total %> <%= pagination.total === 1 ? 'customer' : 'customers' %> found. Blocked customers cannot sign in or use their account.</p>
      </div>
    </header>

    <div class="toolbar">
      <form class="toolbar-search" action="<%= adminPath %>/customers" method="get" role="search" aria-label="Search customers">
        <% if (filters.status !== 'all') { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
        <label class="sr-only" for="user-search">Search customers</label>
        <%- icon('search', 'i-sm') %>
        <input id="user-search" type="search" name="q" value="<%= filters.q %>" placeholder="Search by name, email or phone" maxlength="80">
        <% if (filters.q) { %>
          <a class="icon-btn icon-btn-sm" href="<%= link({ q: '', page: '' }) %>" aria-label="Clear search"><%- icon('x', 'i-sm') %></a>
        <% } %>
        <button class="btn btn-primary btn-sm" type="submit">Search</button>
      </form>
      <nav class="segmented" aria-label="Filter by status">
        <a href="<%= link({ status: '', page: '' }) %>" class="<%= filters.status === 'all' ? 'is-active' : '' %>" <%- filters.status === 'all' ? 'aria-current="page"' : '' %>>All</a>
        <a href="<%= link({ status: 'active', page: '' }) %>" class="<%= filters.status === 'active' ? 'is-active' : '' %>" <%- filters.status === 'active' ? 'aria-current="page"' : '' %>><span class="dot dot-ok"></span> Active</a>
        <a href="<%= link({ status: 'blocked', page: '' }) %>" class="<%= filters.status === 'blocked' ? 'is-active' : '' %>" <%- filters.status === 'blocked' ? 'aria-current="page"' : '' %>><span class="dot dot-out"></span> Blocked</a>
      </nav>
    </div>

    <% if (filters.q) { %>
      <p class="filter-note">Showing results for <strong>"<%= filters.q %>"</strong> · <a href="<%= link({ q: '', page: '' }) %>">Clear search</a></p>
    <% } %>

    <section class="panel panel-flush admin-table-panel" aria-label="Customer list">
      <% if (customers.length) { %>
        <div class="table-wrap">
          <table class="table table-stack admin-table">
            <thead>
              <tr><th scope="col">Customer</th><th scope="col">Phone</th><th scope="col">Joined</th><th scope="col">Last sign-in</th><th scope="col">Status</th><th scope="col">Wallet</th><th scope="col"><span class="sr-only">Action</span></th></tr>
            </thead>
            <tbody>
              <% customers.forEach(function (c) { %>
                <tr data-user-row="<%= c.id %>">
                  <td><div class="person"><span class="avatar avatar-sm"><%= c.name.charAt(0).toUpperCase() %></span><div><strong><%= c.name %></strong><span><%= c.email %></span></div></div></td>
                  <td data-label="Phone"><%= c.phone ? '+91 ' + c.phone : '—' %></td>
                  <td data-label="Joined"><%= formatDate(c.createdAt) %></td>
                  <td data-label="Last sign-in"><%= formatDate(c.lastLoginAt) %></td>
                  <td data-label="Status"><span class="pill <%= c.isBlocked ? 'pill-red' : 'pill-green' %>" data-status><%= c.isBlocked ? 'Blocked' : 'Active' %></span></td>
                  <td data-label="Wallet"><%= formatPrice(c.walletBalance) %></td>
                  <td class="cell-action">
                    <a class="btn btn-ghost btn-sm" href="<%= adminPath %>/customers/<%= c.id %>/wallet" aria-label="Wallet of <%= c.name %>"><%- icon('wallet', 'i-xs') %> Wallet</a>
                    <button type="button" class="btn btn-sm <%= c.isBlocked ? 'btn-secondary' : 'btn-danger-soft' %>"
                            data-block-user="<%= c.id %>" data-blocked="<%= c.isBlocked %>" data-name="<%= c.name %>"
                            aria-label="<%= c.isBlocked ? 'Unblock' : 'Block' %> <%= c.name %>"><%= c.isBlocked ? 'Unblock' : 'Block' %></button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state empty-state-flat">
          <%- include('../partials/empty-art', { art: 'users' }) %>
          <h2>No customers found</h2>
          <p><%= filters.q || filters.status !== 'all' ? 'Try a different search or filter.' : 'Customers appear here as soon as they sign up.' %></p>
          <% if (filters.q || filters.status !== 'all') { %><a class="btn btn-secondary" href="<%= adminPath %>/customers">Show all customers</a><% } %>
        </div>
      <% } %>
      <%- include('../partials/admin-pager') %>
    </section>
<%- include('../partials/admin-end') %>
