<%#
  Sales breakdown: revenue and units by category, and orders and revenue by state, for a period
  (India time). Paid orders only; cancelled and returned items are left out.
%>
<%- include('../partials/admin-start', { section: 'sales-breakdown', page: 'sales-breakdown' }) %>
<header class="admin-top">
  <div>
    <span class="section-kicker">Sales</span>
    <h1>Sales breakdown</h1>
    <p class="muted"><%= from %> to <%= to %> · <%= formatPrice(totals.revenue) %> from <%= totals.units %> <%= totals.units === 1 ? 'unit' : 'units' %> across <%= totals.orders %> <%= totals.orders === 1 ? 'order' : 'orders' %>.</p>
  </div>
  <div class="admin-top-actions">
    <a class="btn btn-primary btn-sm" href="/api/admin/reports/breakdown.csv?from=<%= from %>&amp;to=<%= to %>" download data-full-load><%- icon('download', 'i-sm') %> Download CSV</a>
  </div>
</header>

<form class="admin-filterbar" action="<%= adminPath %>/sales-breakdown" method="get">
  <label class="admin-field"><span>From</span><input type="date" name="from" value="<%= from %>" required></label>
  <label class="admin-field"><span>To</span><input type="date" name="to" value="<%= to %>" required></label>
  <button class="btn btn-secondary btn-sm" type="submit">Show period</button>
</form>

<div class="breakdown-grid">
  <section class="panel admin-block" aria-labelledby="by-category">
    <h2 id="by-category" class="panel-title">By category</h2>
    <% if (categories.length) { %>
      <ul class="breakdown-list">
        <% categories.forEach(function (c) { %>
          <li>
            <span class="breakdown-name"><%= c.name %> <small class="muted"><%= c.units %> <%= c.units === 1 ? 'unit' : 'units' %></small></span>
            <span class="breakdown-bar" aria-hidden="true"><span style="width: <%= Math.max(2, Math.round(c.revenue / maxCategory * 100)) %>%"></span></span>
            <strong><%= formatPrice(c.revenue) %></strong>
          </li>
        <% }) %>
      </ul>
    <% } else { %><p class="muted">No paid sales in this period.</p><% } %>
  </section>

  <section class="panel admin-block" aria-labelledby="by-state">
    <h2 id="by-state" class="panel-title">By state</h2>
    <% if (states.length) { %>
      <ul class="breakdown-list">
        <% states.forEach(function (s) { %>
          <li>
            <span class="breakdown-name"><%= s.name %> <small class="muted"><%= s.orders %> <%= s.orders === 1 ? 'order' : 'orders' %></small></span>
            <span class="breakdown-bar" aria-hidden="true"><span style="width: <%= Math.max(2, Math.round(s.revenue / maxState * 100)) %>%"></span></span>
            <strong><%= formatPrice(s.revenue) %></strong>
          </li>
        <% }) %>
      </ul>
    <% } else { %><p class="muted">No paid orders in this period.</p><% } %>
  </section>
</div>
<%- include('../partials/admin-end') %>
