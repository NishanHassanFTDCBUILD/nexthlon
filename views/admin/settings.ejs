<%#
  Settings: the store numbers an admin may change, and the ones that are fixed in the code.
  Each form posts to /api/admin/settings/ plus its data-settings-form name, and the server checks the
  value against services/settingsService.js LIMITS before saving it.
%>
<%- include('../partials/admin-start', { section: 'settings' }) %>
<header class="admin-top">
  <div>
    <span class="section-kicker">System</span>
    <h1>Settings</h1>
    <p class="muted">Rewards and the rules shoppers see at checkout. Anything you change here takes effect at once.</p>
  </div>
  <div class="admin-top-actions">
    <a class="btn btn-ghost btn-sm" href="<%= adminPath %>/system"><%- icon('monitor', 'i-sm') %> System status</a>
  </div>
</header>

<section class="panel settings-panel" aria-labelledby="referral-title">
  <div class="panel-head panel-head-row">
    <h2 id="referral-title"><%- icon('gift', 'i-sm') %> Referral reward</h2>
    <span class="muted">Credited to both wallets when a new customer signs up with a code</span>
  </div>
  <form class="form settings-form" data-settings-form="referral" novalidate>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <div class="field">
      <label for="referralReward">Reward for each person (₹)</label>
      <input id="referralReward" name="referralReward" type="number" inputmode="numeric" min="0" max="1000" step="1" required value="<%= settings.referralReward / 100 %>" aria-describedby="referralReward-hint referralReward-error">
      <p class="hint" id="referralReward-hint">0 turns referral rewards off. Paid to both people when the new customer's first order is delivered, once per new customer.</p>
      <p class="field-error" id="referralReward-error" data-error-for="referralReward"></p>
    </div>
    <button class="btn btn-primary" type="submit">Save reward</button>
  </form>
</section>

<section class="panel settings-panel" aria-labelledby="cod-title">
  <div class="panel-head panel-head-row">
    <h2 id="cod-title"><%- icon('wallet', 'i-sm') %> Cash on delivery</h2>
    <span class="muted">Shoppers can pay at the door when the order total is up to this amount</span>
  </div>
  <form class="form settings-form" data-settings-form="cod" novalidate>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <div class="field">
      <label for="codLimit">Cash on delivery up to (₹)</label>
      <input id="codLimit" name="codLimit" type="number" inputmode="numeric" min="0" max="50000" step="1" required value="<%= settings.codLimit / 100 %>" aria-describedby="codLimit-hint codLimit-error">
      <p class="hint" id="codLimit-hint">0 turns cash on delivery off. Orders above the limit must be paid online or by wallet. Checkout and product pages update at once.</p>
      <p class="field-error" id="codLimit-error" data-error-for="codLimit"></p>
    </div>
    <button class="btn btn-primary" type="submit">Save limit</button>
  </form>
</section>

<section class="panel settings-panel" aria-labelledby="codotp-title">
  <div class="panel-head panel-head-row">
    <h2 id="codotp-title"><%- icon('shield', 'i-sm') %> Confirm Cash on Delivery by code</h2>
    <span class="muted">A code to the delivery phone stops fake COD orders (once per phone, every 90 days)</span>
  </div>
  <form class="form settings-form" data-settings-form="cod-otp" novalidate>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <div class="field">
      <label for="codOtp">Ask for a code</label>
      <span class="select-wrap"><select id="codOtp" name="codOtp"><option value="off"<%= settings.codOtp ? '' : ' selected' %>>Off</option><option value="on"<%= settings.codOtp ? ' selected' : '' %>>On</option></select></span>
      <p class="hint">Codes go by SMS (MSG91) or WhatsApp, whichever is set up. With neither, no code is asked for.</p>
      <p class="field-error" data-error-for="codOtp"></p>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
  </form>
</section>

<section class="panel settings-panel" aria-labelledby="prepaid-title">
  <div class="panel-head panel-head-row">
    <h2 id="prepaid-title"><%- icon('tag', 'i-sm') %> Discount for paying online</h2>
    <span class="muted">Fewer cash orders means fewer refused parcels and faster money</span>
  </div>
  <form class="form settings-form" data-settings-form="prepaid" novalidate>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <div class="field">
      <label for="prepaidPercent">Percent off (%)</label>
      <input id="prepaidPercent" name="prepaidPercent" type="number" inputmode="numeric" min="0" max="10" step="1" required value="<%= settings.prepaidPercent %>" aria-describedby="prepaidPercent-hint prepaidPercent-error">
      <p class="hint" id="prepaidPercent-hint">0 turns it off. Taken off the items (after any coupon) when the shopper pays by UPI, card or netbanking; never on delivery.</p>
      <p class="field-error" id="prepaidPercent-error" data-error-for="prepaidPercent"></p>
    </div>
    <div class="field">
      <label for="prepaidMax">At most (₹)</label>
      <input id="prepaidMax" name="prepaidMax" type="number" inputmode="numeric" min="0" max="1000" step="1" required value="<%= settings.prepaidMax / 100 %>" aria-describedby="prepaidMax-hint prepaidMax-error">
      <p class="hint" id="prepaidMax-hint">The most one order can save. 0 means no cap.</p>
      <p class="field-error" id="prepaidMax-error" data-error-for="prepaidMax"></p>
    </div>
    <button class="btn btn-primary" type="submit">Save discount</button>
  </form>
</section>

<section class="panel" aria-labelledby="rules-title">
  <div class="panel-head panel-head-row">
    <h2 id="rules-title"><%- icon('truck', 'i-sm') %> Delivery and returns</h2>
    <span class="muted">Fixed in config/store.js, because prices and policy pages are worked out from them</span>
  </div>
  <dl class="admin-facts">
    <div><dt>Delivery fee</dt><dd><%= formatPrice(store.deliveryFee) %></dd></div>
    <div><dt>Free delivery from</dt><dd><%= formatPrice(store.freeDeliveryMin) %></dd></div>
    <div><dt>Return window</dt><dd><%= store.returnDays %> days</dd></div>
    <div><dt>Refunds reach the bank in</dt><dd><%= store.refundDays %></dd></div>
    <div><dt>Dispatch</dt><dd><%= store.dispatchDays %></dd></div>
    <div><dt>Delivery</dt><dd><%= store.deliveryDays %></dd></div>
  </dl>
</section>

<section class="panel" aria-labelledby="catalog-rules-title">
  <div class="panel-head panel-head-row">
    <h2 id="catalog-rules-title"><%- icon('box', 'i-sm') %> Catalogue and checkout rules</h2>
    <span class="muted">Fixed in the code; shown here so you can see what the store is doing</span>
  </div>
  <dl class="admin-facts">
    <div><dt>Low-stock warning at</dt><dd><%= lowStockLimit %> units or fewer</dd></div>
    <div><dt>Most of one product per order</dt><dd><%= maxPerProduct %></dd></div>
    <div><dt>Addresses per customer</dt><dd><%= maxAddresses %></dd></div>
    <div><dt>Admin console address</dt><dd><code class="admin-code"><%= adminPath %></code></dd></div>
  </dl>
</section>
<%- include('../partials/admin-end') %>
