<%
  const canWrite = typeof adminCan !== 'function' || adminCan('inventory.write');
  const pill = {out:'pill-red', low:'pill-amber', healthy:'pill-green'};
  const stateLabel = {out:'Out of stock', low:'Low stock', healthy:'In stock'};
  const tabs = Object.entries(statusLabels);
%>
<%- include('../partials/admin-start', {section:'inventory'}) %>
<div class="stock-workspace">
  <header class="stock-page-header"><div><h1>Inventory</h1><p>Stock by size and color.</p></div><div class="stock-header-actions">
    <a class="btn btn-secondary btn-sm" href="/api/admin/inventory/export.csv?<%= exportQuery %>" download data-full-load><%- icon('download','i-sm') %> Export</a>
    <% if(canWrite) { %><button class="btn btn-secondary btn-sm" type="button" data-stock-open-bulk>Bulk import</button><button class="btn btn-primary btn-sm" type="button" data-inventory-edit=""><%- icon('plus','i-sm') %> Restock</button><% } %>
  </div></header>

  <section class="stock-metrics" aria-label="Inventory totals">
    <div><span>Units available</span><strong><%= totals.units.toLocaleString('en-IN') %></strong></div>
    <a href="<%= link({status:'low',page:''}) %>"><span>Low-stock products</span><strong class="text-amber"><%= totals.low %></strong></a>
    <a href="<%= link({status:'out',page:''}) %>"><span>Out-of-stock products</span><strong class="text-red"><%= totals.out %></strong></a>
    <div><span>Stock value</span><strong><%= formatPrice(totals.value || 0) %></strong></div>
  </section>

  <section class="stock-list-panel" aria-label="Stock levels">
    <div class="stock-list-top"><nav class="stock-status-tabs" aria-label="Product stock status"><% tabs.forEach(([key,text]) => { %><a class="<%= filters.status === key ? 'is-active' : '' %>" href="<%= link({status:key === 'all' ? '' : key,page:''}) %>" <%- filters.status === key ? 'aria-current="page"' : '' %>><%= text %></a><% }); %></nav><span class="stock-result-count"><%= pagination.total %> products</span></div>
    <div class="stock-filter-wrap"><%- include('../partials/admin-list-toolbar', {section:'inventory',searchMax:80,searchHint:'Search product or brand',sorts,fields:[
      {key:'category',label:'Category',options:[['','All categories'],...categories.map(c => [String(c._id),c.name])]},
      {key:'status',label:'Status',options:[['','Any status'],...tabs.filter(t => t[0] !== 'all')]}
    ]}).replace('class="admin-filterbar"', 'class="stock-searchbar"') %></div>

    <% if(products.length) { %>
    <div class="stock-matrix-scroll"><table class="stock-matrix"><caption class="sr-only">Available stock for every product size and color</caption><thead><tr><th scope="col">Size</th><th scope="col">Color</th><th scope="col">SKU</th><th scope="col" class="stock-number">Available</th><th scope="col" class="stock-number">Value</th><th scope="col">Status</th><% if(canWrite) { %><th scope="col"><span class="sr-only">Actions</span></th><% } %></tr></thead>
    <% products.forEach(p => { const variants = p.options.length ? p.options : [{id:'',size:'Standard',colour:'',sku:p.sku || '',stock:p.stock,label:'General stock'}]; %>
      <tbody data-inventory-product="<%= p.id %>">
        <tr class="stock-group-row"><th scope="rowgroup" colspan="<%= canWrite ? 7 : 6 %>"><div class="stock-group-content"><div class="stock-product-cell">
          <% if(canWrite) { %><input type="checkbox" data-inventory-select="<%= p.id %>" aria-label="Select <%= p.name %> for bulk restock" <%= p.options.length ? 'disabled' : '' %>><% } %>
          <% if(p.image) { %><img src="<%= p.image %>" alt="" width="40" height="40" loading="lazy"><% } %>
          <div><strong><%= p.name %></strong><span><%= p.category || 'Uncategorized' %><%= p.isListed ? '' : ' · Unlisted' %> · <%= p.stock %> units total</span></div>
        </div><% if(canWrite) { %><button class="stock-add-combination" type="button" data-inventory-edit="<%= p.id %>" data-inventory-new><%- icon('plus','i-xs') %> Add size / color</button><% } %></div></th></tr>
        <% variants.forEach(v => { const state = v.stock <= 0 ? 'out' : v.stock <= totals.lowStockLimit ? 'low' : 'healthy'; const unitPrice = p.price || (p.stock ? p.stockValue / p.stock : 0); %>
        <tr class="stock-sku-row" data-stock-variant="<%= v.id %>">
          <td data-label="Size"><strong><%= v.size || '—' %></strong></td><td data-label="Color"><span class="stock-color-name"><%= v.colour || '—' %></span></td><td data-label="SKU" class="stock-sku"><%= v.sku || '—' %></td>
          <td data-label="Available" class="stock-number"><strong class="stock-quantity <%= state === 'out' ? 'text-red' : '' %>" data-variant-quantity><%= v.stock %></strong><span class="stock-units"> units</span></td>
          <td data-label="Value" class="stock-number"><%= formatPrice(v.stock * unitPrice) %></td><td data-label="Status"><span class="stock-state <%= state %>" data-variant-status><span aria-hidden="true"></span><%= stateLabel[state] %></span></td>
          <% if(canWrite) { %><td class="stock-row-action"><button class="btn btn-secondary btn-sm" type="button" data-inventory-edit="<%= p.id %>" data-inventory-option="<%= v.id %>" aria-label="Edit stock for <%= p.name %>, <%= v.label %>">Edit stock <%- icon('chevron-right','i-xs') %></button></td><% } %>
        </tr><% }); %>
      </tbody>
    <% }); %></table></div>
    <div class="stock-table-footer"><% if(canWrite) { %><label><input type="checkbox" data-inventory-select-all> Select general-stock products</label><% } %><%- include('../partials/admin-pager') %></div>
    <% } else { %><div class="empty-state empty-state-flat"><%- include('../partials/empty-art',{art:'box'}) %><h2>No products found</h2><p>Try another search or stock status.</p><a class="btn btn-secondary" href="<%= adminPath %>/inventory">Clear filters</a></div><% } %>
  </section>

  <% if(canWrite) { %><div id="stock-bulk-tools" data-stock-bulk-tools><%- include('../partials/admin-inventory-import') %></div><a class="stock-recovery-link" href="<%= adminPath %>/inventory/imports">Review restock imports <%- icon('chevron-right','i-xs') %></a>
  <script type="application/json" data-inventory-products><%- JSON.stringify(products).replace(/</g,'\u003c') %></script>
  <%- include('../partials/inventory-drawer') %>
  <% } %>
</div>
<%- include('../partials/admin-end') %>
