<%#
  Pick list: what to take off the shelf, grouped by product and size or colour, with the orders
  each unit belongs to. Printing hides the console and leaves just this list.
%>
<%- include('../partials/admin-start', { section: 'orders', page: 'pick-list' }) %>
<nav class="breadcrumb breadcrumb-admin no-print" aria-label="Breadcrumb">
  <a href="<%= adminPath %>/orders">Orders</a> <%- icon('chevron-right', 'i-xs') %>
  <span aria-current="page">Pick list</span>
</nav>
<header class="admin-top">
  <div>
    <span class="section-kicker">Packing</span>
    <h1>Pick list</h1>
    <p class="muted">
      <%= units %> <%= units === 1 ? 'unit' : 'units' %> across <%= orderCount %> <%= orderCount === 1 ? 'order' : 'orders' %> (<%= scope %>).
      <% if (late) { %><strong class="text-red"><%= late %> <%= late === 1 ? 'is' : 'are' %> past the ship-by time.</strong><% } %>
    </p>
  </div>
  <div class="admin-top-actions no-print">
    <button type="button" class="btn btn-primary btn-sm" data-print><%- icon('download', 'i-sm') %> Print</button>
    <a class="btn btn-ghost btn-sm" href="<%= adminPath %>/orders">Back to orders</a>
  </div>
</header>

<% if (lines.length) { %>
  <section class="panel panel-flush admin-table-panel pick-list" aria-label="Items to pick">
    <div class="table-wrap">
      <table class="table admin-table">
        <thead><tr>
          <th scope="col" class="cell-check"><span class="sr-only">Picked</span></th>
          <th scope="col">Product</th>
          <th scope="col">Size or colour</th>
          <th scope="col">SKU</th>
          <th scope="col" class="cell-num">Units</th>
          <th scope="col">Orders</th>
        </tr></thead>
        <tbody>
          <% lines.forEach(function (line) { %>
            <tr>
              <td class="cell-check"><span class="pick-box" aria-hidden="true"></span></td>
              <td><strong><%= line.name %></strong></td>
              <td><%= line.option || '—' %></td>
              <td><code class="admin-code"><%= line.sku || '—' %></code></td>
              <td class="cell-num"><strong><%= line.units %></strong></td>
              <td><span class="muted"><%= line.orders.join(', ') %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } else { %>
  <div class="empty-state empty-state-flat"><%- include('../partials/empty-art', { art: 'box' }) %><h2>Nothing to pick</h2><p>No orders are waiting to ship.</p></div>
<% } %>
<%- include('../partials/admin-end') %>
