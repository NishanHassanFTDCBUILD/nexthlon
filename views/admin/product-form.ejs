
<%
  const isEdit = Boolean(product);
  const p = product || { name: '', description: '', category: typeof presetCategory !== 'undefined' ? presetCategory : '', brand: '', basePriceRupees: '', mrpRupees: '', offerPercent: 0, stock: '', images: [], isListed: true };
%>
<%- include('../partials/admin-start', { section: 'products', page: 'product-form' }) %>
    <nav class="breadcrumb breadcrumb-admin" aria-label="Breadcrumb">
      <a href="<%= adminPath %>/products">Products</a> <%- icon('chevron-right', 'i-xs') %>
      <span aria-current="page"><%= isEdit ? p.name : 'Add product' %></span>
    </nav>
    <header class="admin-top">
      <div>
        <span class="section-kicker"><%= isEdit ? 'Edit product' : 'New product' %></span>
        <h1><%= isEdit ? p.name : 'Add a product' %></h1>
        <p class="muted">
          <% if (isEdit) { %>
            <span class="pill <%= p.isListed ? 'pill-green' : 'pill-grey' %>"><%= p.isListed ? 'Listed in the store' : 'Unlisted' %></span>
            <% if (p.isListed) { %>· <a href="/products/<%= p.slug %>" target="_blank" rel="noopener" data-nav-skip>View in store <%- icon('chevron-right', 'i-xs') %><span class="sr-only">(opens in a new tab)</span></a><% } %>
          <% } else { %>
            The web address and discount are worked out for you when you save.
          <% } %>
        </p>
      </div>
    </header>

    <form class="form product-form" data-product-form novalidate
          data-endpoint="<%= isEdit ? '/api/admin/products/' + p.id : '/api/admin/products' %>"
          data-method="<%= isEdit ? 'PATCH' : 'POST' %>">
      <div class="form-alert" data-form-alert aria-live="assertive"></div>
      <% if (isEdit) { %><input type="hidden" name="stockSnapshot" value="<%= p.stockSnapshot %>"><% } %>

      <nav class="product-jump" aria-label="Jump to a section of this form">
        <a href="#sec-details">Details</a>
        <a href="#sec-pricing">Price and stock</a>
        <a href="#sec-tax">Product details</a>
        <a href="#sec-options">Sizes and colours</a>
        <a href="#sec-images">Photos</a>
      </nav>

      <div class="product-form-grid">
        <section class="panel" id="sec-details" aria-labelledby="details-title">
          <h2 id="details-title" class="panel-title">Details</h2>
          <div class="form-grid form-grid-2">
            <div class="field field-wide">
              <label for="p-name">Product name</label>
              <input id="p-name" name="name" required minlength="3" maxlength="120" value="<%= p.name %>" aria-describedby="p-name-error" placeholder="e.g. TrailFlex 2 Trail Running Shoes">
              <p class="field-error" id="p-name-error" data-error-for="name"></p>
            </div>
            <div class="field">
              <label for="p-category">Category</label>
              <div class="select-wrap select-field">
                <select id="p-category" name="category" required aria-describedby="p-category-error">
                  <option value="">Choose a category</option>
                  <% categories.forEach(function (c) { %>
                    <option value="<%= c._id %>" <%= p.category === String(c._id) ? 'selected' : '' %>><%= c.name %><%= c.isListed === false ? ' (unlisted)' : '' %></option>
                  <% }) %>
                </select>
                <%- icon('chevron-down', 'i-xs') %>
              </div>
              <p class="field-error" id="p-category-error" data-error-for="category"></p>
            </div>
            <div class="field">
              <label for="p-brand">Brand <span class="optional">(optional)</span></label>
              <input id="p-brand" name="brand" maxlength="60" value="<%= p.brand %>" placeholder="Nexthlon" aria-describedby="p-brand-error">
              <p class="field-error" id="p-brand-error" data-error-for="brand"></p>
            </div>
            <div class="field field-wide">
              <label for="p-description">Description <span class="optional">(optional)</span></label>
              <textarea id="p-description" name="description" rows="6" maxlength="4000" aria-describedby="p-description-error"><%= p.description %></textarea>
              <p class="field-error" id="p-description-error" data-error-for="description"></p>
            </div>
          </div>
        </section>

        <section class="panel" id="sec-pricing" aria-labelledby="pricing-title">
          <h2 id="pricing-title" class="panel-title">Price and stock</h2>
          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="p-price">Selling price (₹)</label>
              <input id="p-price" name="price" type="number" inputmode="decimal" min="1" step="0.01" required value="<%= p.basePriceRupees %>" aria-describedby="p-price-error" data-price>
              <p class="field-error" id="p-price-error" data-error-for="price"></p>
            </div>
            <div class="field">
              <label for="p-mrp">M.R.P. (₹)</label>
              <input id="p-mrp" name="mrp" type="number" inputmode="decimal" min="1" step="0.01" required value="<%= p.mrpRupees %>" aria-describedby="p-mrp-error" data-mrp>
              <p class="field-error" id="p-mrp-error" data-error-for="mrp"></p>
            </div>
            <div class="field">
              <label for="p-stock">Stock</label>
              <input id="p-stock" name="stock" type="number" inputmode="numeric" min="0" step="1" required value="<%= p.stock %>" aria-describedby="p-stock-error p-stock-hint" data-stock-total <%= p.hasOptions ? 'readonly' : '' %>>
              <p class="hint" id="p-stock-hint" data-stock-hint <%= p.hasOptions ? '' : 'hidden' %>>The total of the sizes below.</p>
              <p class="field-error" id="p-stock-error" data-error-for="stock"></p>
            </div>
            <div class="field">
              <label for="p-offer">Product offer (%) <span class="optional">(optional)</span></label>
              <input id="p-offer" name="offerPercent" type="number" inputmode="numeric" min="0" max="90" step="1" value="<%= p.offerPercent %>" aria-describedby="p-offer-error p-offer-hint" data-offer>
              <p class="hint" id="p-offer-hint">The higher of this and the category offer is taken off the selling price.</p>
              <p class="field-error" id="p-offer-error" data-error-for="offerPercent"></p>
            </div>
            <div class="field">
              <span class="field-label">Discount</span>
              <p class="discount-preview" data-discount-preview aria-live="polite">—</p>
              <p class="hint">Worked out from the price and M.R.P.</p>
            </div>
          </div>
        </section>

        <section class="panel product-tax-panel" id="sec-tax" aria-labelledby="tax-title">
          <h2 id="tax-title" class="panel-title">Product details</h2>
          <div class="form-grid form-grid-2">
            <div class="field">
              <label for="p-origin">Country of origin</label>
              <input id="p-origin" name="countryOfOrigin" maxlength="60" value="<%= p.countryOfOrigin || 'India' %>" required aria-describedby="p-origin-error">
              <p class="field-error" id="p-origin-error" data-error-for="countryOfOrigin"></p>
            </div>
            <div class="field">
              <label for="p-netqty">Net quantity</label>
              <input id="p-netqty" name="netQuantity" maxlength="60" value="<%= p.netQuantity || '' %>" placeholder="e.g. 1 pair, 1 N, 750 ml" aria-describedby="p-netqty-error">
              <p class="field-error" id="p-netqty-error" data-error-for="netQuantity"></p>
            </div>
            <div class="field">
              <label for="p-weight">Packed weight <span class="optional">(grams, for the courier)</span></label>
              <input id="p-weight" name="shipWeight" type="number" inputmode="numeric" min="0" max="50000" step="1" value="<%= p.shipWeight || '' %>" placeholder="e.g. 450" aria-describedby="p-weight-error">
              <p class="field-error" id="p-weight-error" data-error-for="shipWeight"></p>
            </div>


            <div class="field">
            </div>
            <div class="field">
              <label for="p-sku">SKU <span class="optional">(for a product without sizes; sizes have their own)</span></label>
              <input id="p-sku" name="sku" maxlength="40" value="<%= p.sku || '' %>" placeholder="e.g. NX-BALL-5" aria-describedby="p-sku-error">
              <p class="field-error" id="p-sku-error" data-error-for="sku"></p>
            </div>
            <div class="field field-wide">
              <label for="p-maker">Manufacturer or importer <span class="optional">(name and address)</span></label>
              <textarea id="p-maker" name="manufacturer" rows="2" maxlength="300" placeholder="e.g. Nexthlon Sports Pvt Ltd, 12 MG Road, Kochi, Kerala 682001" aria-describedby="p-maker-error"><%= p.manufacturer || '' %></textarea>
              <p class="field-error" id="p-maker-error" data-error-for="manufacturer"></p>
            </div>
          </div>
        </section>

        <section class="panel product-options-panel" id="sec-options" aria-labelledby="options-title" data-options-editor data-options="<%= JSON.stringify(p.options || []) %>">
          <h2 id="options-title" class="panel-title">Sizes and colours <span class="optional">(optional)</span></h2>
          <p class="muted">Each size or colour has its own stock, and shoppers choose one before adding to the cart. The price is the same for all of them. Leave this empty for a product that comes in one size.</p>
          <div class="options-table-wrap">
            <table class="options-table" data-options-table hidden>
              <thead><tr><th scope="col">Size</th><th scope="col">Colour</th><th scope="col">SKU <span class="optional">(optional)</span></th><th scope="col">Stock</th><th scope="col"><span class="sr-only">Remove</span></th></tr></thead>
              <tbody data-options-rows></tbody>
            </table>
          </div>
          <div class="options-actions">
            <button type="button" class="btn btn-ghost btn-sm" data-option-add><%- icon('plus', 'i-xs') %> Add a size or colour</button>
            <button type="button" class="btn btn-ghost btn-sm" data-option-preset="6,7,8,9,10,11">Shoe sizes 6–11</button>
            <button type="button" class="btn btn-ghost btn-sm" data-option-preset="S,M,L,XL,XXL">Clothing S–XXL</button>
          </div>
          <p class="field-error" data-error-for="options" aria-live="polite"></p>
        </section>

        <section class="panel product-images-panel" id="sec-images" aria-labelledby="images-title">
          <h2 id="images-title" class="panel-title">Photos and video</h2>
            <div class="field product-video-editor">
              <label for="p-video">Video link <span class="optional">(optional: an https link to an MP4 or WebM)</span></label>
              <input id="p-video" name="videoUrl" type="url" maxlength="500" value="<%= p.videoUrl || '' %>" placeholder="https://…/shoe-spin.mp4" aria-describedby="p-video-error">
              <p class="field-error" id="p-video-error" data-error-for="videoUrl"></p>
              <label class="admin-field"><span>Or upload a video</span>
                <input type="file" accept="video/mp4,video/webm" data-video-file data-upload-url="/api/admin/products/<%= p.id %>/video" aria-describedby="p-video-status"></label>
              <p class="hint" id="p-video-status" data-video-status role="status">MP4 or WebM, up to 25 MB. Uploads when you save the product.</p>
              <video class="admin-media-video" data-video-preview controls playsinline preload="metadata" hidden></video>
            </div>
          <p class="muted">Up to 4 JPG, PNG or WEBP images, 2 MB each. Choose the main photo, and use the pencil to crop, rotate or replace one. When the product has colours, pick the colour each photo shows: shoppers see those photos when they choose that colour.</p>
          <div class="image-manager" data-image-manager data-existing="<%= JSON.stringify(p.images) %>" data-colour-photos="<%= JSON.stringify(p.colourPhotos || []) %>" data-editor-src="<%= asset('/js/image-editor.js') %>">
            <ul class="image-tiles" data-image-tiles></ul>
            <label class="image-add" data-image-add>
              <input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" data-image-input aria-describedby="p-images-error">
              <span class="address-add-icon"><%- icon('plus', 'i-lg') %></span>
              <strong>Add photos</strong>
              <span data-image-count></span>
            </label>
          </div>
          <p class="field-error" id="p-images-error" data-error-for="images"></p>
        </section>
      </div>

      <div class="form-actions product-form-actions admin-save-bar">
        <a class="btn btn-ghost" href="<%= adminPath %>/products">Cancel</a>
        <button class="btn btn-primary" type="submit"><%= isEdit ? 'Save changes' : 'Add product' %></button>
      </div>
    </form>
<%- include('../partials/admin-end') %>
