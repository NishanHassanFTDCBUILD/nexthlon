<%
  const presets = [['today', 'Today'], ['7d', '7 days'], ['30d', '30 days'], ['month', 'This month'], ['year', 'This year']];
  const paymentLabels = { razorpay: 'Razorpay (UPI, cards)', wallet: 'Wallet', cod: 'Cash on delivery' };
  const rangeQuery = range.key === 'custom' ? 'range=custom&from=' + range.fromDay + '&to=' + range.toDay : 'range=' + range.key;
  const fmt = function (value, format) {
    if (format === 'money') return formatPrice(value);
    if (format === 'percent') return value.toFixed(1) + '%';
    return Number(value).toLocaleString('en-IN');
  };
  const chartData = {
    kpis: kpis.map(function (k) { return { key: k.key, format: k.format, spark: k.spark, goodWhenUp: k.goodWhenUp }; }),
    charts: charts,
    statusLabels: statusLabels,
    paymentLabels: paymentLabels
  };
  const totalOrders = charts.statuses.reduce(function (sum, s) { return sum + s.count; }, 0);
  const totalPayments = charts.payments.reduce(function (sum, p) { return sum + p.count; }, 0);
  const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  const stock = panels.stock;
  const stockTotal = Math.max(stock.products, 1);
%>
<%- include('../partials/admin-start', { section: 'dashboard' }) %>
<div class="dash" data-dashboard="<%= JSON.stringify(chartData) %>">
  <header class="admin-top">
    <div>
      <span class="section-kicker">Overview</span>
      <h1>Dashboard</h1>
      <p class="muted"><%= range.label %> · <%= formatDate(range.from) %> to <%= formatDate(new Date(range.to.getTime() - 1)) %>, compared with the period before.</p>
    </div>
    <div class="admin-top-actions dash-quick" aria-label="Quick actions">
      <a class="btn btn-primary btn-sm" href="<%= adminPath %>/products/new"><%- icon('plus', 'i-sm') %> Add product</a>
      <a class="btn btn-ghost btn-sm" href="<%= adminPath %>/coupons"><%- icon('ticket', 'i-sm') %> Create coupon</a>
      <a class="btn btn-ghost btn-sm" href="<%= adminPath %>/orders"><%- icon('package-check', 'i-sm') %> View orders</a>
      <a class="btn btn-ghost btn-sm" href="/api/admin/reports/sales.csv?<%= rangeQuery %>" download data-full-load><%- icon('download', 'i-sm') %> Export sales</a>
    </div>
  </header>

  <%# ---------- Date range ---------- %>
  <div class="dash-range" role="group" aria-label="Date range">
    <nav class="segmented dash-presets" aria-label="Quick ranges">
      <% presets.forEach(function ([key, label]) { %>
        <a href="<%= adminPath %>/dashboard?range=<%= key %>" class="<%= range.key === key ? 'is-active' : '' %>" <%- range.key === key ? 'aria-current="true"' : '' %>><%= label %></a>
      <% }) %>
    </nav>
    <form class="dash-custom<%= range.key === 'custom' ? ' is-active' : '' %>" action="<%= adminPath %>/dashboard" method="get">
      <input type="hidden" name="range" value="custom">
      <label><span>From</span><input type="date" name="from" value="<%= range.fromDay %>" required></label>
      <label><span>To</span><input type="date" name="to" value="<%= range.toDay %>" required></label>
      <button class="btn btn-secondary btn-sm" type="submit">Apply</button>
    </form>
  </div>
  <% if (range.error) { %><div class="alert alert-danger" role="alert"><%- icon('alert') %><span><%= range.error %> Showing the last 7 days instead.</span></div><% } %>

  <%# ---------- KPIs ---------- %>
  <section class="dash-kpis" aria-label="Key numbers">
    <% kpis.forEach(function (k) {
         const up = k.change !== null && k.change > 0;
         const down = k.change !== null && k.change < 0;
         const good = (up && k.goodWhenUp) || (down && !k.goodWhenUp);
         const bad = (up && !k.goodWhenUp) || (down && k.goodWhenUp); %>
      <article class="dash-kpi" data-kpi="<%= k.key %>">
        <div class="dash-kpi-head">
          <h2><%= k.label %></h2>
          <% if (k.hint) { %><span class="dash-hint" role="img" title="<%= k.hint %>" aria-label="<%= k.hint %>"><%- icon('info', 'i-xs') %></span><% } %>
        </div>
        <strong class="dash-kpi-value" data-count="<%= k.value %>" data-format="<%= k.format %>"><%= fmt(k.value, k.format) %></strong>
        <div class="dash-kpi-foot">
          <span class="dash-change<%= good ? ' is-good' : bad ? ' is-bad' : '' %>">
            <% if (k.change === null) { %>New<% } else { %><%- up ? icon('arrow-up', 'i-xs') : down ? icon('arrow-down', 'i-xs') : '' %><%= Math.abs(k.change).toFixed(1) %>%<% } %>
            <span class="sr-only"><%= k.change === null ? 'no earlier figure' : up ? 'up' : down ? 'down' : 'no change' %> compared with the previous period</span>
          </span>
          <small class="muted">vs <%= fmt(k.previous, k.format) %></small>
        </div>
        <span class="dash-spark" data-spark="<%= k.key %>" aria-hidden="true"></span>
      </article>
    <% }) %>
  </section>

  <%# ---------- Revenue over time + pending actions ---------- %>
  <div class="dash-row dash-row-main">
    <section class="panel dash-card" aria-labelledby="chart-timeline-title">
      <div class="dash-card-head">
        <h2 id="chart-timeline-title">Revenue and orders</h2>
        <span class="dash-legend"><i class="dash-dot dash-dot-line"></i> Revenue (paid) <i class="dash-dot dash-dot-bar"></i> Orders</span>
      </div>
      <div class="dash-chart dash-chart-tall" data-chart="timeline" role="img" tabindex="0" aria-label="Revenue and orders per <%= charts.bucket %> for <%= range.label.toLowerCase() %>. Use the arrow keys to read each value."></div>
    </section>

    <section class="panel dash-card" aria-labelledby="actions-title">
      <div class="dash-card-head"><h2 id="actions-title">Needs your attention</h2></div>
      <ul class="dash-actions">
        <% panels.actions.forEach(function (a) { %>
          <li><a class="dash-action<%= a.count ? ' has-count' : '' %>" href="<%= adminPath %>/<%= a.href %>"><%- icon(a.icon, 'i-sm') %><span><%= a.label %></span><strong><%= a.count %></strong></a></li>
        <% }) %>
      </ul>
    </section>
  </div>

  <%# ---------- Splits ---------- %>
  <div class="dash-row dash-row-3">
    <section class="panel dash-card" aria-labelledby="chart-status-title">
      <div class="dash-card-head"><h2 id="chart-status-title">Orders by status</h2><span class="muted"><%= totalOrders %> <%= totalOrders === 1 ? 'order' : 'orders' %></span></div>
      <div class="dash-chart dash-chart-donut" data-chart="statuses" role="img" tabindex="0" aria-label="Orders by status: <%= charts.statuses.map(function (s) { return (statusLabels[s.key] || s.key) + ' ' + s.count; }).join(', ') || 'no orders' %>."></div>
    </section>
    <section class="panel dash-card" aria-labelledby="chart-pay-title">
      <div class="dash-card-head"><h2 id="chart-pay-title">Payment methods</h2><span class="muted"><%= totalPayments %> <%= totalPayments === 1 ? 'order' : 'orders' %></span></div>
      <div class="dash-chart dash-chart-donut" data-chart="payments" role="img" tabindex="0" aria-label="Payment methods: <%= charts.payments.map(function (p) { return (paymentLabels[p.key] || p.key) + ' ' + p.count; }).join(', ') || 'no orders' %>."></div>
    </section>
    <section class="panel dash-card" aria-labelledby="chart-nr-title">
      <div class="dash-card-head"><h2 id="chart-nr-title">New vs returning</h2><span class="dash-legend"><i class="dash-dot dash-dot-new"></i> New <i class="dash-dot dash-dot-ret"></i> Returning</span></div>
      <div class="dash-chart" data-chart="newReturning" role="img" tabindex="0" aria-label="Orders from new and returning customers per <%= charts.bucket %>. Use the arrow keys to read each value."></div>
    </section>
  </div>

  <%# ---------- What sells ---------- %>
  <div class="dash-row dash-row-2">
    <section class="panel dash-card" aria-labelledby="chart-cat-title">
      <div class="dash-card-head"><h2 id="chart-cat-title">Order value by category</h2></div>
      <p class="muted">Includes unpaid orders; item values before order discounts and refunds.</p>
      <div class="dash-chart" data-chart="categories" role="img" tabindex="0" aria-label="Order value by category, including unpaid orders and before order discounts and refunds: <%= charts.categories.map(function (c) { return c.name + ' ' + formatPrice(c.revenue); }).join(', ') || 'no orders' %>."></div>
    </section>
    <section class="panel dash-card" aria-labelledby="top-title" data-dash-top>
      <div class="dash-card-head">
        <h2 id="top-title">Top 10 products</h2>
        <div class="segmented dash-tabs" role="tablist" aria-label="Rank by">
          <button type="button" role="tab" aria-selected="true" aria-controls="top-revenue" id="tab-top-revenue" class="is-active" data-dash-tab="revenue">Order value</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="top-units" id="tab-top-units" data-dash-tab="units" tabindex="-1">Units</button>
        </div>
      </div>
      <% [['revenue', charts.topByRevenue], ['units', charts.topByUnits]].forEach(function ([kind, list], index) {
           const max = Math.max.apply(null, list.map(function (p) { return kind === 'revenue' ? p.revenue : p.units; }).concat([1])); %>
        <div class="dash-top" id="top-<%= kind %>" role="tabpanel" aria-labelledby="tab-top-<%= kind %>" <%= index ? 'hidden' : '' %>>
          <% if (list.length) { %>
            <ol class="dash-rank">
              <% list.forEach(function (p, i) { const value = kind === 'revenue' ? p.revenue : p.units; %>
                <li>
                  <span class="dash-rank-n"><%= i + 1 %></span>
                  <span class="dash-rank-name"><a href="<%= adminPath %>/products/<%= p.id %>/edit"><%= p.name %></a>
                    <span class="dash-bar" aria-hidden="true"><span style="width: <%= Math.max(2, Math.round(value / max * 100)) %>%"></span></span></span>
                  <span class="dash-rank-value"><strong><%= kind === 'revenue' ? formatPrice(p.revenue) : p.units + ' units' %></strong><small class="muted"><%= kind === 'revenue' ? p.units + ' units' : formatPrice(p.revenue) %></small></span>
                </li>
              <% }) %>
            </ol>
          <% } else { %><p class="muted dash-empty">No sales in this period.</p><% } %>
        </div>
      <% }) %>
    </section>
  </div>

  <%# ---------- When and where ---------- %>
  <div class="dash-row dash-row-2">
    <section class="panel dash-card" aria-labelledby="chart-heat-title">
      <div class="dash-card-head"><h2 id="chart-heat-title">When orders come in</h2><span class="muted">Day of week × hour (IST)</span></div>
      <div class="dash-chart dash-chart-heat" data-chart="heatmap" role="img" tabindex="0" aria-label="Orders by day of the week and hour of the day. Use the arrow keys to read each cell."></div>
    </section>
    <section class="panel dash-card" aria-labelledby="where-title">
      <div class="dash-card-head"><h2 id="where-title">Top cities</h2><span class="muted">By order value, including unpaid orders</span></div>
      <% if (charts.cities.length) { const maxCity = Math.max.apply(null, charts.cities.map(function (c) { return c.revenue; }).concat([1])); %>
        <ol class="dash-rank">
          <% charts.cities.forEach(function (c, i) { %>
            <li><span class="dash-rank-n"><%= i + 1 %></span>
              <span class="dash-rank-name"><%= c.city %><small class="muted"><%= c.state %></small><span class="dash-bar" aria-hidden="true"><span style="width: <%= Math.max(2, Math.round(c.revenue / maxCity * 100)) %>%"></span></span></span>
              <span class="dash-rank-value"><strong><%= formatPrice(c.revenue) %></strong><small class="muted"><%= c.orders %> <%= c.orders === 1 ? 'order' : 'orders' %></small></span></li>
          <% }) %>
        </ol>
      <% } else { %><p class="muted dash-empty">No orders in this period.</p><% } %>
    </section>
  </div>

  <%# ---------- Recent orders + stock ---------- %>
  <div class="dash-row dash-row-main">
    <section class="panel panel-flush dash-card" aria-labelledby="recent-orders-title">
      <div class="dash-card-head dash-pad"><h2 id="recent-orders-title">Recent orders</h2><a class="section-link" href="<%= adminPath %>/orders">All orders <%- icon('chevron-right', 'i-sm') %></a></div>
      <% if (panels.recentOrders.length) { %>
        <div class="table-wrap">
          <table class="table table-stack dash-orders">
            <thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Placed</th><th scope="col">Amount</th><th scope="col">Status</th></tr></thead>
            <tbody>
              <% panels.recentOrders.forEach(function (o) { %>
                <tr data-row-href="<%= adminPath %>/orders?q=<%= o.orderId %>">
                  <td data-label="Order"><a href="<%= adminPath %>/orders?q=<%= o.orderId %>"><strong><%= o.orderId %></strong></a></td>
                  <td data-label="Customer"><%= o.customer %><% if (o.city) { %> <small class="muted">· <%= o.city %></small><% } %></td>
                  <td data-label="Placed"><%= formatDate(o.createdAt) %></td>
                  <td data-label="Amount"><%= formatPrice(o.amount) %></td>
                  <td data-label="Status"><span class="status-pill status-<%= o.status %>"><span class="status-dot" aria-hidden="true"></span><%= statusLabels[o.status] || o.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %><p class="muted dash-empty dash-pad">No orders yet.</p><% } %>
    </section>

    <section class="panel dash-card" aria-labelledby="restock-title">
      <div class="dash-card-head"><h2 id="restock-title">Low and out of stock</h2><a class="section-link" href="<%= adminPath %>/products?status=low">See all <%- icon('chevron-right', 'i-sm') %></a></div>
      <% if (panels.stockList.length) { %>
        <ul class="dash-stock">
          <% panels.stockList.forEach(function (p) { %>
            <li>
              <img src="<%= sizedUrl(p.image, 200) %>" alt="" width="40" height="40" loading="lazy">
              <span class="dash-stock-name"><a href="<%= adminPath %>/products/<%= p.id %>/edit"><%= p.name %></a><span class="pill <%= p.stock ? 'pill-amber' : 'pill-red' %>" data-stock-label><%= p.stock ? p.stock + ' left' : 'Out of stock' %></span></span>
              <form class="dash-restock" data-restock="<%= p.id %>" novalidate>
                <label class="sr-only" for="restock-<%= p.id %>">Units to add to <%= p.name %></label>
                <input id="restock-<%= p.id %>" name="add" type="number" inputmode="numeric" min="1" max="10000" step="1" placeholder="+ units" required>
                <button class="btn btn-secondary btn-sm" type="submit">Restock</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %><p class="muted dash-empty">Every product is well stocked.</p><% } %>
    </section>
  </div>

  <%# ---------- People and stock health ---------- %>
  <div class="dash-row dash-row-2">
    <section class="panel dash-card" aria-labelledby="new-cust-title">
      <div class="dash-card-head"><h2 id="new-cust-title">Recent customers</h2><a class="section-link" href="<%= adminPath %>/customers">All <%- icon('chevron-right', 'i-sm') %></a></div>
      <p class="muted dash-sub"><%= panels.people.customers %> customers · <%= panels.people.newCustomers %> new this week · <%= panels.people.blockedCustomers %> blocked</p>
      <ul class="dash-people">
        <% panels.recentCustomers.forEach(function (c) { %>
          <li><span class="avatar avatar-sm"><%= c.name.charAt(0).toUpperCase() %></span><span><a href="<%= adminPath %>/customers?q=<%= encodeURIComponent(c.email) %>"><%= c.name %></a><small class="muted"><%= c.email %></small></span><small class="muted"><%= formatDate(c.createdAt) %></small></li>
        <% }) %>
      </ul>
    </section>
    <section class="panel dash-card" aria-labelledby="health-title">
      <div class="dash-card-head"><h2 id="health-title">Stock health</h2><span class="muted"><%= Math.round(stock.healthy / stockTotal * 100) %>% well stocked</span></div>
      <div class="stock-bar" role="img" aria-label="<%= stock.healthy %> well stocked, <%= stock.lowStock %> low, <%= stock.outOfStock %> out of stock">
        <% if (stock.healthy) { %><span class="stock-bar-ok" style="flex-grow: <%= stock.healthy %>"></span><% } %>
        <% if (stock.lowStock) { %><span class="stock-bar-low" style="flex-grow: <%= stock.lowStock %>"></span><% } %>
        <% if (stock.outOfStock) { %><span class="stock-bar-out" style="flex-grow: <%= stock.outOfStock %>"></span><% } %>
      </div>
      <ul class="stock-legend">
        <li><span class="dot dot-ok"></span>Well stocked <strong><%= stock.healthy %></strong></li>
        <li><span class="dot dot-low"></span>Low <strong><%= stock.lowStock %></strong></li>
        <li><span class="dot dot-out"></span>Out <strong><%= stock.outOfStock %></strong></li>
      </ul>
      <p class="muted dash-sub"><%= stock.products %> products listed in the store.</p>
    </section>
  </div>
</div>
<%- include('../partials/admin-end') %>
