<%#
  Coupons. The status shown here is worked out in exactly the order the store checks a code
  (services/adminCouponService.js statusOf), so what this list says is what a customer will see.
  Disabling is reversible; deleting is a soft delete, so past orders keep their history.
%>
<%
  const canEdit = typeof adminCan !== 'function' || adminCan('coupons.write');
  const tabs = [['all', 'All'], ['active', 'Running'], ['scheduled', 'Starts later'], ['expired', 'Expired'], ['used_up', 'Fully used'], ['disabled', 'Disabled']];
  const pill = { active: 'pill-green', scheduled: 'pill-blue', expired: 'pill-red', disabled: 'pill-grey', used_up: 'pill-amber' };
%>
<%- include('../partials/admin-start', { section: 'coupons' }) %>
<div class="sales-workspace">
<header class="admin-top sales-heading">
  <div>
    <span class="section-kicker">Sales / Promotions</span>
    <h1>Coupons</h1>
    <p class="muted">Create offers, control when they run and see how customers use them.</p>
  </div>
  <div class="admin-top-actions">
    <% if (canEdit) { %><a class="btn btn-primary btn-sm" href="<%= adminPath %>/coupons/new"><%- icon('plus', 'i-sm') %> New coupon</a><% } %>
  </div>
</header>

<section class="admin-totals sales-metrics" aria-label="Coupon totals">
  <div class="admin-total sales-metric-featured"><div class="sales-metric-top"><span>Running now</span><%- icon('ticket', 'i-sm') %></div><strong><%= totals.active %></strong><small>Available to qualifying customers</small></div>
  <div class="admin-total"><div class="sales-metric-top"><span>Scheduled</span><%- icon('clock', 'i-sm') %></div><strong><%= totals.scheduled || 0 %></strong><small>Ready for their start date</small></div>
  <div class="admin-total"><div class="sales-metric-top"><span>Total redemptions</span><%- icon('check', 'i-sm') %></div><strong><%= totals.uses.toLocaleString('en-IN') %></strong><small>Across all coupons, including history</small></div>
  <div class="admin-total is-in"><div class="sales-metric-top"><span>Discount given</span><%- icon('tag', 'i-sm') %></div><strong><%= formatPrice(totals.discountGiven) %></strong><small>Lifetime value of redeemed discounts</small></div>
</section>

<nav class="segmented admin-tabs" aria-label="Coupon status">
  <% tabs.forEach(function ([key, label]) { %><a href="<%= link({ status: key === 'all' ? '' : key, page: '' }) %>" class="<%= filters.status === key ? 'is-active' : '' %>" <%= filters.status === key ? 'aria-current="page"' : '' %>><%= label %><% if (key !== 'all' && totals[key]) { %> <span class="admin-tab-count"><%= totals[key] %></span><% } %></a><% }) %>
</nav>

<%- include('../partials/admin-list-toolbar', { section: 'coupons', searchMax: 40, searchHint: 'Code or description', sorts, fields: [{ key: 'status', label: 'Status', options: [['', 'Any status'], ...tabs.filter(function (t) { return t[0] !== 'all'; })] }] }) %>



<section class="panel panel-flush admin-table-panel" aria-label="Coupons">
  <div class="sales-table-heading"><div><h2>Your discount codes</h2><p>Dates are inclusive and use Indian Standard Time</p></div><span class="sales-record-count"><%= pagination.total.toLocaleString('en-IN') %> coupons</span></div>
  <% if (coupons.length) { %>
    <div class="table-wrap admin-table-scroll">
      <table class="table table-stack admin-table sales-coupon-table">
        <thead><tr>
          <%- include('../partials/admin-sort-header', { label: 'Code', asc: 'code_asc', desc: '' }) %><th scope="col">Discount</th>
          <th scope="col">Order rules</th>
          <%- include('../partials/admin-sort-header', { label: 'Schedule', asc: 'ending', desc: '' }) %>
          <%- include('../partials/admin-sort-header', { label: 'Usage', asc: '', desc: 'used_desc' }) %><th scope="col">Status</th>
          <th scope="col" class="cell-action">Actions</th>
        </tr></thead>
        <tbody>
          <% coupons.forEach(function (c) { %>
            <tr data-coupon-row="<%= c.id %>" data-row-href="<%= adminPath %>/coupons/<%= c.id %>">
              <td data-label="Code">
                <div class="admin-items-name">
                  <strong><a href="<%= adminPath %>/coupons/<%= c.id %>"><code class="admin-code"><%= c.code %></code></a></strong>
                  <% if (c.description) { %><span class="admin-sub sales-coupon-description" title="<%= c.description %>"><%= c.description %></span><% } %>
                </div>
              </td>
              <td data-label="Discount"><%= c.type === 'percent' ? c.value + '% off' : formatPrice(c.value) + ' off' %></td>
              <td data-label="Order rules"><%= c.minOrder ? formatPrice(c.minOrder) + ' minimum' : 'No minimum' %><small class="muted admin-sub"><%= c.maxDiscount ? formatPrice(c.maxDiscount) + ' cap' : 'No discount cap' %></small></td>
              <td data-label="Schedule">
                <span class="sales-date-range"><%= c.startsDay || "Immediately" %><small>to <%= c.endsDay || "No expiry" %></small></span>
              </td>
              <td data-label="Usage"><strong><%= c.usedCount %></strong><span class="muted"><%= c.usageLimit ? ' / ' + c.usageLimit : ' uses' %></span><% if (c.usageLimit > 0) { %><progress class="sales-usage" value="<%= Math.min(c.usedCount, c.usageLimit) %>" max="<%= c.usageLimit %>" aria-label="Usage of <%= c.code %>"><%= c.usedCount %> of <%= c.usageLimit %></progress><% } %><small class="muted admin-sub"><%= c.perUserLimit ? c.perUserLimit + ' per customer' : 'No customer limit' %></small></td>
              <td data-label="Status"><span class="pill <%= pill[c.status] || 'pill-grey' %>" data-coupon-status><%= statusLabels[c.status] %></span></td>
              <td data-label="Actions" class="cell-action"><% if (canEdit) { %><div class="row-actions">
                <a class="btn btn-ghost btn-sm" href="<%= adminPath %>/coupons/<%= c.id %>/edit" aria-label="Edit <%= c.code %>"><%- icon('edit', 'i-xs') %> Edit</a>
                <button type="button" class="btn btn-sm <%= c.isActive ? 'btn-danger-soft' : 'btn-secondary' %>"
                        data-coupon-toggle="<%= c.id %>" data-active="<%= c.isActive %>" data-code="<%= c.code %>"
                        aria-label="<%= c.isActive ? 'Disable' : 'Enable' %> <%= c.code %>"><%= c.isActive ? 'Disable' : 'Enable' %></button>
                <button type="button" class="btn btn-ghost btn-sm btn-square" data-coupon-delete="<%= c.id %>" data-code="<%= c.code %>" aria-label="Delete <%= c.code %>"><%- icon('trash', 'i-xs') %></button>
              </div><% } else { %><span class="muted">View only</span><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/admin-pager') %>
  <% } else { %>
    <div class="empty-state empty-state-flat"><%- include('../partials/empty-art', { art: 'ticket' }) %><h2>No coupons match</h2><p>Create one and it appears at checkout for every customer who qualifies.</p><% if (canEdit) { %><a class="btn btn-primary" href="<%= adminPath %>/coupons/new"><%- icon('plus', 'i-sm') %> New coupon</a><% } %></div>
  <% } %>
</section>
</div>
<%- include('../partials/admin-end') %>
