<%- include('../partials/head', { bodyClass: 'admin-body', styles: ['account'] }) %>
<% const tabs = [['all', 'All'], ['open', 'Open'], ['pending', 'Waiting for customer'], ['resolved', 'Resolved']]; %>
<div class="admin-shell">
  <%- include('../partials/admin-sidebar') %>
  <main id="main" class="admin-main">
    <header class="admin-top">
      <div>
        <span class="section-kicker">Customers</span>
        <h1>Support tickets</h1>
        <p class="muted"><%= counts.open %> open · <%= counts.pending %> waiting for the customer · <%= counts.resolved %> resolved</p>
      </div>
    </header>
    <nav class="segmented" aria-label="Ticket status">
      <% tabs.forEach(function ([key, label]) { %>
        <a href="<%= link({ status: key === 'all' ? '' : key, page: '' }) %>" class="<%= filters.status === key ? 'is-active' : '' %>" <%- filters.status === key ? 'aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
    </nav>
    <% if (tickets.length) { %>
      <ul class="ticket-list admin-tickets">
        <% tickets.forEach(function (t, i) { %>
          <li data-rise style="--rise: <%= Math.min(i, 10) %>">
            <a class="ticket-row" href="/admin/tickets/<%= t.ticketId %>">
              <span class="ticket-row-main">
                <strong><%= t.subject %></strong>
                <small class="muted"><%= t.ticketId %> · <%= t.topic %><%= t.orderId ? ' · ' + t.orderId : '' %> · <%= t.customer ? t.customer.name : 'Customer' %> · updated <%= formatDate(t.updatedAt) %></small>
              </span>
              <span class="status-pill status-<%= t.status %>"><span class="status-dot" aria-hidden="true"></span><%= t.status === 'pending' ? 'Waiting' : t.status === 'open' ? 'Open' : 'Resolved' %></span>
            </a>
          </li>
        <% }) %>
      </ul>
      <%- include('../partials/pagination', { pagination: pagination, link: link }) %>
    <% } else { %>
      <div class="empty-state"><%- include('../partials/empty-art', { art: 'headset' }) %><h2>No tickets here</h2><p>Customer help requests will appear here.</p></div>
    <% } %>
  </main>
</div>
<%- include('../partials/scripts', { scripts: ['admin'] }) %>
