
<%
  const STATUS_LABELS = { active: 'Active', unlisted: 'Unlisted', out: 'Out of stock' };
  const STATUS_PILLS = { active: 'pill-green', unlisted: 'pill-grey', out: 'pill-red' };
  const filtered = filters.q || filters.category || filters.status !== 'all';
%>
<%- include('../partials/admin-start', { section: 'products' }) %>
    <header class="admin-top">
      <div>
        <span class="section-kicker">Catalogue</span>
        <h1>Products</h1>
        <p class="muted"><%= pagination.total %> <%= pagination.total === 1 ? 'product' : 'products' %> found. Unlisted products are hidden from the store but kept here.</p>
      </div>
      <div class="admin-top-actions">
        <a class="btn btn-ghost btn-sm" href="/api/admin/products/export.csv" download data-full-load><%- icon('download', 'i-sm') %> Export CSV</a>
        <details class="admin-import" data-product-import>
          <summary class="btn btn-ghost btn-sm"><%- icon('copy', 'i-sm') %> Import CSV</summary>
          <div class="admin-import-panel">
            <p class="muted">Export the list, edit prices, names, brands, categories, offers or listing in the file, then upload it here. Blank cells keep the current value. Stock is changed in Inventory.</p>
            <label class="admin-field"><span>CSV file</span><input type="file" accept=".csv,text/csv" data-import-file></label>
            <div class="admin-import-result" data-import-result aria-live="polite"></div>
            <div class="admin-import-actions">
              <button type="button" class="btn btn-primary btn-sm" data-import-apply hidden>Save these changes</button>
            </div>
          </div>
        </details>
        <a class="btn btn-primary btn-sm" href="<%= adminPath %>/products/new"><%- icon('plus', 'i-sm') %> Add product</a>
      </div>
    </header>

    <%- include('../partials/admin-list-toolbar', { section: 'products', searchMax: 80, searchHint: 'Search by product name', sorts, fields: [
{ key: 'category', label: 'Category', options: [['', 'All categories'], ...categories.map(function (c) { return [String(c._id), c.name]; })] },
{ key: 'status', label: 'Status', options: [['', 'Any status'], ['active', 'Active'], ['low', 'Low stock'], ['unlisted', 'Unlisted'], ['out', 'Out of stock']] }
] }) %>





    <section class="panel panel-flush admin-table-panel" aria-label="Product list" data-results>
      <span class="loading-bar" aria-hidden="true"></span>
      <% if (products.length) { %>
        <div class="table-wrap">
          <table class="table table-stack admin-table product-table">
            <thead>
              <tr>
                <%- include('../partials/admin-sort-header', { label: 'Product', asc: 'name_asc', desc: '' }) %><%- include('../partials/admin-sort-header', { label: 'Price', asc: 'price_asc', desc: 'price_desc' }) %><th scope="col">M.R.P.</th>
                <th scope="col">Discount</th><%- include('../partials/admin-sort-header', { label: 'Stock', asc: 'stock_asc', desc: '' }) %><th scope="col">Status</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function (p) { %>
                <tr data-product-row="<%= p.id %>" class="<%= p.isListed ? '' : 'is-unlisted' %>">
                  <td>
                    <div class="person product-person">
                      <img class="product-thumb" src="<%= sizedUrl(p.image, 200) %>" alt="" width="48" height="48" loading="lazy">
                      <div><strong><%= p.name %></strong><span><%= p.categoryName %> · <%= p.brand %></span></div>
                    </div>
                  </td>
                  <td data-label="Price"><strong><%= formatPrice(p.price) %></strong></td>
                  <td data-label="M.R.P."><%= formatPrice(p.mrp) %></td>
                  <td data-label="Discount"><%= p.discountPercent ? p.discountPercent + '%' : '—' %></td>
                  <td data-label="Stock"><span class="<%= p.stock === 0 ? 'text-red' : p.isLowStock ? 'text-amber' : '' %>"><%= p.stock %></span></td>
                  <td data-label="Status"><span class="pill <%= STATUS_PILLS[p.status] %>" data-status><%= STATUS_LABELS[p.status] %></span></td>
                  <td class="cell-action"><div class="row-actions">
                    <a class="btn btn-ghost btn-sm" href="<%= adminPath %>/products/<%= p.id %>/edit" aria-label="Edit <%= p.name %>"><%- icon('edit', 'i-xs') %> Edit</a>
                    <button type="button" class="btn btn-sm <%= p.isListed ? 'btn-danger-soft' : 'btn-secondary' %>"
                            data-toggle-listing="<%= p.id %>" data-listed="<%= p.isListed %>" data-name="<%= p.name %>" data-stock="<%= p.stock %>"
                            aria-label="<%= p.isListed ? 'Unlist' : 'List' %> <%= p.name %>"><%= p.isListed ? 'Unlist' : 'List' %></button>
                  </div></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state empty-state-flat">
          <%- include('../partials/empty-art', { art: 'box' }) %>
          <h2>No products found</h2>
          <p><%= filtered ? 'Try a different search or filter.' : 'Add your first product to start selling.' %></p>
          <% if (filtered) { %>
            <a class="btn btn-secondary" href="<%= adminPath %>/products">Show all products</a>
          <% } else { %>
            <a class="btn btn-primary" href="<%= adminPath %>/products/new"><%- icon('plus', 'i-sm') %> Add product</a>
          <% } %>
        </div>
      <% } %>
      <%- include('../partials/admin-pager') %>
    </section>
<%- include('../partials/admin-end') %>
