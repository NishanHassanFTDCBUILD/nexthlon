<%#
  One page for creating and for editing a Deal of the Day. Times are Indian time.
  The deal price is shown as a preview only; the server works it out (utils/pricing.js).
%>
<%
  const isEdit = Boolean(deal);
  const d = deal || { percent: '', startsInput: defaults.startsInput, endsInput: defaults.endsInput, sortOrder: 0, note: '', isActive: true, status: 'scheduled' };
%>
<%- include('../partials/admin-start', { section: 'deals', page: 'deal-form' }) %>
<nav class="breadcrumb breadcrumb-admin" aria-label="Breadcrumb">
  <a href="<%= adminPath %>/deals">Deals of the day</a> <%- icon('chevron-right', 'i-xs') %>
  <span aria-current="page"><%= isEdit ? 'Edit deal' : 'New deal' %></span>
</nav>
<header class="admin-top">
  <div>
    <span class="section-kicker"><%= isEdit ? 'Edit deal' : 'New deal' %></span>
    <h1><%= isEdit && d.product ? d.product.name : 'Create a deal' %></h1>
    <p class="muted">The shopper pays the best of the product offer, the category offer and this deal. They never add up.</p>
  </div>
</header>

<form class="form" data-deal-form novalidate
      data-endpoint="<%= isEdit ? '/api/admin/deals/' + d.id : '/api/admin/deals' %>"
      data-method="<%= isEdit ? 'PATCH' : 'POST' %>"
      data-done="<%= adminPath %>/deals">
  <div class="form-alert" data-form-alert aria-live="assertive"></div>

  <div class="product-form-grid">
    <section class="panel" aria-labelledby="deal-what-title">
      <h2 id="deal-what-title" class="panel-title">The deal</h2>
      <div class="form-grid form-grid-2">
        <div class="field field-wide">
          <label for="deal-product">Product</label>
          <div class="select-wrap select-field">
            <select id="deal-product" name="product" required data-deal-product aria-describedby="deal-product-error">
              <option value="">Choose a product</option>
              <% products.forEach(function (p) { %>
                <option value="<%= p.id %>" data-base="<%= p.basePrice %>" data-mrp="<%= p.mrp %>" <%= picked === p.id ? 'selected' : '' %>><%= p.name %><%= p.isListed ? '' : ' (unlisted)' %></option>
              <% }) %>
            </select>
          </div>
          <p class="field-error" id="deal-product-error" data-error-for="product"></p>
        </div>
        <div class="field">
          <label for="deal-percent">Deal discount (%)</label>
          <input id="deal-percent" name="percent" type="number" inputmode="numeric" required min="1" max="90" step="1" value="<%= d.percent %>" data-deal-percent aria-describedby="deal-percent-hint deal-percent-error">
          <p class="hint" id="deal-percent-hint">Off the product's base price, 1 to 90.</p>
          <p class="field-error" id="deal-percent-error" data-error-for="percent"></p>
        </div>
        <div class="field">
          <span class="label">Deal price</span>
          <p class="deal-preview" data-deal-preview aria-live="polite">Choose a product and a discount.</p>
        </div>
      </div>
    </section>

    <section class="panel" aria-labelledby="deal-when-title">
      <h2 id="deal-when-title" class="panel-title">When it runs</h2>
      <div class="form-grid form-grid-2">
        <div class="field">
          <label for="deal-starts">Starts</label>
          <input id="deal-starts" name="startsAt" type="datetime-local" required value="<%= d.startsInput %>" aria-describedby="deal-starts-error">
          <p class="field-error" id="deal-starts-error" data-error-for="startsAt"></p>
        </div>
        <div class="field">
          <label for="deal-ends">Ends</label>
          <input id="deal-ends" name="endsAt" type="datetime-local" required value="<%= d.endsInput %>" aria-describedby="deal-ends-hint deal-ends-error">
          <p class="hint" id="deal-ends-hint">Indian time. Up to 31 days. The home page countdown runs to the first live deal's end.</p>
          <p class="field-error" id="deal-ends-error" data-error-for="endsAt"></p>
        </div>
        <div class="field">
          <label for="deal-order">Home page position</label>
          <input id="deal-order" name="sortOrder" type="number" inputmode="numeric" min="0" max="999" step="1" value="<%= d.sortOrder %>" aria-describedby="deal-order-hint deal-order-error">
          <p class="hint" id="deal-order-hint">Lower numbers show first.</p>
          <p class="field-error" id="deal-order-error" data-error-for="sortOrder"></p>
        </div>
        <div class="field">
          <label for="deal-note">Note <span class="optional">(optional)</span></label>
          <input id="deal-note" name="note" maxlength="120" value="<%= d.note %>" placeholder="Weekend flash sale" aria-describedby="deal-note-error">
          <p class="field-error" id="deal-note-error" data-error-for="note"></p>
        </div>
        <div class="field field-wide">
          <label class="check">
            <input type="checkbox" name="isActive" value="true" <%= d.isActive ? 'checked' : '' %>>
            <span>Switched on — runs between these times</span>
          </label>
          <p class="hint">Turn this off to stop the deal at once without deleting it. The usual price comes back.</p>
        </div>
      </div>
    </section>
  </div>

  <div class="form-actions admin-status-actions admin-save-bar">
    <button class="btn btn-primary" type="submit"><%- icon('check', 'i-sm') %> <%= isEdit ? 'Save the deal' : 'Create the deal' %></button>
    <a class="btn btn-ghost" href="<%= adminPath %>/deals">Cancel</a>
  </div>
</form>
<%- include('../partials/admin-end') %>
