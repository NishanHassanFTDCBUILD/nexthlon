<%#
  One customer request: the conversation, the order it is about, and a reply box with ready-made
  replies. Replying sets the status and is audit-logged. Script: public/js/admin-support.js.
%>
<%
  const statusLabel = { open: 'Waiting for us', pending: 'Waiting for customer', resolved: 'Resolved' };
  const statusPill = { open: 'pill-red', pending: 'pill-amber', resolved: 'pill-green' };
%>
<%- include('../partials/admin-start', { section: 'support', page: 'support-ticket' }) %>
<nav class="breadcrumb breadcrumb-admin" aria-label="Breadcrumb">
  <a href="<%= adminPath %>/support">Support inbox</a> <%- icon('chevron-right', 'i-xs') %>
  <span aria-current="page"><%= ticket.ticketId %></span>
</nav>
<header class="admin-top">
  <div>
    <span class="section-kicker"><%= ticket.topic %></span>
    <h1><%= ticket.subject %></h1>
    <p class="muted">
      <%= ticket.customer ? ticket.customer.name + ' · ' + ticket.customer.email : 'Customer' %>
      <% if (ticket.orderId) { %> · order <a href="<%= adminPath %>/orders/<%= ticket.orderId %>"><%= ticket.orderId %></a><% } %>
      · <span class="pill <%= statusPill[ticket.status] %>"><%= statusLabel[ticket.status] %></span>
    </p>
  </div>
</header>

<div class="support-layout">
  <section class="panel support-thread" aria-label="Conversation">
    <% ticket.messages.forEach(function (m) { %>
      <article class="support-msg support-msg-<%= m.from === 'admin' ? 'us' : 'customer' %>">
        <header><strong><%= m.from === 'admin' ? 'Nexthlon support' : (ticket.customer ? ticket.customer.name : 'Customer') %></strong> <small class="muted"><%= formatDate(m.at) %></small></header>
        <p><%= m.body %></p>
      </article>
    <% }) %>
  </section>

  <aside class="panel support-reply" aria-labelledby="reply-title">
    <h2 id="reply-title" class="panel-title">Reply</h2>
    <form class="form" data-support-reply="<%= ticket.ticketId %>" novalidate>
      <div class="form-alert" data-form-alert aria-live="assertive"></div>
      <div class="field">
        <label for="canned">Ready-made reply</label>
        <span class="select-wrap">
          <select id="canned" data-canned>
            <option value="">Start from scratch</option>
            <% cannedReplies.forEach(function (c, i) { %><option value="<%= i %>"><%= c.label %></option><% }) %>
          </select>
        </span>
        <script type="application/json" id="canned-data"><%- JSON.stringify(cannedReplies.map(function (c) { return c.body; })).replace(/</g, '\\u003c') %></script>
      </div>
      <div class="field">
        <label for="reply-body">Message to the customer</label>
        <textarea id="reply-body" name="message" rows="6" required minlength="2" maxlength="2000" aria-describedby="reply-body-error"></textarea>
        <p class="field-error" id="reply-body-error" data-error-for="message"></p>
      </div>
      <div class="field">
        <label for="reply-status">After sending, the request is</label>
        <span class="select-wrap">
          <select id="reply-status" name="status">
            <option value="pending" selected>Waiting for the customer</option>
            <option value="resolved">Resolved</option>
            <option value="open">Still with us</option>
          </select>
        </span>
      </div>
      <button class="btn btn-primary" type="submit"><%- icon('send', 'i-sm') %> Send reply</button>
    </form>
  </aside>
</div>
<%- include('../partials/admin-end') %>
