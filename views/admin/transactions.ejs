<%
  const dirMark = { in: '+', out: '−', none: '' };
  const statusPill = { captured: 'pill-green', collected: 'pill-green', processed: 'pill-green', completed: 'pill-green', applied: 'pill-grey', pending: 'pill-amber', failed: 'pill-red' };
  const methodName = function (m) { return { razorpay: 'Razorpay', cod: 'Cash', wallet: 'Wallet', original: 'Card/UPI' }[m] || '—'; };
  const filtered = filters.type !== 'all' || filters.status !== 'all' || filters.method !== 'all' || filters.from || filters.to || filters.q;
%>
<%- include('../partials/admin-start', { section: 'transactions' }) %>
<header class="admin-top">
  <div>
    <span class="section-kicker">Sales</span>
    <h1>Transactions</h1>
    <p class="muted">Every money movement: online payments, cash on delivery, refunds, wallet credits and coupons.</p>
  </div>
  <div class="admin-top-actions">
    <a class="btn btn-ghost btn-sm" href="<%= adminPath %>/transactions/reconciliation"><%- icon('check', 'i-sm') %> Daily reconciliation</a>
    <a class="btn btn-ghost btn-sm" href="/api/admin/transactions/export.csv?<%= exportQuery %>" download data-full-load><%- icon('download', 'i-sm') %> CSV</a>
    <a class="btn btn-ghost btn-sm" href="/api/admin/transactions/export.xlsx?<%= exportQuery %>" download data-full-load><%- icon('download', 'i-sm') %> Excel</a>
  </div>
</header>

<section class="admin-totals" aria-label="Totals for these filters">
  <div class="admin-total is-in"><span>Money in</span><strong><%= formatPrice(totals.in) %></strong><small class="muted">Captured online payments and cash collected</small></div>
  <div class="admin-total is-out"><span>Money out</span><strong><%= formatPrice(totals.out) %></strong><small class="muted">Refunds and wallet credits given</small></div>
  <div class="admin-total"><span>Net</span><strong><%= formatPrice(totals.net) %></strong><small class="muted">In minus out</small></div>
  <div class="admin-total is-other"><span>Not counted</span><strong><%= formatPrice(totals.other) %></strong><small class="muted">Coupons, wallet spends, pending and failed</small></div>
</section>

<%- include('../partials/admin-list-toolbar', { section: 'transactions', searchMax: 60, searchHint: 'Order number, payment id or customer', sorts, fields: [
{ key: 'type', label: 'Type', options: [['', 'Any type'], ...types.map(function (t) { return [t, typeLabels[t]]; })] },
{ key: 'status', label: 'Status', options: [['', 'Any status'], ...txStatuses.map(function (s) { return [s, s]; })] },
{ key: 'method', label: 'Method', options: [['', 'Any method'], ...txMethods.map(function (m) { return [m, methodName(m)]; })] },
{ key: 'from', label: 'From', type: 'date' }, { key: 'to', label: 'To', type: 'date' }
] }) %>



<section class="panel panel-flush admin-table-panel" aria-label="Transactions">
  <% if (transactions.length) { %>
    <div class="table-wrap admin-table-scroll">
      <table class="table table-stack admin-table">
        <thead><tr><%- include('../partials/admin-sort-header', { label: 'Date', asc: 'oldest', desc: 'newest' }) %><th scope="col">Type</th><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Method</th><%- include('../partials/admin-sort-header', { label: 'Amount', asc: 'amount_asc', desc: 'amount_desc' }) %><th scope="col">Status</th><th scope="col">Reference</th></tr></thead>
        <tbody>
          <% transactions.forEach(function (t) { %>
            <tr data-row-href="<%= adminPath %>/transactions/<%= t.id %>">
              <td data-label="Date"><a href="<%= adminPath %>/transactions/<%= t.id %>"><%= formatDate(t.at) %></a><small class="muted admin-sub"><%= new Date(t.at).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata' }) %></small></td>
              <td data-label="Type"><%= typeLabels[t.type] %></td>
              <td data-label="Order"><% if (t.orderId) { %><a href="<%= adminPath %>/orders/<%= t.orderId %>"><%= t.orderId %></a><% } else { %>—<% } %></td>
              <td data-label="Customer"><%= t.customer ? t.customer.name : '—' %></td>
              <td data-label="Method"><%= methodName(t.method) %></td>
              <td data-label="Amount" class="cell-num"><strong class="admin-amt is-<%= t.direction %>"><%= dirMark[t.direction] %><%= formatPrice(t.amount) %></strong></td>
              <td data-label="Status"><span class="pill <%= statusPill[t.status] || 'pill-grey' %>"><%= t.status %></span></td>
              <td data-label="Reference"><code class="admin-code"><%= t.reference || '—' %></code></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/admin-pager') %>
  <% } else { %>
    <div class="empty-state empty-state-flat">
      <%- include('../partials/empty-art', { art: 'wallet' }) %>
      <h2><%= filtered ? 'Nothing matches these filters' : 'No money movements yet' %></h2>
      <p><%= filtered ? 'Try fewer filters.' : 'Payments, refunds and wallet credits will appear here.' %></p>
    </div>
  <% } %>
</section>
<%- include('../partials/admin-end') %>
