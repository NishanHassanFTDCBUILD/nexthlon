<%#
  The My Account shell: a sidebar on wide screens, a horizontal tab bar on phones, and the
  section's content. Usage: include('../partials/account-start', { section: 'orders' }) ... then
  include('../partials/account-end'). Account pages are calm on purpose: no store motion is loaded
  (res.locals.motion is false) and the active section has a static volt highlight.
%>
<%
  const activeSection = typeof section !== 'undefined' ? section : '';
  // The section's script in account.js (window.NxPages[name]); order and ticket pages name their own.
  const pageName = typeof acctPage !== 'undefined' ? acctPage : 'account-' + activeSection;
  // A page that needs extra scripts (Razorpay on an unpaid order) always loads in full.
  const fullOnly = typeof canRetryPayment !== 'undefined' && Boolean(canRetryPayment);
  const contentAttrs = 'class="acct-content" data-acct-page="' + pageName + '" data-acct-section="' + activeSection + '"' + (fullOnly ? ' data-acct-full="1"' : '');
%>
<% if (typeof partial !== 'undefined' && partial) { %>
<div <%- contentAttrs %> data-acct-title="<%= title %>">
<% } else { %>
<%- include('head', { styles: ['account'], bodyClass: 'acct-body' }) %>
<%- include('header') %>
<%
  const accountNav = [
    { group: '', items: [{ key: 'overview', href: '/account', icon: 'grid', label: 'Overview' }] },
    { group: 'Orders', items: [
      { key: 'orders', href: '/account/orders', icon: 'package-check', label: 'Your orders' },
      { key: 'buy-again', href: '/account/buy-again', icon: 'rotate-ccw', label: 'Buy it again' }
    ] },
    { group: 'Payments', items: [
      { key: 'wallet', href: '/account/wallet', icon: 'wallet', label: 'Wallet' },
      { key: 'coupons', href: '/account/coupons', icon: 'ticket', label: 'Coupons & offers' }
    ] },
    { group: 'Shopping', items: [
      { key: 'lists', href: '/account/lists', icon: 'heart', label: 'Wishlist & lists' },
      { key: 'reviews', href: '/account/reviews', icon: 'star', label: 'Your reviews' },
      { key: 'recent', href: '/account/recent', icon: 'history', label: 'Recently viewed' }
    ] },
    { group: 'Account', items: [
      { key: 'addresses', href: '/account/addresses', icon: 'pin', label: 'Addresses' },
      { key: 'security', href: '/account/security', icon: 'lock', label: 'Login & security' },
      { key: 'notifications', href: '/account/notifications', icon: 'mail', label: 'Notifications' },
      { key: 'referral', href: '/account/referral', icon: 'gift', label: 'Refer a friend' },
      { key: 'help', href: '/account/help', icon: 'headset', label: 'Help & support' }
    ] }
  ];
%>
<main id="main" class="container page acct" data-acct>
  <div class="acct-layout">
    <aside class="acct-side" aria-label="Your account">
      <a class="acct-me" href="/account">
        <span class="avatar acct-me-avatar" aria-hidden="true"><%= currentUser.name.charAt(0).toUpperCase() %></span>
        <span class="acct-me-text"><strong data-user-name><%= currentUser.name %></strong><small data-user-email><%= currentUser.email %></small></span>
      </a>
      <nav class="acct-nav" aria-label="Account sections" data-acct-nav>
        <% accountNav.forEach(function (group) { %>
          <% if (group.group) { %><span class="acct-nav-group"><%= group.group %></span><% } %>
          <% group.items.forEach(function (item) { %>
            <a class="acct-link<%= activeSection === item.key ? ' is-active' : '' %>" href="<%= item.href %>" data-acct-link="<%= item.key %>" <%- activeSection === item.key ? 'aria-current="page"' : '' %>><%- icon(item.icon, 'i-sm') %><span><%= item.label %></span></a>
          <% }) %>
        <% }) %>
      </nav>
    </aside>
    <div class="acct-main" data-acct-main>
      <div class="acct-loading" data-acct-loading role="status"><span class="acct-loading-spin" aria-hidden="true"></span>Loading…</div>
      <div <%- contentAttrs %>>
<% } %>
