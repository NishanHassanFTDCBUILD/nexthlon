<%# Full-width "Continue with" buttons, Google first. Each shows only once its keys are set
    (middleware/viewLocals.js). auth.js adds the "Connecting…" state and the "Last used" badge. %>
<% if (googleSignIn || facebookSignIn) { %>
<% const destination = typeof next !== 'undefined' && next !== '/' ? '?next=' + encodeURIComponent(next) : ''; %>
<div class="au-social" data-social>
  <div class="au-social-row">
    <% if (googleSignIn) { %>
      <a class="au-social-btn au-social-google" href="/api/auth/google<%= destination %>" data-social-btn="google">
        <span class="au-social-mark" aria-hidden="true">
          <svg class="au-social-logo" viewBox="0 0 48 48" focusable="false"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        </span>
        <span class="au-social-label" data-social-label>Continue with Google</span>
        <span class="au-social-last" data-social-last hidden>Last used</span>
        <span class="au-social-go" aria-hidden="true"><svg class="i i-sm" aria-hidden="true" focusable="false"><use href="/img/icons.svg#arrow-right"></use></svg></span>
        <svg class="au-social-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
      </a>
    <% } %>
    <% if (facebookSignIn) { %>
      <a class="au-social-btn au-social-facebook" href="/api/auth/facebook<%= destination %>" data-social-btn="facebook">
        <span class="au-social-mark" aria-hidden="true">
          <svg class="au-social-logo" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="12" fill="currentColor"/><path class="au-social-f" d="M15.1 15.5l.5-3.2h-3.1v-2.1c0-.9.4-1.7 1.8-1.7h1.4V5.8s-1.3-.2-2.5-.2c-2.6 0-4.2 1.5-4.2 4.3v2.4H6.2v3.2H9V24h3.5v-8.5h2.6z"/></svg>
        </span>
        <span class="au-social-label" data-social-label>Continue with Facebook</span>
        <span class="au-social-last" data-social-last hidden>Last used</span>
        <span class="au-social-go" aria-hidden="true"><svg class="i i-sm" aria-hidden="true" focusable="false"><use href="/img/icons.svg#arrow-right"></use></svg></span>
        <svg class="au-social-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
      </a>
    <% } %>
  </div>
  <p class="au-social-note"><svg class="i i-xs" aria-hidden="true" focusable="false"><use href="/img/icons.svg#lock"></use></svg> One tap, no password. We never post for you.</p>
  <p class="au-divider">or use your email</p>
</div>
<% } %>
