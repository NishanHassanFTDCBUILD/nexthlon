<details class="panel admin-block">
  <summary>Bulk restock and CSV import</summary>
  <p class="muted">Adds units; it does not replace current stock. Preview up to 100 rows, then confirm. For products with sizes, use the option ID in the CSV.</p>
  <p><a class="link-btn" href="/api/admin/inventory/restock-template.csv" download data-full-load>Download CSV template</a></p>
  <form class="admin-inline-form" method="post" data-inventory-bulk>
    <label class="admin-field"><span>Units to add to each selected product</span><input name="units" type="number" min="1" max="100000" step="1" inputmode="numeric" required></label>
    <label class="admin-field"><span>Reason</span><select name="reason" required><option value="restock">Restock</option><option value="return">Returned units</option><option value="stock_count">Physical count correction</option><option value="other">Other</option></select></label>
    <label class="admin-field"><span>Note</span><input name="note" maxlength="120"></label>
    <button class="btn btn-secondary btn-sm" type="submit">Preview selected products</button>
  </form>
  <form class="admin-inline-form" method="post" data-inventory-csv>
    <label class="admin-field"><span>Restock CSV (10 KB maximum)</span><input name="csv" type="file" accept=".csv,text/csv" required aria-describedby="inventory-csv-help"></label>
    <button class="btn btn-secondary btn-sm" type="submit">Preview CSV</button>
    <p class="muted" id="inventory-csv-help">Required columns: productId, units, reason. Optional: optionId, note. Reasons: restock, damage, return, stock_count, sale_correction, other. IDs are included in the inventory export.</p>
  </form>
  <section data-import-preview hidden aria-label="Restock preview" tabindex="-1">
    <p data-import-summary role="status"></p>
    <div class="table-wrap"><table class="table table-stack"><thead><tr><th scope="col">CSV row</th><th scope="col">Product</th><th scope="col">Units to add</th><th scope="col">Reason</th><th scope="col">Errors / result</th></tr></thead><tbody data-import-rows></tbody></table></div>
    <div class="admin-top-actions">
      <button class="btn btn-primary btn-sm" type="button" data-import-apply hidden>Confirm restock</button>
      <button class="btn btn-secondary btn-sm" type="button" data-import-errors hidden>Download error report</button>
      <button class="btn btn-secondary btn-sm" type="button" data-import-refresh hidden>Refresh stock list</button>
    </div>
  </section>
</details>
