<article class="product-card" data-reveal data-tilt>
  <div class="product-media">
    <img src="<%= p.image %>" alt="" loading="lazy" decoding="async" width="400" height="400">
    <% if (p.discountPercent > 0) { %><span class="tag tag-deal"><%= p.discountPercent %>% off</span><% } %>
  </div>
  <button type="button" class="wish-btn" data-wish-id="<%= p._id %>" aria-pressed="false" hidden>
    <%- icon('heart') %><span class="sr-only">Save <%= p.name %> to your wishlist</span>
  </button>
  <div class="product-body">
    <span class="product-meta"><%= p.brand %></span>
    <h3 class="product-name"><a href="/products/<%= p.slug %>"><%= p.name %></a></h3>
    <% if (p.ratingCount > 0) { %>
      <p class="product-rating"><span class="rating-chip"><%= p.ratingAverage.toFixed(1) %> <%- icon('star', 'i-xs') %></span> <span class="muted">(<%= p.ratingCount %>)</span><span class="sr-only"> Rated <%= p.ratingAverage.toFixed(1) %> out of 5 by <%= p.ratingCount %> <%= p.ratingCount === 1 ? 'customer' : 'customers' %></span></p>
    <% } %>
    <% if (p.highlights && p.highlights.length) { %>
      <ul class="product-points">
        <% p.highlights.slice(0, 2).forEach(function (line) { %><li><%= line.split(':')[0] %></li><% }) %>
      </ul>
    <% } %>
    <div class="price-block">
      <div class="price-row">
        <span class="price"><%= formatPrice(p.price) %></span>
        <% if (p.mrp > p.price) { %>
          <span class="mrp"><span class="sr-only">M.R.P. </span><s><%= formatPrice(p.mrp) %></s></span>
          <% if (p.discountPercent > 0) { %><span class="off"><%= p.discountPercent %>% off</span><% } %>
        <% } %>
      </div>
    </div>
    <div class="product-foot">
      <%- include('stock', { stock: p.stock }) %>
      <% if (p.price >= store.freeDeliveryMin && p.stock > 0) { %><span class="product-delivery">Free delivery</span><% } %>
    </div>
  </div>
</article>
