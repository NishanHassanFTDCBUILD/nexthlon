<%# Sign in or sign up with a code to your phone, in three steps: number, code, then (new numbers only)
    name and email. Script: public/js/auth-phone.js. Server: services/phoneSignInService.js. %>
<div class="au-phone" data-phone data-next="<%= next %>">
  <%# Step 1: the number %>
  <form class="au-form" data-phone-step="number" novalidate>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <div class="au-field au-field-tel" data-field>
      <span class="au-cc" aria-hidden="true">+91</span>
      <input id="ph-number" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder=" " required aria-describedby="ph-number-hint ph-number-error">
      <label for="ph-number">Mobile number</label>
      <span class="au-line" aria-hidden="true"></span>
      <span class="au-ok" aria-hidden="true"><%- icon('check', 'i-xs') %></span>
      <p class="au-hint" id="ph-number-hint">We'll text you a 6-digit code. New here? The same code creates your account.</p>
      <p class="field-error" id="ph-number-error" data-error-for="phone"></p>
    </div>
    <button class="au-submit" type="submit" data-submit>
      <span class="au-submit-label">Send code</span>
      <svg class="au-submit-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
      <svg class="au-submit-tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
    </button>
  </form>

  <%# Step 2: the code. One real input (so the phone can fill it from the SMS) drawn as six boxes. %>
  <form class="au-form" data-phone-step="code" novalidate hidden>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <p class="au-sent-to">Code sent to <strong data-phone-show></strong> <button type="button" class="link-btn" data-phone-change>Change</button></p>
    <div class="au-otp" data-otp>
      <label class="sr-only" for="ph-code">6-digit code</label>
      <input id="ph-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" required aria-describedby="ph-code-error">
      <div class="au-otp-boxes" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
    <p class="field-error" id="ph-code-error" data-error-for="code"></p>
    <button class="au-submit" type="submit" data-submit>
      <span class="au-submit-label">Verify and continue</span>
      <svg class="au-submit-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
      <svg class="au-submit-tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
    </button>
    <p class="au-resend"><button type="button" class="link-btn" data-resend disabled>Resend code<span data-resend-wait> in <span data-resend-count>30</span>s</span></button></p>
  </form>

  <%# Step 3 (new numbers only): name and email for the new account %>
  <form class="au-form" data-phone-step="profile" novalidate hidden>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <p class="au-sent-to"><%- icon('check', 'i-xs') %> <span><strong data-phone-show></strong> confirmed. Add your name and email to finish.</span></p>
    <%- include('auth-field', { id: 'ph-name', name: 'name', label: 'Full name', type: 'text', fieldIcon: 'user', autocomplete: 'name', max: 60, hint: '' }) %>
    <%- include('auth-field', { id: 'ph-email', name: 'email', label: 'Email address', type: 'email', fieldIcon: 'mail', autocomplete: 'email', max: 254, hint: '<span>For order updates and invoices.</span>' }) %>
    <button class="au-submit" type="submit" data-submit>
      <span class="au-submit-label">Create account</span>
      <svg class="au-submit-spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
      <svg class="au-submit-tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
    </button>
    <p class="au-foot muted">By creating an account you agree to our <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.</p>
  </form>
</div>
