<aside class="admin-sidebar">
  <a class="brand brand-light" href="/admin" aria-label="Nexthlon admin dashboard">
    <span class="brand-mark"><%- icon('bolt') %></span>
    <span class="brand-word">NEXTHLON<small>Admin console</small></span>
  </a>
  <nav class="admin-nav" aria-label="Admin">
    <span class="admin-nav-label">Manage</span>
    <a href="/admin" class="<%= path === '/admin' ? 'is-active' : '' %>" <%- path === '/admin' ? 'aria-current="page"' : '' %>><%- icon('grid') %> Dashboard</a>
    <a href="/admin/users" class="<%= path === '/admin/users' ? 'is-active' : '' %>" <%- path === '/admin/users' ? 'aria-current="page"' : '' %>><%- icon('users') %> Users</a>
    <% const onProducts = path.startsWith('/admin/products'); %>
    <a href="/admin/products" class="<%= onProducts ? 'is-active' : '' %>" <%- onProducts ? 'aria-current="page"' : '' %>><%- icon('box') %> Products</a>
    <span class="admin-nav-label">Next modules</span>
    <span class="admin-nav-soon"><%- icon('truck') %> Orders <em>Soon</em></span>
  </nav>
  <div class="admin-sidebar-foot">
    <div class="admin-sidebar-user">
      <span class="avatar avatar-sm"><%= currentUser.name.charAt(0).toUpperCase() %></span>
      <span><strong><%= currentUser.name %></strong><small><%= currentUser.email %></small></span>
    </div>
    <a href="/"><%- icon('home') %> <span>View store</span></a>
    <button type="button" data-logout="/api/admin/logout"><%- icon('logout') %> <span>Sign out</span></button>
  </div>
</aside>
