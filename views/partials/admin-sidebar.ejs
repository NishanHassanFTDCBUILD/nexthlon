<%# The admin sidebar: collapsible groups from config/adminNav.js, a static volt highlight on the active section. %>
<aside class="admin-side" id="admin-side" aria-label="Admin" data-admin-side>
  <div class="admin-side-head">
    <a class="brand" href="<%= adminPath %>/dashboard">
      <span class="brand-mark"><%- icon('bolt') %></span>
      <span class="brand-word">NEXTHLON <small>Admin console</small></span><span class="sr-only">, dashboard</span>
    </a>
    <button type="button" class="icon-btn admin-side-close" data-admin-menu-close aria-label="Close menu"><%- icon('x') %></button>
  </div>
  <nav class="admin-sidenav" aria-label="Admin sections">
    <% adminNav.forEach(function (group) {
         const open = group.items.some(function (item) { return item.key === activeSection; });
         const id = 'admin-group-' + group.group.toLowerCase(); %>
      <div class="admin-group" data-admin-group="<%= group.group %>">
        <button type="button" class="admin-group-btn" aria-expanded="true" aria-controls="<%= id %>" data-admin-group-toggle <%- open ? 'data-has-active' : '' %>>
          <span><%= group.group %></span><%- icon('chevron-down', 'i-xs') %>
        </button>
        <div class="admin-group-items" id="<%= id %>">
          <% group.items.forEach(function (item) { const on = item.key === activeSection; %>
            <a href="<%= adminPath %>/<%= item.key %>" class="admin-link<%= on ? ' is-active' : '' %>" data-nav-link="<%= item.key %>" data-label="<%= item.label %>" data-group="<%= group.group %>" <%- on ? 'aria-current="page"' : '' %>>
              <%- icon(item.icon, 'i-sm') %><span><%= item.label %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </nav>
  <div class="admin-side-foot">
    <a href="/" class="admin-link" data-nav-skip><%- icon('home', 'i-sm') %><span>View store</span><%- icon('external-link', 'i-xs') %></a>
  </div>
</aside>
<div class="admin-scrim" data-admin-menu-close hidden></div>
