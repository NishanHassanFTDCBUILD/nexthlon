<%# Payment method badges, drawn with inline SVG (no image files, nothing loaded from outside). %>
<ul class="pay-list" aria-label="Payment methods we accept">
  <li>
    <svg class="pay-badge" viewBox="0 0 64 40" role="img" aria-label="UPI"><title>UPI</title>
      <rect width="64" height="40" rx="6" fill="#fff"/>
      <path d="M12 12h4l-3 16H9z" fill="#097939"/><path d="M18 12h4l-3 16h-4z" fill="#ed752e"/>
      <text x="44" y="25.5" text-anchor="middle" font-family="Arial, sans-serif" font-size="13" font-weight="800" font-style="italic" fill="#3d3d3d">UPI</text>
    </svg>
  </li>
  <li>
    <svg class="pay-badge" viewBox="0 0 64 40" role="img" aria-label="Visa"><title>Visa</title>
      <rect width="64" height="40" rx="6" fill="#fff"/>
      <text x="32" y="26" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="900" font-style="italic" fill="#1a1f71" letter-spacing="0.5">VISA</text>
    </svg>
  </li>
  <li>
    <svg class="pay-badge" viewBox="0 0 64 40" role="img" aria-label="Mastercard"><title>Mastercard</title>
      <rect width="64" height="40" rx="6" fill="#fff"/>
      <circle cx="26" cy="20" r="10" fill="#eb001b"/><circle cx="38" cy="20" r="10" fill="#f79e1b"/>
      <path d="M32 12a10 10 0 0 1 0 16 10 10 0 0 1 0-16z" fill="#ff5f00"/>
    </svg>
  </li>
  <li>
    <svg class="pay-badge" viewBox="0 0 64 40" role="img" aria-label="RuPay"><title>RuPay</title>
      <rect width="64" height="40" rx="6" fill="#fff"/>
      <text x="28" y="25" text-anchor="middle" font-family="Arial, sans-serif" font-size="12.5" font-weight="900" font-style="italic" fill="#1b3f8f">RuPay</text>
      <path d="M48 13l6 7-6 7z" fill="#f47b20"/><path d="M45 13l6 7-6 7z" fill="#108b48" opacity="0.85"/>
    </svg>
  </li>
  <li>
    <svg class="pay-badge" viewBox="0 0 64 40" role="img" aria-label="Net banking"><title>Net banking</title>
      <rect width="64" height="40" rx="6" fill="#fff"/>
      <path d="M12 17h14l-7-5zM13.5 17v7M17 17v7M21 17v7M24.5 17v7M12 26h14" stroke="#24406e" stroke-width="1.8" fill="none" stroke-linejoin="round"/>
      <text x="45" y="18" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" font-weight="700" fill="#24406e">NET</text>
      <text x="45" y="27" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" font-weight="700" fill="#24406e">BANKING</text>
    </svg>
  </li>
  <li>
    <svg class="pay-badge" viewBox="0 0 64 40" role="img" aria-label="Wallets"><title>Wallets</title>
      <rect width="64" height="40" rx="6" fill="#fff"/>
      <rect x="11" y="13" width="17" height="14" rx="3" fill="none" stroke="#24406e" stroke-width="1.8"/><circle cx="24" cy="20" r="1.6" fill="#ff7a1a"/>
      <text x="45" y="24" text-anchor="middle" font-family="Arial, sans-serif" font-size="8.5" font-weight="700" fill="#24406e">WALLETS</text>
    </svg>
  </li>
</ul>
