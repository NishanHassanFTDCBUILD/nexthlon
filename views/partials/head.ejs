<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Nexthlon: performance sports gear for runners, footballers, hikers and every athlete.' %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow">
  <% } %><meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0a0a0b">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <%# Sets the dark theme before the first paint (the store has no light mode). %>
  <script src="/js/theme.js"></script>
  <%# The fonts come from this site (tokens.css). The three the first screen needs load straight away. %>
  <link rel="preload" href="/fonts/inter-400-800-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/barlow-condensed-800-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/barlow-condensed-700-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/style.css">
  <%# The store's motion layer. My Account pages turn it off (res.locals.motion = false). %>
  <% if (typeof motion === 'undefined' || motion !== false) { %><link rel="stylesheet" href="/css/motion.css"><% } %>
  <% (typeof styles !== 'undefined' ? styles : []).forEach(function (name) { %><link rel="stylesheet" href="/css/<%= name %>.css">
  <% }) %>
  <%# Phone fixes last, so they win on small screens (every rule is inside a width query). %>
  <link rel="stylesheet" href="/css/mobile.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<% if (typeof adminPath !== 'undefined' && adminPath) { %> data-admin-path="<%= adminPath %>"<% } %>>
