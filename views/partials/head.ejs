<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <% const pageDescription = typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Nexthlon: performance sports gear for runners, footballers, hikers and every athlete. Free delivery over ' + formatPrice(store.freeDeliveryMin) + ', ' + store.returnDays + '-day returns.'; %>
  <meta name="description" content="<%= pageDescription %>">
  <% const hidden = typeof noindex !== 'undefined' && noindex; %>
  <% if (hidden) { %><meta name="robots" content="noindex, nofollow">
  <% } else if (typeof canonical !== 'undefined' && canonical) { %><link rel="canonical" href="<%= canonical %>">
  <%# Link previews (WhatsApp, Instagram, Facebook, X, LinkedIn) and search data (middleware/seo.js, utils/seo.js). %>
  <meta property="og:site_name" content="Nexthlon">
  <meta property="og:locale" content="en_IN">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : title %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : pageDescription %>">
  <meta property="og:url" content="<%= canonical %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:alt" content="<%= typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : title %>">
  <% if (typeof ogImageSize !== 'undefined' && ogImageSize) { %><meta property="og:image:width" content="<%= ogImageSize[0] %>">
  <meta property="og:image:height" content="<%= ogImageSize[1] %>">
  <% } %><% } %><% if (typeof ogPrice !== 'undefined' && ogPrice) { %><meta property="product:price:amount" content="<%= ogPrice.amount %>">
  <meta property="product:price:currency" content="INR">
  <meta property="product:availability" content="<%= ogPrice.inStock ? 'in stock' : 'out of stock' %>">
  <% } %><meta name="twitter:card" content="summary_large_image">
  <% (typeof jsonLd !== 'undefined' ? jsonLd : []).forEach(function (data) { %><script type="application/ld+json"><%- seoJson(data) %></script>
  <% }) %><% } %><meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0a0a0b">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <%# Most product photos come from Unsplash: open that connection while the page is still loading. %>
  <link rel="preconnect" href="https://images.unsplash.com">
  <% if (typeof storageOrigin !== 'undefined' && storageOrigin) { %><link rel="preconnect" href="<%= storageOrigin %>"><% } %>
  <%# Sets the dark theme before the first paint (the store has no light mode). %>
  <script src="<%= asset('/js/theme.js') %>"></script>
  <%# Page transitions, the arriving side: must run before the first frame, so it is not deferred (tiny, cached a year). %>
  <script src="<%= asset('/js/page-reveal.js') %>"></script>
  <%# The fonts come from this site (tokens.css). The two the first screen needs (body text and the 800 headline weight) load straight away. %>
  <link rel="preload" href="/fonts/inter-400-800-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/barlow-condensed-800-latin.woff2" as="font" type="font/woff2" crossorigin>
  <%# All of the page's stylesheets in one request, in cascade order (utils/assets.js):
       tokens, components, style; page styles that belong before the motion layer (coreStyles, e.g.
       the home page's home.css); the motion layer (My Account pages turn it off with
       res.locals.motion = false); page styles (styles); and the phone fixes last, so they win. %>
  <% const sheets = ['tokens', 'components', 'style']
       .concat(typeof coreStyles !== 'undefined' ? coreStyles : [])
       .concat(typeof motion === 'undefined' || motion !== false ? ['motion'] : [])
       .concat(typeof styles !== 'undefined' ? styles : [])
       .concat(['mobile']); %>
  <link rel="stylesheet" href="<%= styleBundle(sheets) %>">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<% if (typeof adminPath !== 'undefined' && adminPath) { %> data-admin-path="<%= adminPath %>"<% } %>>
