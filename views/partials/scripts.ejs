<div class="toasts" id="toasts" aria-live="polite"></div>

<dialog class="confirm-dialog" id="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message">
  <form method="dialog">
    <span class="confirm-icon" data-confirm-icon><%- icon('alert') %></span>
    <h2 id="confirm-title">Are you sure?</h2>
    <p id="confirm-message"></p>
    <div class="dialog-actions">
      <button class="btn btn-ghost" value="cancel">Cancel</button>
      <button class="btn btn-danger" value="ok" id="confirm-ok">Confirm</button>
    </div>
  </form>
</dialog>

<%# Cookie consent (D2): only when the owner set up analytics, and never on admin pages. public/js/consent.js %>
<% const consentOn = typeof analytics !== 'undefined' && analytics && analytics.enabled && !(typeof consent !== 'undefined' && consent === false); %>
<% if (consentOn) { %>
<section class="consent" id="consent" role="region" aria-labelledby="consent-title" hidden>
  <span class="consent-icon"><%- icon('shield', 'i-sm') %></span>
  <div class="consent-copy">
    <h2 id="consent-title">Cookies, your call</h2>
    <p>Essential cookies keep you signed in and hold your cart. With your OK we also count visits to make the store better. No ads, no selling data. <a href="/privacy#cookies">Details</a></p>
  </div>
  <div class="consent-actions">
    <button type="button" class="btn btn-ghost btn-sm" data-consent="essential">Only essential</button>
    <button type="button" class="btn btn-primary btn-sm" data-consent="analytics">Allow analytics</button>
  </div>
</section>
<% } %>
<% if (consentOn && typeof trackEvents !== 'undefined' && trackEvents && trackEvents.length) { %><script type="application/json" id="nx-events"><%- JSON.stringify(trackEvents).replace(/</g, '\\u003c') %></script><% } %>
<% if (typeof razorpay !== 'undefined' && razorpay) { %><script src="https://checkout.razorpay.com/v1/checkout.js" defer></script><% } %>
<%# The shared animation loop first: every animation on the page subscribes to it. %>
<script src="<%= asset('/js/motion/ticker.js') %>" defer></script>
<script src="<%= asset('/js/app.js') %>" defer></script>
<script src="<%= asset('/js/header.js') %>" defer></script>
<script src="<%= asset('/js/store.js') %>" defer></script>
<script src="<%= asset('/js/price-watch.js') %>" defer></script>
<% if (consentOn) { %><script src="<%= asset('/js/consent.js') %>" defer data-provider="<%= analytics.provider %>" data-id="<%= analytics.id %>" data-host="<%= analytics.host %>" data-meta-pixel="<%= metaPixel && metaPixel.enabled ? metaPixel.id : '' %>"></script><% } %>
<%# The installable app (E5): the service worker and the install button. Not on admin pages. %>
<% if (!(typeof consent !== 'undefined' && consent === false)) { %><script src="<%= asset('/js/pwa.js') %>" defer></script><% } %>
<% if (typeof motion === 'undefined' || motion !== false) { %>
<script src="<%= asset('/js/motion.js') %>" defer></script><% } %>
<% (typeof scripts !== 'undefined' ? scripts : []).forEach(function (name) { %>
  <script src="<%= asset('/js/' + name + '.js') %>" defer></script>
<% }) %>
<%# Page-specific ES modules (the 3D engine lives in public/js/3d). Modules always run after the page is parsed. %>
<% (typeof modules !== 'undefined' ? modules : []).forEach(function (name) { %>
  <script type="module" src="<%= asset('/js/' + name + '.js') %>"></script>
<% }) %>
</body>
</html>
