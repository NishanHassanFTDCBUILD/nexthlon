<div class="toasts" id="toasts" aria-live="polite"></div>

<dialog class="confirm-dialog" id="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message">
  <form method="dialog">
    <span class="confirm-icon" data-confirm-icon><%- icon('alert') %></span>
    <h2 id="confirm-title">Are you sure?</h2>
    <p id="confirm-message"></p>
    <div class="dialog-actions">
      <button class="btn btn-ghost" value="cancel">Cancel</button>
      <button class="btn btn-danger" value="ok" id="confirm-ok">Confirm</button>
    </div>
  </form>
</dialog>

<% if (typeof razorpay !== 'undefined' && razorpay) { %><script src="https://checkout.razorpay.com/v1/checkout.js" defer></script><% } %>
<%# The shared animation loop first: every animation on the page subscribes to it. %>
<script src="/js/motion/ticker.js" defer></script>
<script src="/js/app.js" defer></script>
<script src="/js/header.js" defer></script>
<script src="/js/store.js" defer></script>
<% if (typeof motion === 'undefined' || motion !== false) { %>
<script src="/js/motion.js" defer></script><% } %>
<% (typeof scripts !== 'undefined' ? scripts : []).forEach(function (name) { %>
  <script src="/js/<%= name %>.js" defer></script>
<% }) %>
<%# Page-specific ES modules (the 3D engine lives in public/js/3d). Modules always run after the page is parsed. %>
<% (typeof modules !== 'undefined' ? modules : []).forEach(function (name) { %>
  <script type="module" src="/js/<%= name %>.js"></script>
<% }) %>
</body>
</html>
