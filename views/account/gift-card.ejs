<%- include('../partials/account-start', { section: 'gift-card' }) %>
<header class="acct-head">
  <div>
    <span class="section-kicker">Gift card</span>
    <h1>Redeem a gift card</h1>
    <p class="muted">Enter the code from your gift card email. Its value goes into your wallet, and the wallet pays at checkout.</p>
  </div>
</header>
<section class="panel gift-redeem" aria-labelledby="gift-title">
  <h2 id="gift-title" class="panel-title">Your code</h2>
  <form class="form" data-gift-redeem novalidate>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <div class="float-field">
      <input id="gift-code" name="code" type="text" autocomplete="off" autocapitalize="characters" maxlength="20" required placeholder=" " aria-describedby="gift-code-error gift-code-hint">
      <label for="gift-code">Gift card code</label>
      <p class="hint" id="gift-code-hint">Twelve characters, for example ABCD-2345-WXYZ. Dashes and spaces do not matter.</p>
      <p class="field-error" id="gift-code-error" data-error-for="code"></p>
    </div>
    <button type="submit" class="btn btn-primary btn-lg" data-gift-button>Add to wallet</button>
  </form>
  <p class="muted">A code works once, and for one year from the day it was bought.</p>
</section>
<%- include('../partials/account-end', { scripts: ['gift-card'] }) %>
