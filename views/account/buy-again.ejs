<%- include('../partials/account-start', { section: 'buy-again' }) %>
<div class="acct-page-head">
  <span class="label-caps">Orders</span>
  <h1>Buy it again</h1>
  <p class="muted">Everything that has been delivered to you, at today's price.</p>
</div>
<% if (rows.length) { %>
  <div class="acct-grid" data-buy-again>
    <% rows.forEach(function (row, i) { const item = row.item; %>
      <article class="acct-buy-card">
        <a class="acct-buy-media" href="/products/<%= item.slug %>"><img src="<%= sizedUrl(item.image, 400) %>" alt="<%= item.name %>" width="240" height="240" loading="lazy" decoding="async"></a>
        <div class="acct-buy-body">
          <a class="acct-buy-name" href="/products/<%= item.slug %>"><%= item.name %></a>
          <small class="muted">Last bought <%= formatDate(row.lastBought) %><%= row.times > 1 ? ' · ' + row.times + ' bought' : '' %></small>
          <p class="acct-buy-price"><strong><%= formatPrice(item.price) %></strong><% if (item.discountPercent > 0) { %> <s><%= formatPrice(item.mrp) %></s> <em><%= item.discountPercent %>% off</em><% } %></p>
          <% if (item.available) { %>
            <button type="button" class="btn btn-primary btn-sm btn-block" data-quick-cart="<%= item.productId %>"><%- icon('cart', 'i-sm') %> Add to cart</button>
          <% } else { %>
            <span class="pill pill-red"><%= item.reason %></span>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
<% } else { %>
  <%- include('../partials/account-empty', { art: 'package-check', title: 'Nothing to buy again yet', text: 'Products from your delivered orders will appear here, ready to reorder in one tap.', href: '/products', cta: 'Find your gear' }) %>
<% } %>
<%- include('../partials/account-end') %>
