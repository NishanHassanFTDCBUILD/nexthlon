<%- include('../partials/account-start', { section: 'notifications' }) %>
<%
  const options = [
    { key: 'orderUpdates', title: 'Order updates', text: 'Shipped, out for delivery, delivered and tracking. Order confirmations, cancellations and refunds are always sent.', icon: 'truck' },
    { key: 'offers', title: 'Offers and coupons', text: 'Price drops, new coupons and sale alerts picked for you.', icon: 'tag' },
    { key: 'newsletter', title: 'Weekly newsletter', text: 'New arrivals, training tips and stories, once a week.', icon: 'mail' },
    { key: 'whatsapp', title: 'WhatsApp order updates', text: 'Order placed, shipped, out for delivery and delivered, on WhatsApp to the phone on your delivery address. Nothing else, ever.', icon: 'phone' }
  ];
%>
<div class="acct-page-head">
  <span class="label-caps">Account</span>
  <h1>Notifications</h1>
  <p class="muted">Choose what we send you. Changes save as soon as you flip a switch.</p>
</div>
<section class="panel acct-section" aria-label="Email preferences">
  <ul class="pref-list" data-prefs>
    <% options.forEach(function (o) { %>
      <li class="pref">
        <span class="pref-icon"><%- icon(o.icon) %></span>
        <label class="pref-text" for="pref-<%= o.key %>"><strong><%= o.title %></strong><small class="muted"><%= o.text %></small></label>
        <span class="switch-row">
          <input type="checkbox" class="switch-input" id="pref-<%= o.key %>" data-pref="<%= o.key %>" <%= prefs[o.key] ? 'checked' : '' %>>
          <span class="switch" aria-hidden="true"></span>
        </span>
      </li>
    <% }) %>
  </ul>
  <p class="muted acct-note">Account and security emails (like password changes) are always sent.</p>
</section>
<%# Push notifications on this device (E5): public/js/account.js asks the browser, then saves it. %>
<section class="panel acct-section" aria-labelledby="push-title" data-push-box hidden>
  <ul class="pref-list">
    <li class="pref">
      <span class="pref-icon"><%- icon('bell') %></span>
      <label class="pref-text" for="pref-push"><strong id="push-title">Notifications on this device</strong><small class="muted" data-push-note>Order updates and back-in-stock alerts, even when the store is closed.</small></label>
      <span class="switch-row">
        <input type="checkbox" class="switch-input" id="pref-push" data-push-toggle>
        <span class="switch" aria-hidden="true"></span>
      </span>
    </li>
  </ul>
</section>
<%- include('../partials/account-end') %>
