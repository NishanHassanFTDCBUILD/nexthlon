<%- include('../partials/head', { styles: ['account'] }) %>
<%- include('../partials/header') %>
<main id="main" class="container page">
  <div class="page-head">
    <div>
      <span class="section-kicker">A shared Nexthlon list</span>
      <h1><%= list.name %></h1>
      <p class="muted"><%= list.count %> <%= list.count === 1 ? 'item' : 'items' %> · read-only</p>
    </div>
  </div>
  <% if (list.items.length) { %>
    <div class="acct-products acct-products-wrap">
      <% list.items.forEach(function (p) { %>
        <a class="acct-product" href="/products/<%= p.slug %>">
          <span class="acct-product-media"><img src="<%= p.image %>" alt="<%= p.name %>" width="200" height="200" loading="lazy" decoding="async"></span>
          <span class="acct-product-name"><%= p.name %></span>
          <span class="acct-product-price"><strong><%= formatPrice(p.price) %></strong><% if (p.discountPercent > 0) { %> <em><%= p.discountPercent %>% off</em><% } %><% if (!p.available) { %> <small class="muted">Out of stock</small><% } %></span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state"><%- include('../partials/empty-art', { art: 'heart' }) %><h2>This list is empty</h2><p>Nothing has been added yet.</p><a class="btn btn-primary" href="/products">Browse gear</a></div>
  <% } %>
</main>
<%- include('../partials/footer') %>
