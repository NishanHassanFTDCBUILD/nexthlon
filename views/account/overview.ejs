<%- include('../partials/account-start', { section: 'overview' }) %>
<%
  const stepOf = { placed: 0, confirmed: 1, shipped: 2, out_for_delivery: 3, delivered: 4 };
  const tiles = [
    { key: 'orders', label: 'Orders', value: stats.orders, href: '/account/orders', icon: 'package-check', note: stats.openOrders ? stats.openOrders + ' on the way' : 'All caught up' },
    { key: 'wallet', label: 'Wallet balance', value: stats.wallet, money: true, href: '/account/wallet', icon: 'wallet', note: 'Use it at checkout' },
    { key: 'wishlist', label: 'Wishlist', value: stats.wishlist, href: '/account/lists', icon: 'heart', note: 'Saved for later' },
    { key: 'coupons', label: 'Active coupons', value: stats.coupons, href: '/account/coupons', icon: 'ticket', note: 'Ready to use' }
  ];
%>
<section class="acct-hello" aria-labelledby="acct-hello">
  <span class="avatar avatar-lg acct-hello-avatar" aria-hidden="true"><%= currentUser.name.charAt(0).toUpperCase() %></span>
  <div class="acct-hello-text">
    <h1 id="acct-hello">Hello, <%= firstName(currentUser.name) %></h1>
    <p class="muted">Member since <%= formatDate(currentUser.createdAt) %> · <span class="acct-badge"><%- icon('award', 'i-xs') %> Nexthlon <%= loyalty.name %></span><% if (loyalty.nextName) { %> <span class="muted">· <%= formatPrice(loyalty.toNextPaise) %> more in the last 12 months for <%= loyalty.nextName %></span><% } %></p>
  </div>
</section>

<section class="acct-stats" aria-label="Your account at a glance">
  <% tiles.forEach(function (t) { %>
    <a class="acct-tile" href="<%= t.href %>">
      <span class="acct-tile-icon"><%- icon(t.icon) %></span>
      <span class="acct-tile-text">
        <span class="acct-tile-value"><%= t.money ? formatPrice(t.value) : t.value %></span>
        <span class="acct-tile-label"><%= t.label %></span>
        <small class="acct-tile-note"><%= t.note %></small>
      </span>
    </a>
  <% }) %>
</section>

<section class="panel acct-section" aria-labelledby="last-order-title">
  <div class="acct-section-head">
    <h2 id="last-order-title">Your last order</h2>
    <a class="section-link" href="/account/orders">All orders <%- icon('chevron-right', 'i-sm') %></a>
  </div>
  <% if (lastOrder) { %>
    <% const step = stepOf[lastOrder.orderStatus]; %>
    <a class="acct-last-order" href="/orders/<%= lastOrder.orderId %>">
      <span class="acct-last-thumbs">
        <% lastOrder.items.slice(0, 3).forEach(function (item) { %><img src="<%= sizedUrl(item.image, 200) %>" alt="" width="64" height="64" loading="lazy"><% }) %>
      </span>
      <span class="acct-last-body">
        <strong><%= lastOrder.orderId %></strong>
        <small class="muted">Placed <%= formatDate(lastOrder.createdAt) %> · <%= lastOrder.items.length %> <%= lastOrder.items.length === 1 ? 'item' : 'items' %> · <%= formatPrice(lastOrder.total) %></small>
        <span class="status-pill status-<%= lastOrder.orderStatus %>"><span class="status-dot" aria-hidden="true"></span><%= labels[lastOrder.orderStatus] || lastOrder.orderStatus %></span>
      </span>
      <% if (step !== undefined) { %>
        <span class="acct-mini-track" aria-hidden="true" style="--step: <%= step %>">
          <% ['Placed', 'Confirmed', 'Shipped', 'Out', 'Delivered'].forEach(function (label, i) { %><span class="<%= i <= step ? 'is-done' : '' %>"><i></i><%= label %></span><% }) %>
        </span>
      <% } %>
    </a>
  <% } else { %>
    <%- include('../partials/account-empty', { art: 'box', title: 'No orders yet', text: 'Your first order will show up here with live tracking.', href: '/products', cta: 'Start shopping' }) %>
  <% } %>
</section>

<% if (recent.length) { %>
  <section class="panel acct-section" aria-labelledby="recent-title">
    <div class="acct-section-head">
      <h2 id="recent-title">Recently viewed</h2>
      <a class="section-link" href="/account/recent">See all <%- icon('chevron-right', 'i-sm') %></a>
    </div>
    <%- include('../partials/account-products', { products: recent }) %>
  </section>
<% } %>

<% if (recommended.length) { %>
  <section class="panel acct-section" aria-labelledby="picks-title">
    <div class="acct-section-head">
      <h2 id="picks-title">Picked for you</h2>
      <a class="section-link" href="/products">Browse all <%- icon('chevron-right', 'i-sm') %></a>
    </div>
    <%- include('../partials/account-products', { products: recommended }) %>
  </section>
<% } %>
<%- include('../partials/account-end') %>
