<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="container page">
  <div class="error-page">
    <span class="error-code" aria-hidden="true"><%= status %></span>
    <h1><%= status === 403 ? 'You do not have access to this page' : 'Something went wrong' %></h1>
    <p class="muted"><%= message %></p>
    <div class="error-actions">
      <a class="btn btn-primary" href="/"><%- icon('home', 'i-sm') %> Back to home</a>
      <% if (status === 403 && !currentUser) { %>
        <a class="btn btn-ghost" href="/login">Sign in</a>
      <% } else { %>
        <a class="btn btn-ghost" href="/products">Browse all gear</a>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
