<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="container page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <%- icon('chevron-right', 'i-xs') %>
    <a href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a> <%- icon('chevron-right', 'i-xs') %>
    <span><%= product.name %></span>
  </nav>

  <div class="pdp">
    <div class="gallery" data-gallery>
      <div class="gallery-main">
        <img src="<%= product.image %>" alt="<%= product.name %>" width="640" height="640" data-gallery-main>
        <% if (product.discountPercent > 0) { %><span class="tag tag-deal"><%= product.discountPercent %>% off</span><% } %>
      </div>
      <% if (product.gallery && product.gallery.length > 1) { %>
        <div class="gallery-thumbs">
          <% product.gallery.forEach(function (src, index) { %>
            <button type="button" class="thumb" data-src="<%= src %>" aria-label="Show photo <%= index + 1 %>" <%- index === 0 ? 'aria-current="true"' : '' %>>
              <img src="<%= src %>" alt="" width="80" height="80">
            </button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="pdp-info">
      <a class="pdp-brand" href="/products?q=<%= encodeURIComponent(product.brand) %>">Visit the <%= product.brand %> range</a>
      <h1><%= product.name %></h1>
      <span class="pill"><%= product.category %></span>

      <div class="pdp-price">
        <% if (product.discountPercent > 0) { %><span class="pdp-off">-<%= product.discountPercent %>%</span><% } %>
        <span class="price price-lg"><%= formatPrice(product.price) %></span>
      </div>
      <% if (product.mrp > product.price) { %>
        <p class="mrp">M.R.P. <s><%= formatPrice(product.mrp) %></s> Â· You save <%= formatPrice(product.mrp - product.price) %></p>
      <% } %>
      <%- include('../partials/stock', { stock: product.stock }) %>

      <% if (product.highlights && product.highlights.length) { %>
        <div class="pdp-section">
          <h2>About this item</h2>
          <ul class="highlights">
            <% product.highlights.forEach(function (line) { %><li><%= line %></li><% }) %>
          </ul>
        </div>
      <% } %>
    </div>

    <aside class="buy-box" aria-label="Ordering">
      <span class="price"><%= formatPrice(product.price) %></span>
      <%- include('../partials/stock', { stock: product.stock }) %>
      <div class="notice">
        <%- icon('truck') %>
        <p><strong>Online ordering opens soon.</strong> Cart and checkout arrive in the next Nexthlon update.</p>
      </div>
      <% if (!currentUser) { %>
        <p class="muted">Create an account and save your delivery address now, so checkout is quick later.</p>
        <a class="btn btn-primary btn-block" href="/signup?next=<%= encodeURIComponent('/products/' + product.slug) %>">Create your account</a>
        <a class="btn btn-ghost btn-block" href="/login?next=<%= encodeURIComponent('/products/' + product.slug) %>">Sign in</a>
      <% } else if (currentUser.role === 'customer') { %>
        <p class="muted">Your saved addresses will be ready at checkout.</p>
        <a class="btn btn-primary btn-block" href="/profile#addresses">Manage delivery addresses</a>
      <% } else { %>
        <p class="muted">You are signed in as an administrator.</p>
        <a class="btn btn-primary btn-block" href="/admin">Go to dashboard</a>
      <% } %>
      <ul class="buy-facts">
        <li><%- icon('award', 'i-sm') %> Sold by Nexthlon</li>
        <li><%- icon('shield', 'i-sm') %> Secure account sign-in</li>
      </ul>
    </aside>
  </div>

  <% const specEntries = Object.entries(product.specs || {}); %>
  <div class="pdp-details">
    <% if (product.description) { %>
      <section class="panel">
        <h2>Product description</h2>
        <p><%= product.description %></p>
      </section>
    <% } %>
    <% if (specEntries.length) { %>
      <section class="panel">
        <h2>Technical details</h2>
        <table class="spec-table">
          <tbody>
            <% specEntries.forEach(function ([key, value]) { %>
              <tr><th scope="row"><%= key %></th><td><%= value %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% } %>
  </div>

  <% if (related.length) { %>
    <section class="section">
      <div class="section-head">
        <h2>More <%= product.category %> gear</h2>
        <a href="/products?category=<%= encodeURIComponent(product.category) %>">See all <%- icon('chevron-right', 'i-sm') %></a>
      </div>
      <div class="product-grid">
        <% related.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
      </div>
    </section>
  <% } %>
</main>

<%- include('../partials/footer', { scripts: ['catalog'] }) %>
