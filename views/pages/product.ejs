<%- include('../partials/head', { styles: ['product'] }) %>
<%- include('../partials/header') %>

<%
  const photos = product.gallery && product.gallery.length > 1 ? product.gallery : [product.image];
  const saving = product.mrp > product.price ? product.mrp - product.price : 0;
  const cat = product.category || {};
  const maxQty = Math.min(product.stock, 5);
  const shopper = !currentUser || currentUser.role === 'customer';
  const backHere = encodeURIComponent('/products/' + product.slug);
  const specEntries = Object.entries(product.specs || {});
  const highlights = product.highlights || [];
  const freeDelivery = product.price >= store.freeDeliveryMin;
%>
<main id="main" class="pdx" data-recent-id="<%= product._id %>">
  <%# ===================== Hero: photo stage + story + buy panel ===================== %>
  <section class="pdx-hero container">
    <nav class="pdx-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/products">All gear</a><span aria-hidden="true">/</span>
      <a href="/products?category=<%= cat.slug %>"><%= cat.name %></a><span aria-hidden="true">/</span>
      <span aria-current="page"><%= product.name %></span>
    </nav>

    <div class="pdx-grid">
      <%# ---------- Photo stage (WebGL when available, plain photo otherwise) ---------- %>
      <div class="pdx-media" data-gallery>
        <div class="pdx-stage" data-stage>
          <img class="pdx-photo" src="<%= photos[0] %>" alt="<%= product.name %>" width="900" height="900" fetchpriority="high" data-gallery-main>
          <canvas class="pdx-canvas" aria-hidden="true" data-stage-canvas></canvas>
          <div class="pdx-stage-glow" aria-hidden="true"></div>

          <div class="pdx-stage-top">
            <% if (product.discountPercent > 0) { %><span class="pdx-chip pdx-chip-deal"><%= product.discountPercent %>% off</span><% } %>
            <button type="button" class="pdx-icon-btn" data-lightbox-open aria-label="View photos full screen"><%- icon('grid', 'i-sm') %></button>
          </div>

          <% if (photos.length > 1) { %>
            <div class="pdx-stage-nav">
              <button type="button" class="pdx-icon-btn" data-gallery-step="-1" aria-label="Previous photo"><%- icon('chevron-left', 'i-sm') %></button>
              <span class="pdx-count" aria-live="polite"><span data-gallery-index>1</span><span class="pdx-count-of">/ <%= photos.length %></span></span>
              <button type="button" class="pdx-icon-btn" data-gallery-step="1" aria-label="Next photo"><%- icon('chevron-right', 'i-sm') %></button>
            </div>
          <% } %>
          <span class="pdx-stage-hint" aria-hidden="true">Move to explore · Click to expand</span>
        </div>

        <% if (photos.length > 1) { %>
          <div class="pdx-thumbs" role="group" aria-label="Product photos">
            <% photos.forEach(function (src, index) { %>
              <button type="button" class="thumb pdx-thumb" data-src="<%= src %>" aria-label="Show photo <%= index + 1 %> of <%= photos.length %>" <%- index === 0 ? 'aria-current="true"' : '' %>>
                <img src="<%= src %>" alt="" width="96" height="96" loading="lazy">
              </button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <%# ---------- Story + buy panel ---------- %>
      <div class="pdx-info">
        <div class="pdx-head" data-pdx-in>
          <a class="pdx-brand" href="/products?brand=<%= encodeURIComponent(product.brand) %>"><span class="pdx-dot" aria-hidden="true"></span><%= product.brand %> <%- icon('arrow-right', 'i-xs') %></a>
          <h1 class="pdx-title" data-split><%= product.name %></h1>
          <div class="pdx-meta">
            <a class="pdx-chip" href="/products?category=<%= cat.slug %>"><%= cat.name %></a>
            <%- include('../partials/stock', { stock: product.stock }) %>
            <% if (product.ratingCount > 0) { %>
              <a class="pdx-rating" href="#reviews"><%- icon('star', 'i-xs') %> <strong><%= product.ratingAverage.toFixed(1) %></strong> <span class="muted">(<%= product.ratingCount %> <%= product.ratingCount === 1 ? 'review' : 'reviews' %>)</span><span class="sr-only">, rated out of 5</span></a>
            <% } %>
          </div>
        </div>

        <div class="pdx-buy" id="buy" data-pdx-in>
          <div class="pdx-price-row">
            <span class="pdx-price" data-price-count="<%= product.price %>"><%= formatPrice(product.price) %></span>
            <% if (saving) { %>
              <span class="pdx-mrp">M.R.P. <s><%= formatPrice(product.mrp) %></s></span>
            <% } %>
          </div>
          <% if (saving) { %>
            <div class="pdx-save">
              <span class="pdx-save-pill"><%- icon('tag', 'i-xs') %> You save <%= formatPrice(saving) %></span>
            </div>
          <% } %>
          <p class="pdx-tax">Inclusive of all taxes<% if (offer) { %> · <span class="pdx-offer"><%= offer.text %></span><% } %></p>

          <% if (product.stock <= 0) { %>
            <button class="pdx-btn pdx-btn-buy" type="button" disabled>Out of stock</button>
            <p class="pdx-note">This item is sold out right now. Check back soon.</p>
          <% } else if (!currentUser) { %>
            <%# Guests sign in first, then come straight back to this product. %>
            <div class="pdx-ctas">
              <a class="pdx-btn pdx-btn-cart" href="/login?next=<%= backHere %>" data-magnetic><%- icon('cart', 'i-sm') %> Add to cart</a>
              <a class="pdx-btn pdx-btn-buy" href="/login?next=<%= backHere %>" data-magnetic><%- icon('bolt', 'i-sm') %> Buy now</a>
            </div>
            <p class="pdx-note">Sign in to buy. New here? <a href="/signup?next=<%= backHere %>">Create an account</a>.</p>
          <% } else if (shopper) { %>
            <form class="pdx-order" data-add-to-cart data-product-id="<%= product._id %>" novalidate>
              <div class="pdx-qty-row">
                <label for="qty">Quantity</label>
                <div class="qty pdx-qty" data-qty>
                  <button type="button" class="qty-btn" data-qty-step="-1" aria-label="One less" disabled><%- icon('minus', 'i-sm') %></button>
                  <input id="qty" name="quantity" type="number" inputmode="numeric" min="1" max="<%= maxQty %>" step="1" value="1" data-qty-input>
                  <button type="button" class="qty-btn" data-qty-step="1" aria-label="One more" <%= maxQty <= 1 ? 'disabled' : '' %>><%- icon('plus', 'i-sm') %></button>
                </div>
                <span class="pdx-hint">Max <%= maxQty %></span>
              </div>
              <div class="pdx-ctas">
                <button class="pdx-btn pdx-btn-cart" type="submit" data-magnetic><%- icon('cart', 'i-sm') %> Add to cart</button>
                <button class="pdx-btn pdx-btn-buy" type="button" data-buy-now data-magnetic><%- icon('bolt', 'i-sm') %> Buy now</button>
              </div>
            </form>
            <a class="pdx-link" href="/cart">View cart <%- icon('arrow-right', 'i-xs') %></a>
          <% } %>

          <form class="pdx-pin" data-delivery-check novalidate>
            <label for="pincode"><%- icon('pin', 'i-xs') %> Deliver to</label>
            <div class="pdx-pin-row">
              <input id="pincode" name="pincode" inputmode="numeric" autocomplete="postal-code" maxlength="6" pattern="[1-9][0-9]{5}" placeholder="PIN code" aria-describedby="pincode-result">
              <button type="submit">Check</button>
            </div>
            <p class="delivery-result" id="pincode-result" data-delivery-result aria-live="polite">Enter your PIN code to see when it arrives.</p>
          </form>

          <div class="pdx-secondary">
            <% if (shopper) { %>
              <button type="button" class="wish-btn pdx-ghost" data-wish-id="<%= product._id %>" aria-pressed="false" hidden><%- icon('heart', 'i-sm') %> <span data-wish-label>Add to wishlist</span></button>
            <% } %>
            <button type="button" class="pdx-ghost" data-share data-share-title="<%= product.name %>"><%- icon('send', 'i-sm') %> Share</button>
          </div>

          <ul class="pdx-trust">
            <li><%- icon('truck', 'i-sm') %><span><% if (freeDelivery) { %>Free delivery<% } else { %>Free over <%= formatPrice(store.freeDeliveryMin) %><% } %></span></li>
            <li><%- icon('rotate-ccw', 'i-sm') %><span><a href="/refund-policy"><%= store.returnDays %>-day returns</a></span></li>
            <li><%- icon('shield', 'i-sm') %><span>Secure payment</span></li>
            <li><%- icon('award', 'i-sm') %><span>Sold by Nexthlon</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <%# ===================== Highlights ticker ===================== %>
  <% if (highlights.length) { %>
    <div class="pdx-marquee" aria-hidden="true">
      <div class="pdx-marquee-track">
        <% for (let pass = 0; pass < 2; pass++) { %>
          <% highlights.forEach(function (line) { %><span><%= line.split(' ').slice(0, 4).join(' ') %></span><i></i><% }) %>
        <% } %>
      </div>
    </div>
  <% } %>

  <%# ===================== Editorial details ===================== %>
  <% let blockNo = 0; const nextNo = () => String(++blockNo).padStart(2, '0'); %>
  <div class="container pdx-details">
    <% if (highlights.length) { %>
      <section class="pdx-block" data-reveal aria-labelledby="pdx-why">
        <header class="pdx-block-head"><span class="pdx-num"><%= nextNo() %></span><h2 id="pdx-why">Why it wins</h2></header>
        <ol class="pdx-features">
          <% highlights.forEach(function (line, i) { %>
            <li class="pdx-feature" data-tilt>
              <span class="pdx-feature-num"><%= String(i + 1).padStart(2, '0') %></span>
              <%- icon('check', 'i-sm') %>
              <p><%= line %></p>
            </li>
          <% }) %>
        </ol>
      </section>
    <% } %>

    <% if (product.description) { %>
      <section class="pdx-block" data-reveal aria-labelledby="pdx-story">
        <header class="pdx-block-head"><span class="pdx-num"><%= nextNo() %></span><h2 id="pdx-story">The story</h2></header>
        <p class="pdx-prose"><%= product.description %></p>
      </section>
    <% } %>

    <section class="pdx-block" data-reveal aria-labelledby="pdx-specs">
      <header class="pdx-block-head"><span class="pdx-num"><%= nextNo() %></span><h2 id="pdx-specs">Specifications</h2></header>
      <dl class="pdx-specs">
        <div><dt>Brand</dt><dd><%= product.brand %></dd></div>
        <div><dt>Category</dt><dd><%= cat.name %></dd></div>
        <% specEntries.forEach(function ([key, value]) { %>
          <div><dt><%= key %></dt><dd><%= value %></dd></div>
        <% }) %>
      </dl>
    </section>

    <section class="pdx-block" data-reveal aria-labelledby="pdx-ship">
      <header class="pdx-block-head"><span class="pdx-num"><%= nextNo() %></span><h2 id="pdx-ship">Delivery &amp; returns</h2></header>
      <ul class="pdx-ship">
        <li><%- icon('package-check') %><strong>Dispatched in <%= store.dispatchDays %></strong><span>Delivered in <%= store.deliveryDays %> to most PIN codes.</span></li>
        <li><%- icon('truck') %><strong>Free over <%= formatPrice(store.freeDeliveryMin) %></strong><span>Smaller orders pay <%= formatPrice(store.deliveryFee) %>. <a href="/shipping-policy">Shipping policy</a></span></li>
        <li><%- icon('rotate-ccw') %><strong><%= store.returnDays %>-day returns</strong><span>Unused, in original packaging. <a href="/refund-policy">Refund policy</a></span></li>
      </ul>
    </section>

    <%# ---------- Reviews: any signed-in customer can write one ---------- %>
    <%
      const total = reviews.pagination.total;
      const maxBar = Math.max(1, ...reviews.breakdown.map(function (row) { return row.count; }));
      const fmtDate = function (d) { return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }); };
    %>
    <section class="pdx-block pdx-reviews" id="reviews" data-reveal aria-labelledby="pdx-reviews-title"
      data-reviews data-product-id="<%= product._id %>" data-page="1" data-pages="<%= reviews.pagination.pages %>">
      <header class="pdx-block-head">
        <span class="pdx-num"><%= nextNo() %></span>
        <h2 id="pdx-reviews-title">Reviews</h2>
        <div class="pdx-score">
          <span class="pdx-score-num" data-review-average><%= total ? product.ratingAverage.toFixed(1) : '–' %></span>
          <div>
            <span class="rating" style="--rating: <%= product.ratingAverage || 0 %>; --star-size: 18px" data-review-stars aria-hidden="true"></span>
            <p class="pdx-score-count" data-review-count><%= total %> <%= total === 1 ? 'review' : 'reviews' %></p>
          </div>
        </div>
        <ul class="pdx-bars" aria-label="Ratings breakdown" data-review-bars>
          <% reviews.breakdown.forEach(function (row) { %>
            <li data-stars="<%= row.stars %>">
              <span><%= row.stars %> <%- icon('star', 'i-xs') %></span>
              <span class="pdx-bar"><i style="width: <%= Math.round(row.count / maxBar * 100) %>%"></i></span>
              <span class="pdx-bar-n"><%= row.count %></span>
            </li>
          <% }) %>
        </ul>
      </header>

      <div class="pdx-reviews-body">
        <% if (reviewStatus.canReview) { %>
          <form class="pdx-review-form" data-review-form novalidate>
            <h3>Write a review</h3>
            <fieldset class="pdx-star-pick">
              <legend>Your rating</legend>
              <div class="pdx-star-row" data-star-pick>
                <% for (let n = 5; n >= 1; n--) { %>
                  <input type="radio" id="rate-<%= n %>" name="rating" value="<%= n %>">
                  <label for="rate-<%= n %>" title="<%= n %> star<%= n > 1 ? 's' : '' %>"><%- icon('star') %><span class="sr-only"><%= n %> star<%= n > 1 ? 's' : '' %></span></label>
                <% } %>
              </div>
              <span class="pdx-star-word" data-star-word aria-live="polite">Tap a star</span>
            </fieldset>
            <label class="pdx-field">
              <span>Title <em>(optional)</em></span>
              <input name="title" maxlength="80" placeholder="Sum it up in a few words">
            </label>
            <label class="pdx-field">
              <span>Your review</span>
              <textarea name="body" rows="4" minlength="10" maxlength="1000" placeholder="What did you like or not? How did it hold up?" data-review-body></textarea>
              <small class="pdx-field-count"><span data-review-chars>0</span> / 1000</small>
            </label>
            <p class="pdx-form-error" data-review-error role="alert" hidden></p>
            <div class="pdx-form-foot">
              <% if (reviewStatus.verified) { %><span class="pdx-verified"><%- icon('check', 'i-xs') %> You bought this: your review shows as a verified purchase</span><% } else { %><span class="pdx-form-note">Posting as <%= currentUser.name %></span><% } %>
              <button type="submit" class="pdx-btn pdx-btn-buy pdx-btn-sm">Post review</button>
            </div>
          </form>
        <% } else if (reviewStatus.reason === 'reviewed') { %>
          <div class="pdx-review-note"><%- icon('check', 'i-sm') %><span>You've reviewed this product. <a href="/account/reviews">Edit or delete it in My Account</a>.</span></div>
        <% } else if (reviewStatus.reason === 'signin') { %>
          <div class="pdx-review-note"><%- icon('edit', 'i-sm') %><span>Own this or tried it? <a href="/login?next=<%= encodeURIComponent('/products/' + product.slug + '#reviews') %>">Sign in to write a review</a>.</span></div>
        <% } %>

        <ol class="pdx-review-list" data-review-list>
          <% reviews.reviews.forEach(function (review) { %>
            <li class="pdx-review">
              <div class="pdx-review-top">
                <span class="pdx-avatar" aria-hidden="true"><%= (review.author || '?').charAt(0).toUpperCase() %></span>
                <div class="pdx-review-who">
                  <strong><%= review.author %></strong>
                  <span><%= fmtDate(review.createdAt) %><% if (review.verified) { %> · <span class="pdx-verified"><%- icon('check', 'i-xs') %> Verified purchase</span><% } %></span>
                </div>
                <span class="rating" style="--rating: <%= review.rating %>" role="img" aria-label="<%= review.rating %> out of 5 stars"></span>
              </div>
              <% if (review.title) { %><h3 class="pdx-review-title"><%= review.title %></h3><% } %>
              <p class="pdx-review-body"><%= review.body %></p>
            </li>
          <% }) %>
        </ol>
        <p class="pdx-review-empty" data-review-empty <%= total ? 'hidden' : '' %>>No reviews yet. Be the first to share how it performs.</p>
        <button type="button" class="pdx-ghost pdx-more" data-review-more <%= reviews.pagination.pages > 1 ? '' : 'hidden' %>>Show more reviews</button>
      </div>
    </section>
  </div>

  <% if (related.length) { %>
    <section class="section container" aria-labelledby="related-title">
      <div class="section-head" data-reveal>
        <div>
          <span class="section-kicker">You may also like</span>
          <h2 id="related-title">More <%= cat.name %> gear</h2>
        </div>
        <a class="section-link" href="/products?category=<%= cat.slug %>">See all <%- icon('chevron-right', 'i-sm') %></a>
      </div>
      <%- include('../partials/rail', { products: related, label: 'Related products' }) %>
    </section>
  <% } %>

  <%# ===================== Sticky buy bar (appears once the main buttons scroll away) ===================== %>
  <% if (product.stock > 0 && shopper) { %>
    <div class="pdx-dock" data-dock aria-hidden="true">
      <img src="<%= photos[0] %>" alt="" width="48" height="48">
      <div class="pdx-dock-text">
        <strong><%= product.name %></strong>
        <span><%= formatPrice(product.price) %><% if (saving) { %> <s><%= formatPrice(product.mrp) %></s><% } %></span>
      </div>
      <% if (currentUser) { %>
        <button type="button" class="pdx-btn pdx-btn-cart" data-dock-cart tabindex="-1"><%- icon('cart', 'i-sm') %><span>Add</span></button>
        <button type="button" class="pdx-btn pdx-btn-buy" data-buy-now tabindex="-1"><%- icon('bolt', 'i-sm') %><span>Buy now</span></button>
      <% } else { %>
        <a class="pdx-btn pdx-btn-buy" href="/login?next=<%= backHere %>" tabindex="-1"><%- icon('bolt', 'i-sm') %><span>Buy now</span></a>
      <% } %>
    </div>
  <% } %>
</main>

<dialog class="lightbox" id="lightbox" aria-label="Photos of <%= product.name %>" data-lightbox data-photos="<%= JSON.stringify(photos) %>">
  <div class="lightbox-bar">
    <span class="lightbox-count" aria-live="polite"><span data-lightbox-index>1</span> / <%= photos.length %></span>
    <button type="button" class="icon-btn lightbox-close" data-lightbox-close><%- icon('x') %><span class="sr-only">Close full screen photos</span></button>
  </div>
  <div class="lightbox-stage">
    <img src="<%= photos[0] %>" alt="<%= product.name %>" data-lightbox-img>
    <% if (photos.length > 1) { %>
      <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-step="-1" aria-label="Previous photo"><%- icon('chevron-left') %></button>
      <button type="button" class="lightbox-nav lightbox-next" data-lightbox-step="1" aria-label="Next photo"><%- icon('chevron-right') %></button>
    <% } %>
  </div>
</dialog>

<%- include('../partials/footer', { scripts: ['catalog', 'product', 'cart'], modules: ['product-stage'] }) %>
