<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  const photos = product.gallery && product.gallery.length > 1 ? product.gallery : [product.image];
  const saving = product.mrp > product.price ? product.mrp - product.price : 0;
%>
<main id="main" class="container page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <%- icon('chevron-right', 'i-xs') %>
    <a href="/products">All gear</a> <%- icon('chevron-right', 'i-xs') %>
    <a href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a> <%- icon('chevron-right', 'i-xs') %>
    <span aria-current="page"><%= product.name %></span>
  </nav>

  <div class="pdp" data-recent-id="<%= product._id %>">
    <div class="gallery <%= photos.length > 1 ? 'has-thumbs' : '' %>" data-gallery>
      <div class="gallery-main" data-zoom>
        <img src="<%= photos[0] %>" alt="<%= product.name %>" width="640" height="640" fetchpriority="high" data-gallery-main>
        <span class="zoom-hint" aria-hidden="true"><%- icon('search', 'i-xs') %> Hover to zoom</span>
        <% if (product.discountPercent > 0) { %><span class="tag tag-deal"><%= product.discountPercent %>% off</span><% } %>
        <% if (photos.length > 1) { %>
          <button type="button" class="gallery-nav gallery-prev" data-gallery-step="-1" aria-label="Previous photo"><%- icon('chevron-left') %></button>
          <button type="button" class="gallery-nav gallery-next" data-gallery-step="1" aria-label="Next photo"><%- icon('chevron-right') %></button>
          <span class="gallery-count" aria-live="polite"><span data-gallery-index>1</span> / <%= photos.length %></span>
        <% } %>
      </div>
      <% if (photos.length > 1) { %>
        <div class="gallery-thumbs" role="group" aria-label="Product photos">
          <% photos.forEach(function (src, index) { %>
            <button type="button" class="thumb" data-src="<%= src %>" aria-label="Show photo <%= index + 1 %> of <%= photos.length %>" <%- index === 0 ? 'aria-current="true"' : '' %>>
              <img src="<%= src %>" alt="" width="80" height="80" loading="lazy">
            </button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="pdp-info">
      <a class="pdp-brand" href="/products?q=<%= encodeURIComponent(product.brand) %>">Visit the <%= product.brand %> range <%- icon('chevron-right', 'i-xs') %></a>
      <h1><%= product.name %></h1>
      <div class="pdp-tags">
        <a class="pill" href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a>
        <%- include('../partials/stock', { stock: product.stock }) %>
      </div>

      <div class="price-panel">
        <% if (product.discountPercent > 0) { %><span class="deal-badge"><%- icon('tag', 'i-xs') %> Deal</span><% } %>
        <div class="pdp-price">
          <% if (product.discountPercent > 0) { %><span class="pdp-off">-<%= product.discountPercent %>%</span><% } %>
          <span class="price price-lg"><%= formatPrice(product.price) %></span>
        </div>
        <% if (saving) { %>
          <p class="mrp">M.R.P.: <s><%= formatPrice(product.mrp) %></s></p>
          <p class="saving saving-lg">You save <%= formatPrice(saving) %><% if (product.discountPercent > 0) { %> (<%= product.discountPercent %>%)<% } %></p>
        <% } %>
      </div>

      <% if (product.highlights && product.highlights.length) { %>
        <div class="pdp-section">
          <h2>About this item</h2>
          <ul class="highlights">
            <% product.highlights.forEach(function (line) { %><li><%- icon('check', 'i-sm') %><span><%= line %></span></li><% }) %>
          </ul>
        </div>
      <% } %>
    </div>

    <aside class="buy-box" aria-label="Ordering">
      <div class="buy-price">
        <span class="price"><%= formatPrice(product.price) %></span>
        <% if (saving) { %><span class="mrp">M.R.P. <s><%= formatPrice(product.mrp) %></s></span><% } %>
      </div>
      <%- include('../partials/stock', { stock: product.stock }) %>
      <% const maxQty = Math.min(product.stock, 5); %>
      <% if (product.stock <= 0) { %>
        <button class="btn btn-primary btn-block" type="button" disabled><%- icon('cart', 'i-sm') %> Out of stock</button>
        <p class="muted">This item is sold out right now. Check back soon.</p>
      <% } else if (!currentUser) { %>
        <%# Guests are sent to sign in, then straight back to this product. %>
        <a class="btn btn-primary btn-block" href="/login?next=<%= encodeURIComponent('/products/' + product.slug) %>"><%- icon('cart', 'i-sm') %> Add to cart</a>
        <p class="muted">Sign in to add items to your cart. New here? <a href="/signup?next=<%= encodeURIComponent('/products/' + product.slug) %>">Create an account</a>.</p>
        <button type="button" class="wish-btn wish-btn-inline" data-wish-id="<%= product._id %>" aria-pressed="false" hidden><%- icon('heart', 'i-sm') %> <span data-wish-label>Add to wishlist</span></button>
      <% } else if (currentUser.role === 'customer') { %>
        <form class="add-to-cart" data-add-to-cart data-product-id="<%= product._id %>" novalidate>
          <div class="qty-row">
            <label for="qty">Quantity</label>
            <div class="qty" data-qty>
              <button type="button" class="qty-btn" data-qty-step="-1" aria-label="One less" disabled><%- icon('minus', 'i-sm') %></button>
              <input id="qty" name="quantity" type="number" inputmode="numeric" min="1" max="<%= maxQty %>" step="1" value="1" data-qty-input>
              <button type="button" class="qty-btn" data-qty-step="1" aria-label="One more" <%= maxQty <= 1 ? 'disabled' : '' %>><%- icon('plus', 'i-sm') %></button>
            </div>
          </div>
          <p class="hint">Up to <%= maxQty %> per order.</p>
          <button class="btn btn-primary btn-block btn-lg" type="submit"><%- icon('cart', 'i-sm') %> Add to cart</button>
        </form>
        <a class="btn btn-ghost btn-block" href="/cart">View cart</a>
        <button type="button" class="wish-btn wish-btn-inline" data-wish-id="<%= product._id %>" aria-pressed="false" hidden><%- icon('heart', 'i-sm') %> <span data-wish-label>Add to wishlist</span></button>
      <% } else { %>
        <p class="muted">You are signed in as an administrator.</p>
        <a class="btn btn-primary btn-block" href="/admin">Go to dashboard</a>
      <% } %>
      <ul class="buy-facts">
        <li><%- icon('truck', 'i-sm') %> <% if (product.price >= store.freeDeliveryMin) { %>Free delivery<% } else { %>Delivery <%= formatPrice(store.deliveryFee) %>, free over <%= formatPrice(store.freeDeliveryMin) %><% } %></li>
        <li><%- icon('rotate-ccw', 'i-sm') %> <a href="/refund-policy"><%= store.returnDays %>-day easy returns</a></li>
        <li><%- icon('shield', 'i-sm') %> Secure payment</li>
        <li><%- icon('award', 'i-sm') %> Sold by Nexthlon</li>
      </ul>
    </aside>
  </div>

  <% const specEntries = Object.entries(product.specs || {}); %>
  <section class="pdp-details section-box" data-tabs data-reveal aria-label="Product details">
    <div class="tabs-list" role="tablist" aria-label="Product details">
      <% if (product.description) { %><button type="button" class="tab" role="tab" id="tab-desc" aria-controls="panel-desc">Description</button><% } %>
      <% if (specEntries.length) { %><button type="button" class="tab" role="tab" id="tab-spec" aria-controls="panel-spec">Technical details</button><% } %>
      <button type="button" class="tab" role="tab" id="tab-ship" aria-controls="panel-ship">Delivery and returns</button>
    </div>
    <% if (product.description) { %>
      <div class="tab-panel" role="tabpanel" id="panel-desc" aria-labelledby="tab-desc" tabindex="0">
        <h2 class="panel-title">Product description</h2>
        <p class="prose"><%= product.description %></p>
      </div>
    <% } %>
    <% if (specEntries.length) { %>
      <div class="tab-panel" role="tabpanel" id="panel-spec" aria-labelledby="tab-spec" tabindex="0">
        <h2 class="panel-title">Technical details</h2>
        <div class="spec-wrap">
          <table class="spec-table">
            <caption class="sr-only">Technical details for <%= product.name %></caption>
            <tbody>
              <% specEntries.forEach(function ([key, value]) { %>
                <tr><th scope="row"><%= key %></th><td><%= value %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
    <div class="tab-panel" role="tabpanel" id="panel-ship" aria-labelledby="tab-ship" tabindex="0">
      <h2 class="panel-title">Delivery and returns</h2>
      <ul class="ship-facts">
        <li><%- icon('package-check') %><span><strong>Dispatched in <%= store.dispatchDays %></strong> Delivered in <%= store.deliveryDays %> to most PIN codes.</span></li>
        <li><%- icon('truck') %><span><strong>Free delivery over <%= formatPrice(store.freeDeliveryMin) %></strong> Smaller orders pay <%= formatPrice(store.deliveryFee) %>. <a href="/shipping-policy">Shipping policy</a></span></li>
        <li><%- icon('rotate-ccw') %><span><strong><%= store.returnDays %>-day returns</strong> Unused items in their original packaging. <a href="/refund-policy">Refund policy</a></span></li>
      </ul>
    </div>
  </section>

  <% if (related.length) { %>
    <section class="section" aria-labelledby="related-title">
      <div class="section-head" data-reveal>
        <div>
          <span class="section-kicker">You may also like</span>
          <h2 id="related-title">More <%= product.category %> gear</h2>
        </div>
        <a class="section-link" href="/products?category=<%= encodeURIComponent(product.category) %>">See all <%- icon('chevron-right', 'i-sm') %></a>
      </div>
      <div class="product-grid">
        <% related.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
      </div>
    </section>
  <% } %>
</main>

<%- include('../partials/footer', { scripts: ['catalog', 'cart'] }) %>
