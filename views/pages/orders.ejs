
<%
  const tabs = [['all', 'All orders'], ['active', 'On the way'], ['delivered', 'Delivered'], ['cancelled', 'Cancelled'], ['returns', 'Returns']];
  const periods = [['all', 'Any time'], ['30d', 'Last 30 days'], ['3m', 'Last 3 months'], ['1y', 'Last year']];
  const pillFor = function (status) {
    if (status === 'delivered') return 'pill-green';
    if (status === 'cancelled' || status === 'returned') return 'pill-red';
    if (status === 'return_requested') return 'pill-amber';
    return 'pill-blue';
  };
  const filtered = filters.status !== 'all' || filters.period !== 'all' || filters.q;
%>
<%- include('../partials/account-start', { section: 'orders' }) %>
<div class="acct-orders">
  <div class="page-head">
    <div>
      <h1>Your orders</h1>
      <p class="muted"><%= pagination.total %> <%= pagination.total === 1 ? 'order' : 'orders' %><%= filtered ? ' match your filters' : '' %></p>
    </div>
  </div>

  <div class="orders-toolbar">
    <nav class="segmented" aria-label="Order status">
      <% tabs.forEach(function ([key, label]) { %>
        <a href="<%= link({ status: key === 'all' ? '' : key, page: '' }) %>" class="<%= filters.status === key ? 'is-active' : '' %>" <%- filters.status === key ? 'aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
    </nav>
    <form class="orders-search" action="/orders" method="get" role="search" aria-label="Search your orders" data-orders-filter>
      <% if (filters.status !== 'all') { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
      <span class="select-wrap">
        <label class="sr-only" for="order-period">Time</label>
        <select id="order-period" name="period">
          <% periods.forEach(function ([key, label]) { %><option value="<%= key %>" <%= filters.period === key ? 'selected' : '' %>><%= label %></option><% }) %>
        </select>
        <%- icon('chevron-down', 'i-xs') %>
      </span>
      <div class="toolbar-search">
        <%- icon('search', 'i-sm') %>
        <label class="sr-only" for="order-q">Search by order number or product</label>
        <input id="order-q" type="search" name="q" maxlength="60" value="<%= filters.q %>" placeholder="Order number or product">
        <button class="btn btn-secondary btn-sm" type="submit">Search</button>
      </div>
    </form>
  </div>

  <% if (orders.length) { %>
    <ul class="order-list">
      <% orders.forEach(function (order) { %>
        <li class="order-card">
          <div class="order-card-head">
            <div><span class="muted">Order</span><strong><%= order.orderId %></strong></div>
            <div><span class="muted">Placed</span><strong><%= formatDate(order.createdAt) %></strong></div>
            <div><span class="muted">Total</span><strong><%= formatPrice(order.total) %></strong></div>
            <span class="order-card-pills">
              <% if (order.orderStatus !== 'cancelled' || ['paid', 'refunded', 'partially_refunded'].includes(order.paymentStatus)) { %>
                <%- include('../partials/pay-status', { status: order.paymentStatus, method: order.paymentMethod }) %>
              <% } %>
              <span class="pill <%= pillFor(order.orderStatus) %>"><%= labels[order.orderStatus] %></span>
            </span>
          </div>
          <div class="order-card-body">
            <ul class="order-thumbs">
              <% order.items.slice(0, 4).forEach(function (item) { %>
                <li class="<%= item.status === 'cancelled' ? 'is-cancelled' : '' %>"><img src="<%= sizedUrl(item.image, 200) %>" alt="" width="56" height="56" loading="lazy"><span><%= item.name %><% if (item.option) { %><span class="muted"> · <%= item.option %></span><% } %><span class="muted"> × <%= item.quantity %></span></span></li>
              <% }) %>
              <% if (order.items.length > 4) { %><li class="muted">+<%= order.items.length - 4 %> more</li><% } %>
            </ul>
            <a class="btn btn-ghost btn-sm" href="/orders/<%= order.orderId %>">View details <%- icon('chevron-right', 'i-xs') %></a>
          </div>
        </li>
      <% }) %>
    </ul>
    <%- include('../partials/pagination') %>
  <% } else { %>
    <div class="empty-state">
      <%- include('../partials/empty-art', { art: 'package-check' }) %>
      <% if (filtered) { %>
        <h2>No orders match those filters</h2>
        <p>Try a different time range or search.</p>
        <a class="btn btn-primary" href="/orders">Show all orders</a>
      <% } else { %>
        <h2>No orders yet</h2>
        <p>When you place an order, you can track it here.</p>
        <a class="btn btn-primary" href="/products">Start shopping</a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/account-end') %>
