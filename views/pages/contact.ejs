<%- include('../partials/info-start', { heading: 'Contact us', lead: 'Questions about an order, a product or your account? We reply within one working day.', scripts: ['contact'] }) %>
<% const me = currentUser || {}; %>
<div class="contact-layout">
  <section class="section-box contact-form-box" aria-labelledby="contact-form-title">
    <h2 id="contact-form-title" class="panel-title">Send us a message</h2>
    <form class="form contact-form" data-contact-form novalidate>
      <div class="form-alert" data-form-alert aria-live="assertive"></div>
      <div class="form-grid">
        <div class="float-field">
          <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="60" placeholder=" " value="<%= me.name || '' %>" aria-describedby="c-name-error">
          <label for="c-name">Your name</label>
          <p class="field-error" id="c-name-error" data-error-for="name"></p>
        </div>
        <div class="float-field">
          <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder=" " value="<%= me.email || '' %>" aria-describedby="c-email-error">
          <label for="c-email">Email address</label>
          <p class="field-error" id="c-email-error" data-error-for="email"></p>
        </div>
        <div class="float-field">
          <input id="c-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder=" " value="<%= me.phone || '' %>" aria-describedby="c-phone-error c-phone-hint">
          <label for="c-phone">Mobile number (optional)</label>
          <p class="hint" id="c-phone-hint">10 digits, so we can call you back if that is quicker.</p>
          <p class="field-error" id="c-phone-error" data-error-for="phone"></p>
        </div>
        <div class="float-field">
          <select id="c-topic" name="topic" required aria-describedby="c-topic-error">
            <option value="">Choose a topic</option>
            <% topics.forEach(function (topic) { %><option value="<%= topic %>"><%= topic %></option><% }) %>
          </select>
          <label for="c-topic">What is it about?</label>
          <%- icon('chevron-down', 'i-sm select-caret') %>
          <p class="field-error" id="c-topic-error" data-error-for="topic"></p>
        </div>
        <div class="float-field field-wide">
          <textarea id="c-message" name="message" required minlength="10" maxlength="2000" rows="6" placeholder=" " aria-describedby="c-message-error c-message-count"></textarea>
          <label for="c-message">Your message</label>
          <p class="hint" id="c-message-count" data-char-count="2000" aria-live="polite">0 of 2000 characters</p>
          <p class="field-error" id="c-message-error" data-error-for="message"></p>
        </div>
        <%# A trap for spam bots: people never see or reach this field. %>
        <div class="trap" aria-hidden="true">
          <label for="c-website">Leave this empty</label>
          <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary btn-lg" type="submit"><%- icon('send', 'i-sm') %> Send message</button>
      </div>
    </form>
    <div class="contact-done" data-contact-done hidden tabindex="-1">
      <%- include('../partials/empty-art', { art: 'check' }) %>
      <h2>Message sent</h2>
      <p data-contact-done-text>Thanks! We reply within one working day.</p>
      <button type="button" class="btn btn-ghost" data-contact-again>Send another message</button>
    </div>
  </section>

  <aside class="contact-side">
    <div class="section-box contact-card">
      <h2 class="panel-title">Other ways to reach us</h2>
      <ul class="contact-list">
        <li><span class="trust-icon"><%- icon('mail') %></span><span><strong>Email</strong><%= store.supportEmail %></span></li>
        <li><span class="trust-icon"><%- icon('phone') %></span><span><strong>Phone</strong><%= store.supportPhone %></span></li>
        <li><span class="trust-icon"><%- icon('clock') %></span><span><strong>Hours</strong><%= store.supportHours %></span></li>
        <li><span class="trust-icon"><%- icon('pin') %></span><span><strong>Registered office</strong><%= store.legalName %>, <%= store.address %></span></li>
      </ul>
    </div>
  </aside>
</div>

<section class="section" id="faq" aria-labelledby="faq-title">
  <h2 id="faq-title" class="info-subtitle">Frequently asked questions</h2>
  <div class="accordion">
    <details>
      <summary>How long does delivery take? <%- icon('chevron-down', 'i-sm') %></summary>
      <div class="accordion-body">Orders are dispatched in <%= store.dispatchDays %> and usually delivered in <%= store.deliveryDays %>. See our <a href="/shipping-policy">shipping policy</a>.</div>
    </details>
    <details>
      <summary>Is delivery free? <%- icon('chevron-down', 'i-sm') %></summary>
      <div class="accordion-body">Yes, on orders of <%= formatPrice(store.freeDeliveryMin) %> or more. Smaller orders pay <%= formatPrice(store.deliveryFee) %>.</div>
    </details>
    <details>
      <summary>How do I return something? <%- icon('chevron-down', 'i-sm') %></summary>
      <div class="accordion-body">Ask for a return within <%= store.returnDays %> days of delivery. Items must be unused and in their original packaging. See our <a href="/refund-policy">refund policy</a>.</div>
    </details>
    <details>
      <summary>When will I get my refund? <%- icon('chevron-down', 'i-sm') %></summary>
      <div class="accordion-body">Refunds reach your original payment method in <%= store.refundDays %> after we receive the item.</div>
    </details>
    <details>
      <summary>Is it safe to pay on Nexthlon? <%- icon('chevron-down', 'i-sm') %></summary>
      <div class="accordion-body">Yes. Payments are handled by a secure payment partner. We never see or store your card number or UPI PIN.</div>
    </details>
  </div>
</section>
<%- include('../partials/info-end', { scripts: ['contact'] }) %>
