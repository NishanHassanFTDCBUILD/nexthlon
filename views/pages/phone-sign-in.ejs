<%# Sign in with a code sent to your phone. Works for accounts that have a mobile number. Script: public/js/phone-sign-in.js %>
<%- include('../partials/info-start', { heading: 'Sign in with your phone', lead: 'No password needed. We text a 6-digit code to the mobile number on your account.' }) %>
<section class="section-box phone-sign-in">
  <form class="form" data-phone-request novalidate>
    <div class="form-alert" data-form-alert aria-live="assertive"></div>
    <div class="float-field">
      <input id="ps-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="16" required placeholder=" " aria-describedby="ps-phone-error">
      <label for="ps-phone">Mobile number</label>
      <p class="field-error" id="ps-phone-error" data-error-for="phone"></p>
    </div>
    <button type="submit" class="btn btn-primary btn-lg" data-request-button>Send me a code</button>
  </form>

  <form class="form" data-phone-verify novalidate hidden>
    <p class="muted" data-code-status aria-live="polite"></p>
    <div class="float-field">
      <input id="ps-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required placeholder=" " aria-describedby="ps-code-error">
      <label for="ps-code">6-digit code</label>
      <p class="field-error" id="ps-code-error" data-error-for="code"></p>
    </div>
    <button type="submit" class="btn btn-primary btn-lg" data-verify-button>Sign in</button>
    <p><button type="button" class="link-btn" data-change-number>Use a different number</button></p>
  </form>

  <p class="muted">Signed up with an email instead? <a href="/login">Sign in with your email</a>.</p>
</section>
<%- include('../partials/info-end', { scripts: ['phone-sign-in'] }) %>
