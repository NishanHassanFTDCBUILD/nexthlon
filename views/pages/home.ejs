<%- include('../partials/head', { coreStyles: ['home'] }) %>
<%- include('../partials/header') %>

<%
  const left = Math.max(0, new Date(dealEndsAt).getTime() - Date.now());
  const pad = function (n) { return String(n).padStart(2, '0'); };
  const hh = pad(Math.floor(left / 3600000));
  const mm = pad(Math.floor(left / 60000) % 60);
  const ss = pad(Math.floor(left / 1000) % 60);
  const shopper = !currentUser || currentUser.role === 'customer';
%>
<%
  const star = deals[0] || bestSellers[0] || newest[0];
  const productCount = categories.reduce(function (sum, c) { return sum + c.count; }, 0);
  const headline = ['Built', 'for', 'every', 'athlete'];
  let letterIndex = 0;
%>
<main id="main" class="home">
  <%# ---------- 1. Hero: a WebGL particle sphere that becomes the logo, then an athlete, as you scroll ---------- %>
  <section class="hero3d" data-hero3d aria-labelledby="hero-title" data-stage="0">
    <div class="hero3d-sticky">
      <canvas class="hero3d-canvas" data-hero3d-canvas aria-hidden="true"></canvas>
      <div class="hero3d-fallback" aria-hidden="true">
        <span class="hf-orb"></span>
        <span class="hf-ring hf-ring-1"></span><span class="hf-ring hf-ring-2"></span><span class="hf-ring hf-ring-3"></span>
        <% featured.slice(0, 3).forEach(function (p, i) { %>
          <img class="hf-card hf-card-<%= i + 1 %>" src="<%= sizedUrl(p.image, 400) %>" alt="" width="160" height="160" <%- i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
        <% }) %>
      </div>
      <div class="container hero3d-content">
        <span class="hero3d-kicker"><%- icon('bolt', 'i-sm') %> Nexthlon performance gear</span>
        <%# The letters are separate spans for the reveal, which some screen readers spell out one by one.
             So the heading is named with the plain words, and the letters are hidden from them. %>
        <h1 id="hero-title" class="hero3d-title" data-split aria-label="<%= headline.join(' ') %>">
          <% headline.forEach(function (word, w) { %><span class="word" aria-hidden="true"><% word.split('').forEach(function (ch) { %><span class="char" style="--i: <%= letterIndex++ %>"><%= ch %></span><% }) %></span><%= w < headline.length - 1 ? ' ' : '' %><% }) %>
        </h1>
        <p class="hero3d-text">Shoes, balls, rackets and outdoor kit chosen by athletes, delivered across India. Scroll to see the gear come together.</p>
        <div class="hero3d-actions">
          <a class="btn btn-gradient btn-lg" href="/products" data-magnetic>Shop all gear <%- icon('arrow-right', 'i-sm') %></a>
          <a class="btn btn-outline-light btn-lg" href="/products?sort=discount">Today's deals</a>
        </div>
        <ol class="hero3d-stages" aria-hidden="true">
          <li data-stage-label="0">Every sport</li>
          <li data-stage-label="1">One brand</li>
          <li data-stage-label="2">Built for you</li>
        </ol>
      </div>
      <span class="hero3d-scroll" aria-hidden="true"><span></span> Scroll</span>
    </div>
  </section>

  <section class="container trust-strip" aria-label="Why shop with Nexthlon">
    <a class="trust-item" href="/shipping-policy">
      <span class="trust-icon"><%- icon('truck') %></span>
      <span><strong>Free delivery</strong><small>On orders over <%= formatPrice(store.freeDeliveryMin) %></small></span>
    </a>
    <a class="trust-item" href="/refund-policy">
      <span class="trust-icon"><%- icon('rotate-ccw') %></span>
      <span><strong>Easy returns</strong><small><%= store.returnDays %>-day return window</small></span>
    </a>
    <a class="trust-item" href="/privacy">
      <span class="trust-icon"><%- icon('shield') %></span>
      <span><strong>Secure payment</strong><small>UPI, cards and net banking</small></span>
    </a>
    <a class="trust-item" href="/about">
      <span class="trust-icon"><%- icon('award') %></span>
      <span><strong>Genuine brands</strong><small>Every item from its maker</small></span>
    </a>
  </section>

  <%# ---------- 2. The zero-gravity showroom ----------
       Without JavaScript: a plain grid of product cards. showroom3d.js turns it into a pinned 3D room
       the camera flies through (wide screens), a floating swipe row (phones) or a still grid (reduced
       motion). The detail card is filled from the card's own markup. %>
  <% if (featured.length >= 3) { %>
    <% const shopperKind = !currentUser ? 'guest' : (currentUser.role === 'customer' ? 'customer' : 'staff'); %>
    <section class="showroom" aria-labelledby="showroom-title" data-showroom data-shopper="<%= shopperKind %>">
      <div class="showroom-pin">
        <canvas class="showroom-dust" data-showroom-dust aria-hidden="true"></canvas>
        <span class="showroom-light" aria-hidden="true"></span>
        <div class="container section-head showroom-head">
          <div>
            <span class="section-kicker">Featured gear</span>
            <h2 id="showroom-title">The zero-gravity showroom</h2>
            <p class="showroom-hint"><span class="hint-mouse">Move your mouse to look around. Scroll to fly through.</span><span class="hint-touch">Scroll to fly through. Tap a product to open it.</span></p>
          </div>
          <a class="section-link" href="/products">See all gear <%- icon('arrow-right', 'i-sm') %></a>
        </div>

        <div class="showroom-stage" data-showroom-stage>
          <div class="showroom-world" data-showroom-world>
            <% featured.forEach(function (p, i) { %>
              <article class="zg-card" data-zg-card data-id="<%= p.id %>" data-stock="<%= p.stock %>" data-rating="<%= p.rating %>" data-reviews="<%= p.ratingCount %>">
                <div class="zg-float">
                  <div class="zg-glass">
                    <span class="zg-media"><img src="<%= sizedUrl(p.image, 800) %>" srcset="<%= srcsetFor(p.image) %>" sizes="(max-width: 720px) 88vw, 320px" alt="<%= p.name %>" width="320" height="320" loading="lazy" decoding="async"></span>
                    <div class="zg-body">
                      <% if (p.brand) { %><span class="zg-brand"><%= p.brand %></span><% } %>
                      <a class="zg-link" href="/products/<%= p.slug %>" data-zg-link><span class="zg-name"><%= p.name %></span></a>
                      <p class="zg-price">
                        <strong data-zg-price><%= formatPrice(p.price) %></strong>
                        <% if (p.mrp > p.price) { %><s data-zg-mrp><span class="sr-only">M.R.P. </span><%= formatPrice(p.mrp) %></s><% } %>
                        <% if (p.discountPercent > 0) { %><em data-zg-off><%= p.discountPercent %>% off</em><% } %>
                      </p>
                      <% if (p.highlights.length) { %>
                        <ul class="zg-highlights" data-zg-highlights hidden>
                          <% p.highlights.forEach(function (h) { %><li><%= h %></li><% }) %>
                        </ul>
                      <% } %>
                    </div>
                    <% if (shopperKind !== 'staff') { %>
                      <div class="zg-actions">
                        <button type="button" class="zg-chip" data-zg-quick tabindex="-1">Quick view</button>
                        <button type="button" class="zg-chip zg-chip-volt" data-zg-add tabindex="-1" <%= p.stock > 0 ? '' : 'disabled' %>><%= p.stock > 0 ? 'Add to cart' : 'Sold out' %></button>
                      </div>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </div>

        <%# The 3D detail card: it unfolds like a book over the room. %>
        <div class="zg-detail" data-zg-detail role="dialog" aria-modal="true" aria-labelledby="zg-detail-name" hidden>
          <div class="zg-book" data-zg-book>
            <div class="zg-page zg-page-photo" data-zg-photo-page>
              <img src="" alt="" width="520" height="520" data-zg-d-img>
            </div>
            <div class="zg-page zg-page-info" data-zg-info-page>
              <button type="button" class="zg-close" data-zg-close aria-label="Close and fly back"><%- icon('x') %></button>
              <span class="zg-d-brand" data-zg-d-brand></span>
              <h3 class="zg-d-name" id="zg-detail-name" data-zg-d-name></h3>
              <p class="zg-d-rating" data-zg-d-rating></p>
              <p class="zg-d-price"><strong data-zg-d-price></strong> <s data-zg-d-mrp></s> <em data-zg-d-off></em></p>
              <ul class="zg-d-highlights" data-zg-d-highlights></ul>
              <% if (shopperKind !== 'staff') { %>
                <div class="zg-d-buy">
                  <div class="zg-qty" role="group" aria-label="Quantity">
                    <button type="button" data-zg-step="-1" aria-label="One less"><%- icon('minus', 'i-sm') %></button>
                    <input type="number" inputmode="numeric" min="1" max="5" value="1" aria-label="Quantity" data-zg-qty>
                    <button type="button" data-zg-step="1" aria-label="One more"><%- icon('plus', 'i-sm') %></button>
                  </div>
                  <button type="button" class="btn btn-primary" data-zg-d-add><%- icon('cart', 'i-sm') %> Add to cart</button>
                </div>
              <% } %>
              <a class="btn btn-ghost btn-block" href="/products" data-zg-d-view>View details <%- icon('arrow-right', 'i-sm') %></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <%# ---------- 3. Pick your sport: a 3D carousel ring of sports ----------
       Without JavaScript this is a plain grid of six linked cards. home3d.js turns it into the ring
       (or, with reduced motion, a simple swipe row). The tabs and dots only appear with JavaScript. %>
  <% if (sports.length >= 2) { %>
    <section class="sport-ring" aria-labelledby="sports-title" data-sport-ring style="--count: <%= sports.length %>">
      <div class="sport-ring-pin">
        <div class="sport-ring-bg" aria-hidden="true">
          <% sports.forEach(function (s, i) { %>
            <span class="sport-ring-glow<%= i === 0 ? ' is-active' : '' %>" style="--sport: <%= s.color %>" data-ring-glow></span>
          <% }) %>
          <% sports.forEach(function (s, i) { %>
            <span class="sport-ring-word<%= i === 0 ? ' is-active' : '' %>" data-ring-word><%= s.name %></span>
          <% }) %>
        </div>

        <div class="container sport-ring-head">
          <span class="section-kicker">Scroll the journey</span>
          <h2 id="sports-title">Pick your sport</h2>
          <div class="sport-tabs" role="tablist" aria-label="Sports" data-ring-tabs hidden>
            <% sports.forEach(function (s, i) { %>
              <button type="button" class="sport-tab" role="tab" id="sport-tab-<%= i %>" aria-selected="<%= i === 0 ? 'true' : 'false' %>" aria-controls="sport-card-<%= i %>" tabindex="<%= i === 0 ? '0' : '-1' %>" data-ring-tab="<%= i %>"><%= s.name %></button>
            <% }) %>
            <span class="sport-tabs-line" aria-hidden="true" data-ring-line></span>
          </div>
        </div>

        <div class="sport-ring-stage" data-ring-stage>
          <div class="sport-ring-scene">
            <div class="sport-ring-track" data-ring-track>
              <% sports.forEach(function (s, i) { %>
                <a class="sport-card" id="sport-card-<%= i %>" href="<%= s.href %>" style="--i: <%= i %>; --sport: <%= s.color %>" data-ring-card data-pos="<%= i === 0 ? 0 : '' %>">
                  <span class="sport-card-float">
                    <span class="sport-card-tilt">
                      <span class="sport-card-media">
                        <% if (s.image) { %><img src="<%= sizedUrl(s.image, 400) %>" srcset="<%= srcsetFor(s.image) %>" sizes="(max-width: 720px) 60vw, 320px" alt="" width="320" height="450" loading="lazy" decoding="async"><% } %>
                        <span class="sport-card-shade"></span>
                        <span class="sport-card-glare"></span>
                      </span>
                      <span class="sport-card-text">
                        <span class="sport-card-num"><%= s.number %></span>
                        <strong class="sport-card-name"><%= s.name %></strong>
                        <span class="sport-card-meta"><%= s.count %> <%= s.count === 1 ? 'item' : 'items' %> · from <%= formatPrice(s.fromPrice) %></span>
                        <span class="sport-card-cta">Shop <%= s.name %> <%- icon('arrow-right', 'i-sm') %></span>
                      </span>
                    </span>
                  </span>
                  <span class="sport-card-back" aria-hidden="true"><span><%= s.name %></span></span>
                </a>
              <% }) %>
            </div>
          </div>
          <span class="sport-ring-floor" aria-hidden="true"></span>
        </div>

        <div class="container sport-ring-foot" data-ring-foot hidden>
          <div class="sport-dots">
            <% sports.forEach(function (s, i) { %>
              <button type="button" class="sport-dot" aria-label="Show <%= s.name %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>" data-ring-dot="<%= i %>"></button>
            <% }) %>
          </div>
          <p class="sport-count" aria-hidden="true"><strong data-ring-current>01</strong> / <%= String(sports.length).padStart(2, '0') %></p>
        </div>
      </div>
    </section>
  <% } %>

  <%# ---------- 4. Showcase: one product on a rotating podium, lit by the mouse ---------- %>
  <% if (star) { %>
    <section class="container section showcase" aria-labelledby="showcase-title" data-showcase>
      <div class="showcase-copy" data-reveal>
        <span class="section-kicker">In the spotlight</span>
        <h2 id="showcase-title"><%= star.name %></h2>
        <div class="price-block">
          <div class="price-row">
            <span class="price price-lg"><%= formatPrice(star.price) %></span>
            <% if (star.mrp > star.price) { %><span class="mrp"><span class="sr-only">M.R.P. </span><s><%= formatPrice(star.mrp) %></s></span><% } %>
            <% if (star.discountPercent > 0) { %><span class="off"><%= star.discountPercent %>% off</span><% } %>
          </div>
        </div>
        <ul class="showcase-points">
          <% (star.highlights && star.highlights.length ? star.highlights.slice(0, 3) : ['Chosen by athletes', 'Genuine brand', store.returnDays + '-day easy returns']).forEach(function (line) { %>
            <li><%- icon('check', 'i-sm') %> <%= line %></li>
          <% }) %>
        </ul>
        <a class="btn btn-primary btn-lg" href="/products/<%= star.slug %>" data-magnetic>View product <%- icon('arrow-right', 'i-sm') %></a>
      </div>
      <div class="showcase-stage" data-showcase-stage aria-hidden="true">
        <span class="showcase-light"></span>
        <div class="showcase-scene">
          <img class="showcase-product" src="<%= sizedUrl(star.image, 800) %>" srcset="<%= srcsetFor(star.image) %>" sizes="(max-width: 720px) 70vw, 420px" alt="" width="420" height="420" loading="lazy" decoding="async">
          <img class="showcase-reflection" src="<%= sizedUrl(star.image, 400) %>" alt="" width="420" height="420" loading="lazy" decoding="async">
          <span class="showcase-podium"><span class="podium-top"></span><span class="podium-ring"></span></span>
        </div>
        <% (star.highlights && star.highlights.length ? star.highlights.slice(0, 3) : ['Chosen by athletes', 'Genuine brand', 'Easy returns']).forEach(function (line, i) { %>
          <span class="showcase-label showcase-label-<%= i + 1 %>"><svg class="showcase-line" viewBox="0 0 100 40" preserveAspectRatio="none"><path d="M0 38 L40 38 L100 2"/></svg><span><%= (function (t) { var words = t.split(/[:,(]| with | that | for /)[0].trim().split(' '); return words.slice(0, 3).join(' ') + (words.length > 3 ? '…' : ''); })(line) %></span></span>
        <% }) %>
      </div>
    </section>
  <% } %>

  <%# ---------- 5. Deals of the day: 3D flip cards and a flip-digit countdown ---------- %>
  <% if (deals.length) { %>
    <section class="container section" aria-labelledby="deals-title">
      <div class="section-box deal-box">
        <div class="section-head deal-head">
          <div>
            <span class="section-kicker">Ends at midnight</span>
            <h2 id="deals-title">Deals of the day</h2>
          </div>
          <div class="countdown flip-countdown" data-countdown data-left="<%= left %>" data-ends="<%= new Date(dealEndsAt).toISOString() %>" role="timer" aria-label="Time left on today's deals">
            <span class="countdown-label"><%- icon('clock', 'i-sm') %> Ends in</span>
            <% [['h', hh, 'hours'], ['m', mm, 'minutes'], ['s', ss, 'seconds']].forEach(function ([key, value, unit], n) { %>
              <span class="flip-unit">
                <span class="flip-digits" data-countdown-<%= key %> data-value="<%= value %>"><%= value %></span>
                <small><%= unit %></small>
              </span>
              <% if (n < 2) { %><span class="countdown-sep" aria-hidden="true">:</span><% } %>
            <% }) %>
          </div>
          <a class="section-link" href="/products?sort=discount">See all deals <%- icon('chevron-right', 'i-sm') %></a>
        </div>
        <ul class="flip-grid">
          <% deals.slice(0, 8).forEach(function (p) { %>
            <li class="flip-card" data-flip-card data-reveal>
              <div class="flip-inner">
                <div class="flip-face flip-front">
                  <span class="tag tag-deal"><%= p.discountPercent %>% off</span>
                  <img src="<%= sizedUrl(p.image, 400) %>" alt="" width="260" height="260" loading="lazy" decoding="async">
                  <strong class="flip-name"><%= p.name %></strong>
                  <span class="price-row"><span class="price price-sm"><%= formatPrice(p.price) %></span><span class="mrp"><s><%= formatPrice(p.mrp) %></s></span></span>
                  <button type="button" class="flip-toggle" data-flip-toggle aria-expanded="false" aria-label="Show the offer on <%= p.name %>"><%- icon('rotate-ccw', 'i-sm') %></button>
                </div>
                <div class="flip-face flip-back">
                  <span class="flip-off"><%= p.discountPercent %>%<small>off today</small></span>
                  <strong class="flip-name"><%= p.name %></strong>
                  <span class="saving">You save <%= formatPrice(p.mrp - p.price) %></span>
                  <% if (p.stock > 0 && shopper) { %>
                    <% if (currentUser) { %>
                      <%# The photo is on the hidden front face, so the flight starts from the whole card (store.js). %>
                      <button type="button" class="btn btn-primary btn-sm" data-cart-add="<%= p._id %>" data-cart-from="card" data-cart-src="<%= sizedUrl(p.image, 400) %>" data-cart-href="/products/<%= p.slug %>"><%- icon('cart', 'i-sm') %> Add to cart</button>
                    <% } else { %>
                      <a class="btn btn-primary btn-sm" href="/login?next=<%= encodeURIComponent('/products/' + p.slug) %>"><%- icon('cart', 'i-sm') %> Sign in to buy</a>
                    <% } %>
                  <% } else if (p.stock <= 0) { %>
                    <span class="stock stock-out">Out of stock</span>
                  <% } %>
                  <a class="link-btn" href="/products/<%= p.slug %>">View details</a>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>
  <% } %>

  <%# ---------- 6. Shop by sport: tiles with depth layers ---------- %>
  <% if (categories.length) { %>
    <section class="container section" aria-labelledby="shop-sports-title">
      <div class="section-head" data-reveal>
        <div>
          <span class="section-kicker">Browse</span>
          <h2 id="shop-sports-title">Shop by sport</h2>
        </div>
        <a class="section-link" href="/products">See all gear <%- icon('chevron-right', 'i-sm') %></a>
      </div>
      <div class="depth-grid">
        <% categories.forEach(function (c) { %>
          <a class="depth-tile" data-reveal data-tilt href="/products?category=<%= c.slug %>">
            <span class="depth-media"><img src="<%= sizedUrl(c.image, 400) %>" srcset="<%= srcsetFor(c.image) %>" sizes="(max-width: 720px) 45vw, 320px" alt="" loading="lazy" decoding="async" width="320" height="320"></span>
            <span class="depth-title"><%= c.name %></span>
            <span class="depth-price"><%= c.count %> <%= c.count === 1 ? 'item' : 'items' %> · from <%= formatPrice(c.fromPrice) %></span>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <%# ---------- 7. Numbers that count up ---------- %>
  <section class="container section stats3d" aria-label="Nexthlon in numbers">
    <div class="stat3d" data-reveal><strong data-count-to="<%= productCount %>"><%= productCount %></strong><span>Products in stock and ready</span></div>
    <div class="stat3d" data-reveal><strong data-count-to="<%= categories.length %>"><%= categories.length %></strong><span>Sports covered</span></div>
    <div class="stat3d" data-reveal><strong data-count-to="<%= brands.length %>"><%= brands.length %></strong><span>Genuine brands</span></div>
    <div class="stat3d" data-reveal><strong data-count-to="<%= store.returnDays %>"><%= store.returnDays %></strong><span>Days to return, no questions</span></div>
  </section>

  <% if (bestSellers.length) { %>
    <section class="container section" aria-labelledby="best-title">
      <div class="section-head" data-reveal>
        <div>
          <span class="section-kicker">Popular picks</span>
          <h2 id="best-title">Best sellers</h2>
        </div>
        <a class="section-link" href="/products?inStock=1">Shop in-stock gear <%- icon('chevron-right', 'i-sm') %></a>
      </div>
      <%- include('../partials/rail', { products: bestSellers, label: 'Best sellers' }) %>
    </section>
  <% } %>

  <% if (!currentUser) { %>
    <section class="container section">
      <div class="join-banner" data-reveal="scale">
        <div class="join-copy">
          <span class="section-kicker">Free account</span>
          <h2>Join Nexthlon in under a minute</h2>
          <p>Save your wishlist and delivery addresses, and check out faster every time.</p>
        </div>
        <div class="join-actions">
          <a class="btn btn-primary btn-lg" href="/signup">Create your account</a>
          <a class="join-signin" href="/login">Already a member? Sign in</a>
        </div>
      </div>
    </section>
  <% } %>

  <% if (newest.length) { %>
    <section class="container section" aria-labelledby="new-title">
      <div class="section-head" data-reveal>
        <div>
          <span class="section-kicker">Just landed</span>
          <h2 id="new-title">New arrivals</h2>
        </div>
        <a class="section-link" href="/products?sort=newest">See what's new <%- icon('chevron-right', 'i-sm') %></a>
      </div>
      <%- include('../partials/rail', { products: newest, label: 'New arrivals' }) %>
    </section>
  <% } %>

  <% if (shopper) { %>
    <%# Filled from this browser's history by store.js. Hidden until there is something to show. %>
    <section class="container section" aria-labelledby="recent-title" data-recent hidden>
      <div class="section-head">
        <div>
          <span class="section-kicker">Pick up where you left off</span>
          <h2 id="recent-title">Recently viewed</h2>
        </div>
        <button type="button" class="link-btn" data-recent-clear><%- icon('x', 'i-xs') %> Clear history</button>
      </div>
      <div class="rail" data-rail>
        <button type="button" class="rail-btn rail-prev" data-rail-step="-1" aria-label="Scroll recently viewed left" disabled><%- icon('chevron-left') %></button>
        <div class="rail-track" data-rail-track data-recent-track tabindex="0" role="group" aria-label="Recently viewed, scrolls sideways" aria-busy="true">
          <% for (let n = 0; n < 5; n++) { %>
            <div class="skeleton-card" aria-hidden="true"><div class="skeleton skeleton-media"></div><div class="skeleton skeleton-line"></div><div class="skeleton skeleton-line is-short"></div></div>
          <% } %>
        </div>
        <button type="button" class="rail-btn rail-next" data-rail-step="1" aria-label="Scroll recently viewed right"><%- icon('chevron-right') %></button>
      </div>
      <p class="state-box is-error" data-recent-error hidden>We couldn't load your recently viewed items. <button type="button" class="link-btn" data-recent-retry>Try again</button></p>
    </section>
  <% } %>

  <% if (!deals.length && !newest.length) { %>
    <section class="container section">
      <div class="empty-state">
        <%- include('../partials/empty-art', { art: 'box' }) %>
