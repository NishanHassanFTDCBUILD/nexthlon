<%- include('../partials/account-start', { section: 'addresses' }) %>
<section class="panel acct-section" id="addresses" aria-labelledby="addresses-title">
  <div class="panel-head">
    <span class="panel-icon"><%- icon('pin') %></span>
    <div>
      <h1 id="addresses-title">Your addresses</h1>
      <p class="muted"><%= addresses.length %> of <%= maxAddresses %> saved. Your default address is used first at checkout.</p>
    </div>
    <div class="address-meter" aria-hidden="true"><span style="--fill: <%= Math.min(addresses.length, maxAddresses) / maxAddresses %>"></span></div>
  </div>
  <div class="address-grid">
    <% if (addresses.length < maxAddresses) { %>
      <button type="button" class="address-add" data-address-add>
        <span class="address-add-icon"><%- icon('plus', 'i-lg') %></span>
        <strong>Add address</strong>
        <span>Home, work or anywhere you train</span>
      </button>
    <% } %>
    <% addresses.forEach(function (a) { %>
      <article class="address-card <%= a.isDefault ? 'is-default' : '' %>" aria-label="Address for <%= a.fullName %><%= a.isDefault ? ', default' : '' %>">
        <div class="address-card-head">
          <h2 class="address-name"><%= a.fullName %></h2>
          <span class="address-type-pill"><%- icon(a.type === 'work' ? 'box' : a.type === 'other' ? 'pin' : 'home', 'i-xs') %> <%= a.type === 'work' ? 'Work' : a.type === 'other' ? 'Other' : 'Home' %></span>
          <% if (a.isDefault) { %><span class="pill pill-blue"><%- icon('check', 'i-xs') %> Default</span><% } %>
        </div>
        <p>
          <%= a.line1 %><br>
          <% if (a.line2) { %><%= a.line2 %><br><% } %>
          <% if (a.landmark) { %>Near <%= a.landmark %><br><% } %>
          <%= a.city %>, <%= a.state %> <%= a.pincode %>
        </p>
        <p class="address-phone"><%- icon('phone', 'i-xs') %> +91 <%= a.phone %></p>
        <div class="address-actions">
          <button type="button" class="btn btn-ghost btn-xs" data-address-edit
                  data-address="<%= JSON.stringify({ id: String(a._id), fullName: a.fullName, phone: a.phone, line1: a.line1, line2: a.line2, landmark: a.landmark, city: a.city, state: a.state, pincode: a.pincode, type: a.type || 'home', isDefault: a.isDefault }) %>"
                  aria-label="Edit address for <%= a.fullName %>"><%- icon('edit', 'i-xs') %> Edit</button>
          <button type="button" class="btn btn-danger-soft btn-xs" data-address-delete="<%= a._id %>" data-name="<%= a.fullName %>"
                  aria-label="Remove address for <%= a.fullName %>"><%- icon('trash', 'i-xs') %> Remove</button>
          <% if (!a.isDefault) { %>
            <button type="button" class="link-btn" data-address-default="<%= a._id %>">Deliver here by default</button>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>


<%- include('../partials/address-dialog') %>
<%- include('../partials/account-end') %>
