<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="container page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <%- icon('chevron-right', 'i-xs') %> <span aria-current="page">Your account</span>
  </nav>

  <div class="account-hero">
    <span class="avatar avatar-lg"><%= currentUser.name.charAt(0).toUpperCase() %></span>
    <div class="account-hero-text">
      <h1>Hello, <%= firstName(currentUser.name) %></h1>
      <p class="account-hero-meta">
        <span><%- icon('mail', 'i-xs') %> <%= currentUser.email %></span>
        <span><%- icon('calendar', 'i-xs') %> Member since <%= formatDate(currentUser.createdAt) %></span>
      </p>
    </div>
    <div class="account-hero-stat">
      <strong><%= addresses.length %></strong>
      <span><%= addresses.length === 1 ? 'saved address' : 'saved addresses' %></span>
    </div>
  </div>

  <div class="account-layout">
    <nav class="account-nav" aria-label="Account sections" data-account-nav>
      <a href="#details"><%- icon('user') %> Account details</a>
      <a href="#addresses"><%- icon('pin') %> Your addresses</a>
      <a href="#security"><%- icon('lock') %> Login &amp; security</a>
      <span class="account-nav-soon"><%- icon('box') %> Your orders <em>Coming soon</em></span>
    </nav>

    <div class="account-content">
      <section class="panel" id="details" aria-labelledby="details-title">
        <div class="panel-head">
          <span class="panel-icon"><%- icon('user') %></span>
          <div>
            <h2 id="details-title">Account details</h2>
            <p class="muted">Your name appears on your account and future orders.</p>
          </div>
        </div>
        <form class="form form-grid" data-profile-form novalidate>
          <div class="form-alert field-wide" data-form-alert aria-live="polite"></div>
          <div class="field">
            <label for="profile-name">Full name</label>
            <input id="profile-name" name="name" type="text" autocomplete="name" value="<%= currentUser.name %>" required maxlength="60" aria-describedby="profile-name-error">
            <p class="field-error" id="profile-name-error" data-error-for="name"></p>
          </div>
          <div class="field">
            <label for="profile-email">Email address</label>
            <input id="profile-email" type="email" value="<%= currentUser.email %>" disabled aria-describedby="profile-email-hint">
            <p class="hint" id="profile-email-hint"><%- icon('lock', 'i-xs') %> Your email is your sign-in ID and cannot be changed here.</p>
          </div>
          <div class="field">
            <label for="profile-phone">Mobile number <span class="optional">(optional)</span></label>
            <div class="input-prefix">
              <span>+91</span>
              <input id="profile-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="10" value="<%= currentUser.phone %>" placeholder="10-digit number" aria-describedby="profile-phone-error">
            </div>
            <p class="field-error" id="profile-phone-error" data-error-for="phone"></p>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Save changes</button>
          </div>
        </form>
      </section>

      <section class="panel" id="addresses" aria-labelledby="addresses-title">
        <div class="panel-head">
          <span class="panel-icon"><%- icon('pin') %></span>
          <div>
            <h2 id="addresses-title">Your addresses</h2>
            <p class="muted"><%= addresses.length %> of 10 saved. Your default address is used first at checkout.</p>
          </div>
          <div class="address-meter" aria-hidden="true"><span style="--fill: <%= Math.min(addresses.length, 10) / 10 %>"></span></div>
        </div>
        <div class="address-grid">
          <% if (addresses.length < 10) { %>
            <button type="button" class="address-add" data-address-add>
              <span class="address-add-icon"><%- icon('plus', 'i-lg') %></span>
              <strong>Add address</strong>
              <span>Home, work or anywhere you train</span>
            </button>
          <% } %>
          <% addresses.forEach(function (a) { %>
            <article class="address-card <%= a.isDefault ? 'is-default' : '' %>" aria-label="Address for <%= a.fullName %><%= a.isDefault ? ', default' : '' %>">
              <div class="address-card-head">
                <h3><%= a.fullName %></h3>
                <% if (a.isDefault) { %><span class="pill pill-blue"><%- icon('check', 'i-xs') %> Default</span><% } %>
              </div>
              <p>
                <%= a.line1 %><br>
                <% if (a.line2) { %><%= a.line2 %><br><% } %>
                <% if (a.landmark) { %>Near <%= a.landmark %><br><% } %>
                <%= a.city %>, <%= a.state %> <%= a.pincode %>
              </p>
              <p class="address-phone"><%- icon('phone', 'i-xs') %> +91 <%= a.phone %></p>
              <div class="address-actions">
                <button type="button" class="btn btn-ghost btn-xs" data-address-edit
                        data-address="<%= JSON.stringify({ id: String(a._id), fullName: a.fullName, phone: a.phone, line1: a.line1, line2: a.line2, landmark: a.landmark, city: a.city, state: a.state, pincode: a.pincode, isDefault: a.isDefault }) %>"
                        aria-label="Edit address for <%= a.fullName %>"><%- icon('edit', 'i-xs') %> Edit</button>
                <button type="button" class="btn btn-danger-soft btn-xs" data-address-delete="<%= a._id %>" data-name="<%= a.fullName %>"
                        aria-label="Remove address for <%= a.fullName %>"><%- icon('trash', 'i-xs') %> Remove</button>
                <% if (!a.isDefault) { %>
                  <button type="button" class="link-btn" data-address-default="<%= a._id %>">Set as default</button>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="panel" id="security" aria-labelledby="security-title">
        <div class="panel-head">
          <span class="panel-icon"><%- icon('lock') %></span>
          <div>
            <h2 id="security-title">Login &amp; security</h2>
            <p class="muted">Changing your password signs you out on every other device.</p>
          </div>
        </div>
        <form class="form form-grid" data-password-form novalidate>
          <div class="form-alert field-wide" data-form-alert aria-live="polite"></div>
          <div class="field field-wide field-half">
            <label for="currentPassword">Current password</label>
            <div class="password-wrap">
              <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required maxlength="64" aria-describedby="currentPassword-error">
              <button type="button" class="reveal" data-reveal="currentPassword" aria-label="Show password"><%- icon('eye') %></button>
            </div>
            <p class="field-error" id="currentPassword-error" data-error-for="currentPassword"></p>
          </div>
          <div class="field">
            <label for="newPassword">New password</label>
            <div class="password-wrap">
              <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="64" data-strength aria-describedby="newPassword-rules newPassword-error">
              <button type="button" class="reveal" data-reveal="newPassword" aria-label="Show password"><%- icon('eye') %></button>
            </div>
            <div class="strength" aria-hidden="true"><span class="strength-bar" data-strength-bar></span></div>
            <ul class="rules" id="newPassword-rules" data-rules aria-label="Password must have">
              <li data-rule="length"><span class="rule-mark" aria-hidden="true"></span>8 to 64 characters<span class="sr-only" data-rule-state> (not yet)</span></li>
              <li data-rule="letter"><span class="rule-mark" aria-hidden="true"></span>At least one letter<span class="sr-only" data-rule-state> (not yet)</span></li>
              <li data-rule="number"><span class="rule-mark" aria-hidden="true"></span>At least one number<span class="sr-only" data-rule-state> (not yet)</span></li>
            </ul>
            <p class="field-error" id="newPassword-error" data-error-for="newPassword"></p>
          </div>
          <div class="field">
            <label for="confirmNewPassword">Confirm new password</label>
            <input id="confirmNewPassword" name="confirmPassword" type="password" autocomplete="new-password" required maxlength="64" aria-describedby="confirmPassword-error">
            <p class="field-error" id="confirmPassword-error" data-error-for="confirmPassword"></p>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Change password</button>
          </div>
        </form>
      </section>
    </div>
  </div>
</main>

<dialog class="sheet-dialog" id="address-dialog" aria-labelledby="address-dialog-title">
  <form class="form sheet-form" data-address-form novalidate>
    <div class="dialog-head">
      <span class="panel-icon"><%- icon('pin') %></span>
      <div>
        <h2 id="address-dialog-title">Add a new address</h2>
        <p class="muted">Fields marked optional can be left empty.</p>
      </div>
      <button type="button" class="icon-btn" data-dialog-close aria-label="Close"><%- icon('x') %></button>
    </div>
    <div class="sheet-body">
      <div class="form-alert" data-form-alert aria-live="assertive"></div>
      <input type="hidden" name="id">
      <div class="form-grid form-grid-2">
        <div class="field">
          <label for="a-fullName">Full name</label>
          <input id="a-fullName" name="fullName" autocomplete="name" required maxlength="60" aria-describedby="a-fullName-error">
          <p class="field-error" id="a-fullName-error" data-error-for="fullName"></p>
        </div>
        <div class="field">
          <label for="a-phone">Mobile number</label>
          <div class="input-prefix">
            <span>+91</span>
            <input id="a-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" required maxlength="10" placeholder="10-digit number" aria-describedby="a-phone-error">
          </div>
          <p class="field-error" id="a-phone-error" data-error-for="phone"></p>
        </div>
        <div class="field field-wide">
          <label for="a-line1">Flat, house no., building, street</label>
          <input id="a-line1" name="line1" autocomplete="address-line1" required maxlength="120" aria-describedby="a-line1-error">
          <p class="field-error" id="a-line1-error" data-error-for="line1"></p>
        </div>
        <div class="field field-wide">
          <label for="a-line2">Area, colony, village <span class="optional">(optional)</span></label>
          <input id="a-line2" name="line2" autocomplete="address-line2" maxlength="120" aria-describedby="a-line2-error">
          <p class="field-error" id="a-line2-error" data-error-for="line2"></p>
        </div>
        <div class="field">
          <label for="a-landmark">Landmark <span class="optional">(optional)</span></label>
          <input id="a-landmark" name="landmark" maxlength="80" placeholder="e.g. near Apollo hospital" aria-describedby="a-landmark-error">
          <p class="field-error" id="a-landmark-error" data-error-for="landmark"></p>
        </div>
        <div class="field">
          <label for="a-pincode">PIN code</label>
          <input id="a-pincode" name="pincode" inputmode="numeric" autocomplete="postal-code" required maxlength="6" placeholder="6 digits" aria-describedby="a-pincode-error">
          <p class="field-error" id="a-pincode-error" data-error-for="pincode"></p>
        </div>
        <div class="field">
          <label for="a-city">Town or city</label>
          <input id="a-city" name="city" autocomplete="address-level2" required maxlength="50" aria-describedby="a-city-error">
          <p class="field-error" id="a-city-error" data-error-for="city"></p>
        </div>
        <div class="field">
          <label for="a-state">State</label>
          <div class="select-wrap select-field">
            <select id="a-state" name="state" autocomplete="address-level1" required aria-describedby="a-state-error">
              <option value="">Choose a state</option>
              <% states.forEach(function (state) { %><option value="<%= state %>"><%= state %></option><% }) %>
            </select>
            <%- icon('chevron-down', 'i-xs') %>
          </div>
          <p class="field-error" id="a-state-error" data-error-for="state"></p>
        </div>
        <label class="choice choice-card field-wide">
          <input type="checkbox" name="isDefault" value="true">
          <span><strong>Make this my default address</strong><small>We'll use it first at checkout.</small></span>
        </label>
      </div>
    </div>
    <div class="dialog-actions sheet-foot">
      <button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button>
      <button type="submit" class="btn btn-primary">Save address</button>
    </div>
  </form>
</dialog>

<%- include('../partials/footer', { scripts: ['auth', 'profile'] }) %>
