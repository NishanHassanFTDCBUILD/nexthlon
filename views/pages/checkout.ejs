<%- include('../partials/head', { styles: ['checkout'] }) %>
<%- include('../partials/header') %>

<%
  const t = quote.totals;
  const chosen = addresses.find(function (a) { return a.isDefault; }) || addresses[0];
  const isBuyNow = typeof buyNow !== 'undefined' && buyNow;
  const buyItem = isBuyNow ? (quote.lines[0] || quote.items[0]) : null;
%>
<main id="main" class="container page checkout<%= isBuyNow ? ' is-buy-now' : '' %>" data-checkout data-source="<%= isBuyNow ? 'buynow' : 'cart' %>" data-prefill-name="<%= currentUser.name %>" data-prefill-email="<%= currentUser.email %>" data-prefill-phone="<%= currentUser.phone || (chosen ? chosen.phone : '') %>">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <%- icon('chevron-right', 'i-xs') %>
    <% if (isBuyNow && buyItem) { %><a href="/products/<%= buyItem.slug %>"><%= buyItem.name %></a><% } else { %><a href="/cart">Cart</a><% } %>
    <%- icon('chevron-right', 'i-xs') %> <span aria-current="page"><%= isBuyNow ? 'Buy now' : 'Checkout' %></span>
  </nav>
  <div class="checkout-top">
    <div>
      <h1><%= isBuyNow ? 'Buy now' : 'Checkout' %></h1>
      <% if (isBuyNow) { %>
        <p class="buy-now-note"><%- icon('bolt', 'i-xs') %> Only this item is being bought. Your cart stays as it is.</p>
      <% } %>
    </div>
    <ol class="stepper" aria-label="Checkout steps">
      <li data-stepper="1" aria-current="step"><span>1</span> Address</li>
      <li data-stepper="2"><span>2</span> Summary</li>
      <li data-stepper="3"><span>3</span> Payment</li>
    </ol>
  </div>
  <noscript><div class="alert alert-info"><%- icon('info') %> <span>Please turn on JavaScript to place your order.</span></div></noscript>

  <div class="checkout-layout">
    <div class="checkout-steps">
      <section class="step is-open" data-step="1" aria-labelledby="step1-title">
        <header class="step-head">
          <span class="step-num" aria-hidden="true">1</span>
          <div>
            <h2 id="step1-title">Delivery address</h2>
            <p class="step-summary" data-step-summary></p>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" data-step-edit="1" hidden>Change</button>
        </header>
        <div class="step-body">
          <% if (addresses.length) { %>
            <fieldset class="address-choices">
              <legend class="sr-only">Choose where to deliver</legend>
              <% addresses.forEach(function (a) { const eta = (typeof estimates !== 'undefined' && estimates[String(a._id)]) || null; %>
                <label class="address-choice">
                  <input type="radio" name="addressId" value="<%= a._id %>" data-pincode="<%= a.pincode %>" data-phone="<%= a.phone %>" data-label="<%= a.fullName %>, <%= a.city %> <%= a.pincode %>" data-eta="<%= eta && eta.deliverable ? eta.label : '' %>" data-eta-off="<%= eta && !eta.deliverable ? eta.reason : '' %>" <%= chosen && String(chosen._id) === String(a._id) ? 'checked' : '' %>>
                  <span class="address-choice-body">
                    <strong><%= a.fullName %></strong><% if (a.isDefault) { %> <span class="pill pill-blue">Default</span><% } %>
                    <span><%= a.line1 %><%= a.line2 ? ', ' + a.line2 : '' %><%= a.landmark ? ', near ' + a.landmark : '' %></span>
                    <span><%= a.city %>, <%= a.state %> <%= a.pincode %></span>
                    <span class="muted"><%- icon('phone', 'i-xs') %> +91 <%= a.phone %></span>
                    <% if (eta && eta.deliverable) { %><span class="address-eta"><%- icon('truck', 'i-xs') %><span>Arrives <strong><%= eta.label %></strong></span></span><% } else if (eta) { %><span class="address-eta is-off"><%- icon('alert', 'i-xs') %><span><%= eta.reason %></span></span><% } %>
                  </span>
                </label>
              <% }) %>
            </fieldset>
          <% } else { %>
            <div class="state-box"><%- icon('pin', 'i-sm') %> You have no saved addresses yet. Add one to continue.</div>
          <% } %>
          <p class="field-error" data-error-for="addressId"></p>
          <div class="step-actions">
            <button type="button" class="btn btn-ghost" data-address-add><%- icon('plus', 'i-sm') %> Add a new address</button>
            <button type="button" class="btn btn-primary" data-step-next="1" <%= addresses.length ? '' : 'disabled' %>>Deliver here <%- icon('arrow-right', 'i-sm') %></button>
          </div>
        </div>
      </section>

      <section class="step" data-step="2" aria-labelledby="step2-title">
        <header class="step-head">
          <span class="step-num" aria-hidden="true">2</span>
          <div>
            <h2 id="step2-title">Order summary</h2>
            <p class="step-summary" data-step-summary></p>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" data-step-edit="2" hidden>Change</button>
        </header>
        <div class="step-body" hidden>
          <% if (quote.problems.length) { %>
            <div class="alert alert-danger" role="alert"><%- icon('alert') %> <span><% if (isBuyNow) { %>This product is no longer available: <%= quote.problems.join('; ') %>. <a href="/products">Browse other gear</a>.<% } else { %>Some items are no longer available: <%= quote.problems.join('; ') %>. <a href="/cart">Update your cart</a> to continue.<% } %></span></div>
          <% } %>
          <ul class="checkout-items">
            <% quote.lines.forEach(function (item) { %>
              <li>
                <img src="<%= sizedUrl(item.image, 200) %>" alt="" width="64" height="64" loading="lazy">
                <div>
                  <strong><%= item.name %></strong>
                  <% if (item.option) { %><span class="item-option"><%= item.option %></span><% } %>
                  <span class="muted">Qty <%= item.quantity %> · <%= formatPrice(item.price) %> each</span>
                </div>
                <strong><%= formatPrice(item.lineTotal) %></strong>
              </li>
            <% }) %>
          </ul>
          <p class="delivery-result" data-checkout-delivery aria-live="polite"></p>
          <div class="step-actions">
            <% if (isBuyNow && buyItem) { %>
              <a class="btn btn-ghost" href="/products/<%= buyItem.slug %>">Change quantity</a>
            <% } else { %>
              <a class="btn btn-ghost" href="/cart">Edit cart</a>
            <% } %>
            <button type="button" class="btn btn-primary" data-step-next="2" <%= quote.problems.length ? 'disabled' : '' %>>Continue to payment <%- icon('arrow-right', 'i-sm') %></button>
          </div>
        </div>
      </section>

      <section class="step" data-step="3" aria-labelledby="step3-title">
        <header class="step-head">
          <span class="step-num" aria-hidden="true">3</span>
          <div><h2 id="step3-title">Payment method</h2></div>
        </header>
        <div class="step-body" hidden>
          <form class="form pay-form" data-place-order novalidate>
            <div class="form-alert" data-form-alert aria-live="assertive"></div>
            <%
              // The wallet can pay the whole order, or part of it with online payment for the rest (never COD).
              const walletReady = quote.walletBalance > 0 && (razorpayEnabled || quote.coveredByWallet);
              // Default to the available online payment gateway.
              const firstChoice = razorpayEnabled ? 'razorpay' : quote.codAllowed ? 'cod' : walletReady ? 'wallet' : '';
            %>
            <fieldset class="pay-methods">
              <legend class="sr-only">Choose how to pay</legend>

              <div class="pay-card <%= razorpayEnabled ? '' : 'is-disabled' %>" data-pay-card="razorpay" data-tilt data-tilt-max="4">
                <label class="pay-card-head">
                  <input type="radio" name="paymentMethod" value="razorpay" <%= razorpayEnabled ? '' : 'disabled' %> <%= firstChoice === 'razorpay' ? 'checked' : '' %> aria-describedby="pay-razorpay-note">
                  <span class="pay-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9"/></svg></span>
                  <span class="pay-card-icon"><%- icon('credit-card') %></span>
                  <span class="pay-card-title">
                    <strong>Pay online</strong>
                    <span class="muted" id="pay-razorpay-note"><%= razorpayEnabled ? 'UPI, cards, netbanking and wallets' : 'Online payment is not set up yet' %></span>
                  </span>
                  <% if (razorpayEnabled) { %><span class="pill pill-green pay-card-tag">Fastest</span><% } %>
                </label>
                <div class="pay-card-details" data-pay-details>
                  <% if (razorpayEnabled && quote.onlineOffer) { %><p class="pay-offer" data-online-offer<%= quote.onlineOffer.saving > 0 ? '' : ' hidden' %>><%- icon('tag', 'i-xs') %> <span><strong data-online-saving><%= formatPrice(quote.onlineOffer.saving) %> off</strong> for paying online (<%= quote.onlineOffer.percent %>%<%= quote.onlineOffer.max ? ', up to ' + formatPrice(quote.onlineOffer.max) : '' %>)</span></p><% } %>
                  <p>You pay in Razorpay's secure window: UPI (Google Pay, PhonePe, Paytm), debit and credit cards, netbanking, EMI and wallets. Nexthlon never sees or stores your card or UPI details.</p>
                  <% if (typeof razorpayTestMode !== 'undefined' && razorpayTestMode) { %><p class="muted">Test mode: no real money moves.</p><% } %>
                </div>
              </div>

              <div class="pay-card <%= walletReady ? '' : 'is-disabled' %>" data-pay-card="wallet" data-tilt data-tilt-max="4">
                <label class="pay-card-head">
                  <input type="radio" name="paymentMethod" value="wallet" <%= walletReady ? '' : 'disabled' %> <%= firstChoice === 'wallet' ? 'checked' : '' %> aria-describedby="pay-wallet-note">
                  <span class="pay-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9"/></svg></span>
                  <span class="pay-card-icon"><%- icon('wallet') %></span>
                  <span class="pay-card-title">
                    <strong>Nexthlon wallet</strong>
                    <span class="muted" id="pay-wallet-note">Balance <%= formatPrice(quote.walletBalance) %></span>
                  </span>
                </label>
                <div class="pay-card-details" data-pay-details>
                  <% if (walletReady) { %>
                    <p data-wallet-note>Your wallet balance is used first.</p>
                    <fieldset class="pay-rest" data-pay-rest hidden>
                      <legend>Pay the remaining <strong data-sum="total" data-value="<%= t.total %>"><%= formatPrice(t.total) %></strong> with</legend>
                      <label class="choice"><input type="radio" name="restMethod" value="razorpay" <%= razorpayEnabled ? 'checked' : 'disabled' %>><span>Pay online (UPI, cards, netbanking)</span></label>
                    </fieldset>
                  <% } else { %>
                    <p>Your wallet is empty. Cancellation credits, return credits and referral rewards land here. <a href="/account/referral">Invite friends to earn</a>.</p>
                  <% } %>
                </div>
              </div>

              <div class="pay-card <%= quote.codAllowed ? '' : 'is-disabled' %>" data-pay-card="cod" data-tilt data-tilt-max="4">
                <label class="pay-card-head">
                  <input type="radio" name="paymentMethod" value="cod" <%= quote.codAllowed ? '' : 'disabled' %> <%= firstChoice === 'cod' ? 'checked' : '' %> aria-describedby="pay-cod-note">
                  <span class="pay-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9"/></svg></span>
                  <span class="pay-card-icon"><%- icon('truck') %></span>
                  <span class="pay-card-title">
                    <strong>Cash on Delivery</strong>
                    <span class="muted" id="pay-cod-note" data-cod-note data-ok="Pay in cash or UPI at your door" data-off="<%= quote.codLimit > 0 ? 'Only for orders up to ' + formatPrice(quote.codLimit) : 'Not available right now' %>"><%= quote.codAllowed ? 'Pay in cash or UPI at your door' : quote.codLimit > 0 ? 'Only for orders up to ' + formatPrice(quote.codLimit) : 'Not available right now' %></span>
                  </span>
                </label>
                <div class="pay-card-details" data-pay-details>
                  <p>Pay the delivery partner in cash or by UPI when your order arrives. <%= quote.codLimit > 0 ? 'Available for orders up to ' + formatPrice(quote.codLimit) + '.' : 'Not available right now.' %></p>
                </div>
              </div>
            </fieldset>
            <p class="field-error" data-error-for="paymentMethod"></p>

            <% const firstEta = chosen && typeof estimates !== 'undefined' ? estimates[String(chosen._id)] : null; %>
            <p class="pay-eta" data-pay-eta <%= firstEta && firstEta.deliverable ? '' : 'hidden' %>><%- icon('truck', 'i-xs') %> Arrives <strong data-pay-eta-text><%= firstEta && firstEta.deliverable ? firstEta.label : '' %></strong><% if (firstEta && firstEta.orderBy) { %> <span class="muted">if you order by <%= firstEta.orderBy %></span><% } %></p>
            <div class="pay-submit" data-pay-submit>
              <button class="btn btn-primary btn-lg btn-block pay-btn" type="submit" <%= firstChoice && !quote.problems.length ? '' : 'disabled' %>>
                <%- icon('lock', 'i-sm') %> <span data-place-text>Pay <%= formatPrice(t.total) %> securely</span>
              </button>
            </div>
            <div class="trust-row">
              <span class="trust-row-label"><%- icon('lock', 'i-sm') %> 100% secure payments</span>
              <%- include('../partials/payment-icons', { compact: true }) %>
            </div>
            <p class="hint"><%- icon('shield', 'i-xs') %> By placing your order you agree to our <a href="/terms">terms</a> and <a href="/refund-policy">cancellation and wallet credit policy</a>.</p>
            <p class="hint">Eligible paid cancellations and approved returns credit your Nexthlon wallet for future purchases on Nexthlon.</p>
          </form>
        </div>
      </section>
    </div>

    <%# On phones this column is a sheet that slides up from the pay bar below ("Details"). %>
    <div class="checkout-side" id="checkout-side" data-summary-sheet aria-label="Price details and coupons">
      <div class="sheet-head" data-sheet-head>
        <span class="sheet-grip" aria-hidden="true"></span>
        <h2 class="sheet-title">Price details</h2>
        <button type="button" class="icon-btn" data-summary-close aria-label="Close price details"><%- icon('x') %></button>
      </div>
      <%# Order updates go to this email, so it's asked for here, beside the steps instead of above them. %>
      <%- include('../partials/verify-banner') %>
      <aside class="cart-summary panel checkout-summary" aria-labelledby="price-title" data-summary>
        <h2 id="price-title" class="panel-title">Price details</h2>
        <dl class="summary-list" aria-live="polite">
          <div><dt>M.R.P. total (<%= t.itemCount %> <%= t.itemCount === 1 ? 'item' : 'items' %>)</dt><dd data-sum="mrpTotal" data-value="<%= t.mrpTotal %>"><%= formatPrice(t.mrpTotal) %></dd></div>
          <div class="summary-savings"><dt>Discount on M.R.P.</dt><dd data-sum="discount" data-value="<%= t.discount %>" data-minus>−<%= formatPrice(t.discount) %></dd></div>
          <div class="summary-savings" data-sum-row="couponDiscount" <%= t.couponDiscount ? '' : 'hidden' %>><dt>Coupon <span data-sum-text="couponCode"><%= t.couponCode %></span></dt><dd data-sum="couponDiscount" data-value="<%= t.couponDiscount %>" data-minus>−<%= formatPrice(t.couponDiscount) %></dd></div>
          <div class="summary-savings" data-sum-row="prepaidDiscount" <%= t.prepaidDiscount ? '' : 'hidden' %>><dt>Paying online</dt><dd data-sum="prepaidDiscount" data-value="<%= t.prepaidDiscount || 0 %>" data-minus>−<%= formatPrice(t.prepaidDiscount || 0) %></dd></div>
          <div><dt>Delivery fee</dt><dd data-sum="deliveryFee" data-value="<%= t.deliveryFee %>" data-free><%- t.deliveryFee ? formatPrice(t.deliveryFee) : '<span class="text-success">Free</span>' %></dd></div>
          <div data-sum-row="walletUsed" <%= t.walletUsed ? '' : 'hidden' %>><dt>Paid from wallet</dt><dd data-sum="walletUsed" data-value="<%= t.walletUsed %>" data-minus>−<%= formatPrice(t.walletUsed) %></dd></div>
          <div class="summary-total"><dt>Amount to pay</dt><dd data-sum="total" data-value="<%= t.total %>"><%= formatPrice(t.total) %></dd></div>
        </dl>
        <p class="saving summary-saving-note" data-saving <%= t.discount + t.couponDiscount > 0 ? '' : 'hidden' %>>You save <span data-sum="savings" data-value="<%= t.discount + t.couponDiscount %>"><%= formatPrice(t.discount + t.couponDiscount) %></span> on this order.</p>
        <p class="hint"><%- icon('shield', 'i-xs') %> Prices are checked again when you place the order.</p>
      </aside>

      <section class="panel coupon-panel" aria-labelledby="coupon-title" data-coupon>
        <h2 id="coupon-title" class="panel-title"><%- icon('ticket', 'i-sm') %> Coupons</h2>
        <div class="coupon-applied" data-coupon-applied <%= quote.coupon ? '' : 'hidden' %>>
          <span class="coupon-chip"><%- icon('tag', 'i-sm') %> <strong data-coupon-code><%= quote.coupon ? quote.coupon.code : '' %></strong></span>
          <span class="coupon-applied-text" data-coupon-saving><%= quote.coupon ? 'You save ' + formatPrice(quote.coupon.saving) : '' %></span>
          <button type="button" class="btn btn-ghost btn-sm" data-coupon-remove>Remove</button>
        </div>
        <form class="coupon-form" data-coupon-form novalidate <%= quote.coupon ? 'hidden' : '' %>>
          <label class="sr-only" for="coupon-code">Coupon code</label>
          <div class="coupon-field">
            <span class="coupon-field-icon" aria-hidden="true"><%- icon('tag', 'i-sm') %></span>
            <input id="coupon-code" name="code" type="text" maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Enter coupon code" aria-describedby="code-error">
            <button class="btn btn-primary btn-sm coupon-apply" type="submit">Apply</button>
          </div>
          <p class="field-error" id="code-error" data-error-for="code"></p>
        </form>
        <p class="coupon-notice" data-coupon-notice role="status" <%= quote.couponNotice ? '' : 'hidden' %>><%- icon('alert', 'i-xs') %> <span><%= quote.couponNotice %></span></p>
      </section>

      <ul class="panel co-promises" aria-label="Our promises">
        <li><span aria-hidden="true"><%- icon('lock', 'i-sm') %></span><span><strong>Secure payment</strong><small>Paid in Razorpay's window. We never see card or UPI details.</small></span></li>
        <li><span aria-hidden="true"><%- icon('truck', 'i-sm') %></span><span><strong>Tracked delivery</strong><small>Live updates by email from dispatch to your door.</small></span></li>
        <li><span aria-hidden="true"><%- icon('shield', 'i-sm') %></span><span><strong>Easy returns</strong><small>See our <a href="/refund-policy">cancellation and wallet credit policy</a> for the details.</small></span></li>
      </ul>
    </div>
  </div>

  <%# Phones: one bar at the bottom for every step. The total opens the price details; the button does
       this step's main action (Deliver here, Continue, Pay). Desktop keeps the sidebar. %>
  <div class="sheet-scrim" data-summary-scrim hidden></div>
  <div class="pay-bar" data-pay-bar>
    <button type="button" class="pay-bar-total" data-summary-open aria-controls="checkout-side" aria-expanded="false">
      <span class="pay-bar-label">Total</span>
      <strong data-sum="total" data-value="<%= t.total %>"><%= formatPrice(t.total) %></strong>
      <span class="pay-bar-more">Details <%- icon('chevron-up', 'i-xs') %></span>
    </button>
    <button type="button" class="btn btn-primary pay-bar-go" data-pay-bar-go>Deliver here</button>
  </div>
</main>

<%- include('../partials/address-dialog') %>
<%- include('../partials/pay-overlay') %>
<%- include('../partials/footer', { scripts: ['profile', 'confetti', 'payment', 'checkout'], razorpay: razorpayEnabled }) %>
