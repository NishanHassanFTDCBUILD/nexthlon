<!doctype html>
<%# Shown by the service worker (public/sw.js) when a page can't load because there is no connection.
    Stored once, signed out, so it stands alone: inline styles, no scripts, no account details. %>
<html lang="en-IN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#0a0a0b">
  <title>You're offline | Nexthlon</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <style>
    :root { color-scheme: dark; --bg: #0a0a0b; --ink: #f4f4f1; --muted: #a3a39c; --brand: #d4ff3a; --line: rgba(255, 255, 255, 0.1); }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; min-height: 100svh; display: grid; place-items: center; padding: 24px max(16px, env(safe-area-inset-left)); background: var(--bg); color: var(--ink); font: 400 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; text-align: center; }
    main { max-width: 420px; display: grid; justify-items: center; gap: 16px; }
    .mark { width: 72px; height: 72px; border-radius: 20px; display: grid; place-items: center; background: #141416; border: 1px solid var(--line); }
    .signal { position: relative; }
    .signal::after { content: ""; position: absolute; inset: -10px; border-radius: 26px; border: 2px solid var(--brand); opacity: 0; }
    @media (prefers-reduced-motion: no-preference) {
      .signal::after { animation: ping 1.8s ease-out infinite; }
      @keyframes ping { from { opacity: 0.6; transform: scale(0.9); } to { opacity: 0; transform: scale(1.25); } }
    }
    h1 { margin: 8px 0 0; font-size: 28px; line-height: 1.15; letter-spacing: -0.01em; text-transform: uppercase; font-weight: 800; }
    p { margin: 0; color: var(--muted); }
    .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
    a { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; border-radius: 999px; font-weight: 700; text-decoration: none; }
    .primary { background: var(--brand); color: #0a0a0b; }
    .ghost { border: 1px solid var(--line); color: var(--ink); }
    a:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
    small { color: var(--muted); font-size: 13px; }
  </style>
</head>
<body>
  <main>
    <div class="signal"><div class="mark" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 32 32"><path fill="#D4FF3A" d="M17.6 4 7 17.5h7.6L13.4 28 25 13.6h-7.7z"/></svg>
    </div></div>
    <h1>No signal, no problem</h1>
    <p>You're offline right now. Your cart and orders are safe on your account; they'll be right here when you're back online.</p>
    <div class="actions">
      <a class="primary" href="">Try again</a>
      <a class="ghost" href="/">Go to home</a>
    </div>
    <small>Nexthlon works best with a connection, so prices and stock are always live.</small>
  </main>
</body>
</html>
