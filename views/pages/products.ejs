<%- include('../partials/head', { metaDescription: category && category.description ? category.description : undefined, styles: ['filters'] }) %>
<%- include('../partials/header') %>

<%
  const firstItem = pagination.total ? (pagination.page - 1) * pagination.limit + 1 : 0;
  const lastItem = Math.min(pagination.page * pagination.limit, pagination.total);
  const BRAND_PREVIEW = 6;
  const shownBrands = facets.brands.slice(0, BRAND_PREVIEW);
  const moreBrands = facets.brands.slice(BRAND_PREVIEW);
  const low = facets.priceLow;
  const high = Math.max(facets.priceHigh, low + 1);
  // Quick price ranges from round amounts that fall inside this list's price range:
  // "Under ₹500", "₹500 – ₹1,000", ..., "₹5,000+" (at most four).
  const rupee = function (n) { return '₹' + n.toLocaleString('en-IN'); };
  const marks = [500, 1000, 2500, 5000, 10000, 25000].filter(function (m) { return m > low && m < high; }).slice(0, 3);
  const pricePresets = [];
  if (marks.length) {
    pricePresets.push({ label: 'Under ' + rupee(marks[0]), min: null, max: marks[0] });
    for (let i = 1; i < marks.length; i++) pricePresets.push({ label: rupee(marks[i - 1]) + ' – ' + rupee(marks[i]), min: marks[i - 1], max: marks[i] });
    pricePresets.push({ label: rupee(marks[marks.length - 1]) + '+', min: marks[marks.length - 1], max: null });
  }
%>
<main id="main" class="container page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <%- icon('chevron-right', 'i-xs') %>
    <% if (category) { %>
      <a href="/products">All gear</a> <%- icon('chevron-right', 'i-xs') %> <span aria-current="page"><%= category.name %></span>
    <% } else { %>
      <span aria-current="page">All gear</span>
    <% } %>
  </nav>

  <div class="catalog" data-catalog>
    <div class="drawer-backdrop" data-filter-close hidden></div>

    <%#
      The filter panel. On a desktop it sits beside the results; on a phone the same markup slides
      up as a bottom sheet (public/js/catalog.js). Every choice is a real radio or checkbox with the
      same name the server reads, styled as pills, stars or a switch, so it works with the keyboard,
      with screen readers and, as a plain GET form, without JavaScript.
    %>
    <aside class="filters fx" id="filter-drawer" aria-label="Filters" data-filter-drawer>
      <div class="filter-panel fx-panel">
        <span class="fx-grip" aria-hidden="true"></span>
        <div class="filter-head fx-head">
          <div class="fx-title">
            <h2><%- icon('sliders', 'i-sm') %> Filters</h2>
            <p class="fx-total" data-filter-total aria-live="polite"><%= pagination.total %> <%= pagination.total === 1 ? 'result' : 'results' %></p>
          </div>
          <span class="count-badge fx-badge" data-filter-count <%= chips.length ? '' : 'hidden' %>><%= chips.length %></span>
          <a class="fx-clear" href="/products<%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>" data-clear-filters <%= chips.length ? '' : 'hidden' %>>Clear all</a>
          <button type="button" class="fx-close filter-close" data-filter-close aria-label="Close filters"><%- icon('x') %></button>
        </div>

        <form id="filters" class="fx-form" action="/products" method="get" data-filter-form>
          <%# Carried along so a filter change never drops the search, sort or layout. %>
          <input type="hidden" name="q" value="<%= filters.q %>">
          <input type="hidden" name="sort" value="<%= filters.sort === 'relevance' ? '' : filters.sort %>">
          <input type="hidden" name="view" value="<%= filters.view === 'list' ? 'list' : '' %>">

          <%# ---------- Category: pills with counts ---------- %>
          <details class="fx-group" data-filter-group="category" open>
            <summary class="fx-group-head"><span>Category</span><i class="fx-dot" data-group-count="category" hidden></i><%- icon('chevron-down', 'i-xs fx-caret') %></summary>
            <fieldset class="fx-group-body">
              <legend class="sr-only">Category</legend>
              <div class="fx-pills">
                <label class="fx-pill">
                  <input type="radio" name="category" value="" <%= !category ? 'checked' : '' %>>
                  <span>All</span>
                </label>
                <% categories.forEach(function (c) { %>
                  <label class="fx-pill">
                    <input type="radio" name="category" value="<%= c.slug %>" <%= category && category.slug === c.slug ? 'checked' : '' %>>
                    <span><%= c.name %></span><em><%= c.count %></em>
                  </label>
                <% }) %>
              </div>
            </fieldset>
          </details>

          <%# ---------- Price: quick presets, a dual slider and two boxes ---------- %>
          <details class="fx-group" data-filter-group="price" open>
            <summary class="fx-group-head"><span>Price</span><i class="fx-dot" data-group-count="price" hidden></i><%- icon('chevron-down', 'i-xs fx-caret') %></summary>
            <fieldset class="fx-group-body fx-price" data-price-filter data-low="<%= low %>" data-high="<%= high %>">
              <legend class="sr-only">Price range in rupees</legend>
              <% if (pricePresets.length) { %>
                <div class="fx-presets" role="group" aria-label="Quick price ranges">
                  <% pricePresets.forEach(function (p) { %>
                    <button type="button" class="fx-preset" data-price-preset data-min="<%= p.min === null ? '' : p.min %>" data-max="<%= p.max === null ? '' : p.max %>"><%= p.label %></button>
                  <% }) %>
                </div>
              <% } %>
              <div class="fx-range" data-range hidden>
                <div class="fx-track" aria-hidden="true"><span class="fx-fill" data-range-fill></span></div>
                <label class="sr-only" for="min-range">Lowest price</label>
                <input id="min-range" type="range" min="<%= low %>" max="<%= high %>" step="1" value="<%= filters.min !== null ? Math.max(low, Math.min(filters.min, high)) : low %>" data-range-min>
                <label class="sr-only" for="max-range">Highest price</label>
                <input id="max-range" type="range" min="<%= low %>" max="<%= high %>" step="1" value="<%= filters.max !== null ? Math.max(low, Math.min(filters.max, high)) : high %>" data-range-max>
              </div>
              <div class="fx-price-boxes">
                <label class="fx-money">
                  <span class="sr-only">Minimum price in rupees</span>
                  <i aria-hidden="true">₹</i>
                  <input id="min-price" type="number" name="min" min="0" step="1" inputmode="numeric" placeholder="<%= low.toLocaleString('en-IN') %>" value="<%= filters.min !== null ? filters.min : '' %>" data-price-min>
                </label>
                <span class="fx-to" aria-hidden="true">–</span>
                <label class="fx-money">
                  <span class="sr-only">Maximum price in rupees</span>
                  <i aria-hidden="true">₹</i>
                  <input id="max-price" type="number" name="max" min="0" step="1" inputmode="numeric" placeholder="<%= high.toLocaleString('en-IN') %>" value="<%= filters.max !== null ? filters.max : '' %>" data-price-max>
                </label>
                <button type="submit" class="fx-go" aria-label="Apply price"><%- icon('arrow-right', 'i-sm') %></button>
              </div>
            </fieldset>
          </details>

          <%# ---------- Brand: a search box and checkboxes ---------- %>
          <% if (facets.brands.length) { %>
            <details class="fx-group" data-filter-group="brand" open>
              <summary class="fx-group-head"><span>Brand</span><i class="fx-dot" data-group-count="brand" hidden></i><%- icon('chevron-down', 'i-xs fx-caret') %></summary>
              <fieldset class="fx-group-body" data-brand-box>
                <legend class="sr-only">Brand</legend>
                <% if (facets.brands.length > BRAND_PREVIEW) { %>
                  <label class="fx-search">
                    <%- icon('search', 'i-xs') %>
                    <span class="sr-only">Find a brand</span>
                    <input type="search" placeholder="Find a brand" autocomplete="off" data-brand-search>
                  </label>
                <% } %>
                <div class="fx-checks">
                  <% facets.brands.forEach(function (b, i) { %>
                    <label class="fx-check<%= i >= BRAND_PREVIEW && !filters.brands.includes(b.name) ? ' is-extra' : '' %>" data-brand-name="<%= b.name.toLowerCase() %>">
                      <input type="checkbox" name="brand" value="<%= b.name %>" <%= filters.brands.includes(b.name) ? 'checked' : '' %>>
                      <span class="fx-box" aria-hidden="true"><%- icon('check', 'i-xs') %></span>
                      <span><%= b.name %></span><em><%= b.count %></em>
                    </label>
                  <% }) %>
                </div>
                <p class="fx-none" data-brand-none hidden>No brand matches.</p>
                <% if (moreBrands.length) { %>
                  <button type="button" class="fx-more" data-brand-more aria-expanded="false">Show all <%= facets.brands.length %> brands</button>
                <% } %>
              </fieldset>
            </details>
          <% } %>

          <%# ---------- Customer rating: star pills ---------- %>
          <details class="fx-group" data-filter-group="rating" open>
            <summary class="fx-group-head"><span>Customer rating</span><i class="fx-dot" data-group-count="rating" hidden></i><%- icon('chevron-down', 'i-xs fx-caret') %></summary>
            <fieldset class="fx-group-body">
              <legend class="sr-only">Customer rating</legend>
              <div class="fx-pills">
                <label class="fx-pill"><input type="radio" name="rating" value="" <%= !filters.rating ? 'checked' : '' %>><span>Any</span></label>
                <% ratingSteps.forEach(function (step) { %>
                  <label class="fx-pill fx-pill-star">
                    <input type="radio" name="rating" value="<%= step %>" <%= filters.rating === step ? 'checked' : '' %>>
                    <span><%= step %><%- icon('star', 'i-xs') %> &amp; up</span>
                  </label>
                <% }) %>
              </div>
            </fieldset>
          </details>

          <%# ---------- Discount: pills ---------- %>
          <details class="fx-group" data-filter-group="discount" open>
            <summary class="fx-group-head"><span>Discount</span><i class="fx-dot" data-group-count="discount" hidden></i><%- icon('chevron-down', 'i-xs fx-caret') %></summary>
            <fieldset class="fx-group-body">
              <legend class="sr-only">Discount</legend>
              <div class="fx-pills">
                <label class="fx-pill"><input type="radio" name="discount" value="" <%= !filters.discount ? 'checked' : '' %>><span>Any</span></label>
                <% discountSteps.forEach(function (step) { %>
                  <label class="fx-pill"><input type="radio" name="discount" value="<%= step %>" <%= filters.discount === step ? 'checked' : '' %>><span><%= step %>%+ off</span></label>
                <% }) %>
              </div>
            </fieldset>
          </details>

          <%# ---------- Availability: a switch ---------- %>
          <div class="fx-group fx-group-flat" data-filter-group-flat="availability">
            <label class="fx-switch">
              <span class="fx-switch-text"><strong>In stock only</strong><small>Hide items that are sold out</small></span>
              <input type="checkbox" name="inStock" value="1" role="switch" <%= filters.inStock ? 'checked' : '' %>>
              <span class="fx-switch-ui" aria-hidden="true"></span>
            </label>
          </div>

          <%# Without JavaScript every choice still works: this submits the form as a plain GET. %>
          <noscript><button type="submit" class="btn btn-primary btn-block">Apply filters</button></noscript>
        </form>

        <%# Phones: the sheet's own footer. "Show results" just closes the sheet (results are already live). %>
        <div class="fx-foot">
          <a class="fx-foot-clear" href="/products" data-clear-filters <%= chips.length ? '' : 'hidden' %>>Clear all</a>
          <button type="button" class="fx-foot-show" data-filter-close>Show <span data-filter-total-num><%= pagination.total %></span> <span data-filter-total-word><%= pagination.total === 1 ? 'result' : 'results' %></span></button>
        </div>
      </div>
    </aside>

    <section class="results" aria-labelledby="results-heading" data-results>
      <div class="results-head">
        <h1 id="results-heading" tabindex="-1"><%= heading %></h1>
        <p class="muted result-count" aria-live="polite" data-results-summary>
          <% if (pagination.total) { %>
            Showing <%= firstItem %>–<%= lastItem %> of <strong><%= pagination.total %></strong> <%= pagination.total === 1 ? 'result' : 'results' %>
          <% } else { %>
            0 results
          <% } %>
        </p>
      </div>
      <% if (category && category.offerPercent) { %>
        <p class="offer-banner"><%- icon('tag', 'i-sm') %> <strong><%= category.offerPercent %>% <%= category.name %> offer</strong> is already applied to the prices below.</p>
      <% } %>

      <div class="toolbar-sticky" data-sticky-toolbar>
        <button type="button" class="btn btn-ghost btn-sm filter-open" data-filter-open aria-controls="filter-drawer" aria-expanded="false">
          <%- icon('sliders', 'i-sm') %> Filters<span class="count-badge" data-filter-count <%= chips.length ? '' : 'hidden' %>><%= chips.length %></span>
        </button>
        <ul class="chips" aria-label="Active filters" data-active-chips <%= chips.length ? '' : 'hidden' %>>
          <% chips.forEach(function (chip) { %>
            <li><a class="chip" href="<%= chip.href %>" aria-label="Remove filter: <%= chip.label %>"><%= chip.label %> <%- icon('x', 'i-xs') %></a></li>
          <% }) %>
          <% if (chips.length) { %><li><a class="chip chip-clear" href="/products" data-clear-filters>Clear all</a></li><% } %>
        </ul>
        <span class="toolbar-hint" <%= chips.length ? 'hidden' : '' %>>Narrow down by sport, brand, price, rating or availability.</span>
        <label class="sort">
          <span>Sort by</span>
          <span class="select-wrap">
            <select name="sort" data-filter-field>
              <% Object.entries(sorts).forEach(function ([key, option]) { %>
                <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            </select>
            <%- icon('chevron-down', 'i-xs') %>
          </span>
        </label>
        <div class="view-toggle" role="group" aria-label="Layout">
          <a class="view-btn <%= filters.view === 'grid' ? 'is-active' : '' %>" href="<%= link({ view: '' }) %>" <%- filters.view === 'grid' ? 'aria-current="true"' : '' %> data-view-link="grid"><%- icon('grid', 'i-sm') %><span class="sr-only">Grid view</span></a>
          <a class="view-btn <%= filters.view === 'list' ? 'is-active' : '' %>" href="<%= link({ view: 'list' }) %>" <%- filters.view === 'list' ? 'aria-current="true"' : '' %> data-view-link="list"><%- icon('menu', 'i-sm') %><span class="sr-only">List view</span></a>
        </div>
        <span class="loading-bar" aria-hidden="true"></span>
      </div>

      <div data-results-content>
      <% if (products.length) { %>
        <div class="product-grid product-grid-3 <%= filters.view === 'list' ? 'is-list' : '' %>">
          <% products.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <%- include('../partials/empty-art', { art: 'search' }) %>
          <h2>No gear matches <%= filters.q ? '"' + filters.q + '"' : 'those filters' %></h2>
          <p>Check the spelling, try a more general word, or remove a filter.</p>
          <a class="btn btn-primary" href="/products">Browse all gear</a>
        </div>
      <% } %>

      <%- include('../partials/pagination') %>
      </div>
    </section>
  </div>
</main>

<%- include('../partials/footer', { scripts: ['catalog'] }) %>
