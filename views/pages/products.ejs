<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="container page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <%- icon('chevron-right', 'i-xs') %>
    <% if (filters.category) { %>
      <a href="/products">All gear</a> <%- icon('chevron-right', 'i-xs') %> <span><%= filters.category %></span>
    <% } else { %>
      <span>All gear</span>
    <% } %>
  </nav>

  <div class="catalog">
    <aside class="filters">
      <details class="filter-panel" data-filter-panel open>
        <summary><%- icon('filter', 'i-sm') %> Filters</summary>
        <form id="filters" class="filter-form" action="/products" method="get" data-auto-submit>
          <% if (filters.q) { %><input type="hidden" name="q" value="<%= filters.q %>"><% } %>

          <fieldset>
            <legend>Category</legend>
            <label class="choice">
              <input type="radio" name="category" value="" <%= !filters.category ? 'checked' : '' %>>
              <span>All categories</span>
            </label>
            <% categories.forEach(function (c) { %>
              <label class="choice">
                <input type="radio" name="category" value="<%= c.name %>" <%= filters.category === c.name ? 'checked' : '' %>>
                <span><%= c.name %></span><em><%= c.count %></em>
              </label>
            <% }) %>
          </fieldset>

          <fieldset>
            <legend>Price (₹)</legend>
            <div class="price-inputs">
              <label class="sr-only" for="min-price">Minimum price</label>
              <input id="min-price" type="number" name="min" min="0" step="1" inputmode="numeric" placeholder="Min" value="<%= filters.min !== null ? filters.min : '' %>">
              <span>to</span>
              <label class="sr-only" for="max-price">Maximum price</label>
              <input id="max-price" type="number" name="max" min="0" step="1" inputmode="numeric" placeholder="Max" value="<%= filters.max !== null ? filters.max : '' %>">
            </div>
            <button type="submit" class="btn btn-secondary btn-sm btn-block">Apply price</button>
          </fieldset>

          <fieldset>
            <legend>Availability</legend>
            <label class="choice">
              <input type="checkbox" name="inStock" value="1" <%= filters.inStock ? 'checked' : '' %>>
              <span>Hide out-of-stock items</span>
            </label>
          </fieldset>

          <% if (chips.length) { %><a class="clear-link" href="/products">Clear all filters</a><% } %>
        </form>
      </details>
    </aside>

    <section class="results" aria-labelledby="results-heading">
      <div class="results-bar">
        <div>
          <h1 id="results-heading"><%= heading %></h1>
          <p class="muted"><%= pagination.total %> <%= pagination.total === 1 ? 'result' : 'results' %></p>
        </div>
        <label class="sort">
          <span>Sort by</span>
          <select name="sort" form="filters" data-auto-submit-field>
            <% Object.entries(sorts).forEach(function ([key, option]) { %>
              <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
        </label>
      </div>

      <% if (chips.length) { %>
        <div class="chips" aria-label="Active filters">
          <% chips.forEach(function (chip) { %>
            <a class="chip" href="<%= chip.href %>" aria-label="Remove filter <%= chip.label %>"><%= chip.label %> <%- icon('x', 'i-xs') %></a>
          <% }) %>
        </div>
      <% } %>

      <% if (products.length) { %>
        <div class="product-grid product-grid-3">
          <% products.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <%- icon('search', 'i-xl') %>
          <h2>No gear matches those filters</h2>
          <p>Try a different word, widen the price range, or browse every sport.</p>
          <a class="btn btn-primary" href="/products">Browse all gear</a>
        </div>
      <% } %>

      <% if (pagination.pages > 1) { %>
        <nav class="pagination" aria-label="Pages">
          <% if (pagination.page > 1) { %>
            <a href="<%= link({ page: pagination.page - 1 }) %>" rel="prev">Previous</a>
          <% } %>
          <% for (let n = 1; n <= pagination.pages; n++) { %>
            <a href="<%= link({ page: n === 1 ? '' : n }) %>" class="<%= n === pagination.page ? 'is-current' : '' %>" <%- n === pagination.page ? 'aria-current="page"' : '' %>><%= n %></a>
          <% } %>
          <% if (pagination.page < pagination.pages) { %>
            <a href="<%= link({ page: pagination.page + 1 }) %>" rel="next">Next</a>
          <% } %>
        </nav>
      <% } %>
    </section>
  </div>
</main>

<%- include('../partials/footer', { scripts: ['catalog'] }) %>
