<%- include('../partials/head', { metaDescription: category && category.description ? category.description : undefined }) %>
<%- include('../partials/header') %>

<%
  const firstItem = pagination.total ? (pagination.page - 1) * pagination.limit + 1 : 0;
  const lastItem = Math.min(pagination.page * pagination.limit, pagination.total);
  const BRAND_PREVIEW = 6;
  const shownBrands = facets.brands.slice(0, BRAND_PREVIEW);
  const moreBrands = facets.brands.slice(BRAND_PREVIEW);
  const low = facets.priceLow;
  const high = Math.max(facets.priceHigh, low + 1);
  const brandPicked = moreBrands.some(function (b) { return filters.brands.includes(b.name); });
  // Groups open by default, and any group holding a choice stays open.
  const openIf = function (condition) { return condition ? ' open' : ''; };
%>
<main id="main" class="container page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <%- icon('chevron-right', 'i-xs') %>
    <% if (category) { %>
      <a href="/products">All gear</a> <%- icon('chevron-right', 'i-xs') %> <span aria-current="page"><%= category.name %></span>
    <% } else { %>
      <span aria-current="page">All gear</span>
    <% } %>
  </nav>

  <div class="catalog" data-catalog>
    <div class="drawer-backdrop" data-filter-close hidden></div>

    <%#
      The filter sidebar. On a desktop it sits beside the results; on a phone the same markup
      slides in as a drawer (public/js/catalog.js). Each group is a <details>, so the groups
      collapse, take the keyboard and report aria-expanded even with JavaScript switched off.
    %>
    <aside class="filters" id="filter-drawer" aria-label="Filters" data-filter-drawer>
      <div class="filter-panel">
        <div class="filter-head">
          <h2><%- icon('sliders', 'i-sm') %> Filters</h2>
          <span class="count-badge" data-filter-count <%= chips.length ? '' : 'hidden' %>><%= chips.length %></span>
          <a class="clear-link" href="/products<%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>" data-clear-filters <%= chips.length ? '' : 'hidden' %>>Clear all</a>
          <button type="button" class="icon-btn filter-close" data-filter-close aria-label="Close filters"><%- icon('x') %></button>
        </div>

        <form id="filters" class="filter-form" action="/products" method="get" data-filter-form>
          <%# Carried along so a filter change never drops the search, sort or layout. %>
          <input type="hidden" name="q" value="<%= filters.q %>">
          <input type="hidden" name="sort" value="<%= filters.sort === 'relevance' ? '' : filters.sort %>">
          <input type="hidden" name="view" value="<%= filters.view === 'list' ? 'list' : '' %>">

          <details class="filter-group" data-filter-group="category"<%- openIf(true) %>>
            <summary class="filter-group-head"><span>Category</span><%- icon('chevron-down', 'i-xs filter-caret') %></summary>
            <fieldset class="filter-group-body">
              <legend class="sr-only">Category</legend>
              <label class="choice">
                <input type="radio" name="category" value="" <%= !category ? 'checked' : '' %>>
                <span>All categories</span>
              </label>
              <% categories.forEach(function (c) { %>
                <label class="choice">
                  <input type="radio" name="category" value="<%= c.slug %>" <%= category && category.slug === c.slug ? 'checked' : '' %>>
                  <span><%= c.name %></span><em><%= c.count %></em>
                </label>
              <% }) %>
            </fieldset>
          </details>

          <details class="filter-group" data-filter-group="price"<%- openIf(true) %>>
            <summary class="filter-group-head"><span>Price</span><%- icon('chevron-down', 'i-xs filter-caret') %></summary>
            <fieldset class="filter-group-body price-filter" data-price-filter data-low="<%= low %>" data-high="<%= high %>">
              <legend class="sr-only">Price range in rupees</legend>
              <div class="range-slider" data-range hidden>
                <div class="range-track" aria-hidden="true"><span class="range-fill" data-range-fill></span></div>
                <label class="sr-only" for="min-range">Lowest price</label>
                <input id="min-range" type="range" min="<%= low %>" max="<%= high %>" step="1" value="<%= filters.min !== null ? Math.max(low, Math.min(filters.min, high)) : low %>" data-range-min>
                <label class="sr-only" for="max-range">Highest price</label>
                <input id="max-range" type="range" min="<%= low %>" max="<%= high %>" step="1" value="<%= filters.max !== null ? Math.max(low, Math.min(filters.max, high)) : high %>" data-range-max>
              </div>
              <div class="price-inputs">
                <label class="sr-only" for="min-price">Minimum price in rupees</label>
                <input id="min-price" type="number" name="min" min="0" step="1" inputmode="numeric" placeholder="₹<%= low.toLocaleString('en-IN') %>" value="<%= filters.min !== null ? filters.min : '' %>" data-price-min>
                <span aria-hidden="true">to</span>
                <label class="sr-only" for="max-price">Maximum price in rupees</label>
                <input id="max-price" type="number" name="max" min="0" step="1" inputmode="numeric" placeholder="₹<%= high.toLocaleString('en-IN') %>" value="<%= filters.max !== null ? filters.max : '' %>" data-price-max>
              </div>
              <button type="submit" class="btn btn-secondary btn-sm btn-block">Apply price</button>
            </fieldset>
          </details>

          <% if (facets.brands.length) { %>
            <details class="filter-group" data-filter-group="brand"<%- openIf(true) %>>
              <summary class="filter-group-head"><span>Brand</span><%- icon('chevron-down', 'i-xs filter-caret') %></summary>
              <fieldset class="filter-group-body">
                <legend class="sr-only">Brand</legend>
                <% shownBrands.forEach(function (b) { %>
                  <label class="choice">
                    <input type="checkbox" name="brand" value="<%= b.name %>" <%= filters.brands.includes(b.name) ? 'checked' : '' %>>
                    <span><%= b.name %></span><em><%= b.count %></em>
                  </label>
                <% }) %>
                <% if (moreBrands.length) { %>
                  <details class="more-choices"<%- openIf(brandPicked) %>>
                    <summary><%= moreBrands.length %> more brands</summary>
                    <% moreBrands.forEach(function (b) { %>
                      <label class="choice">
                        <input type="checkbox" name="brand" value="<%= b.name %>" <%= filters.brands.includes(b.name) ? 'checked' : '' %>>
                        <span><%= b.name %></span><em><%= b.count %></em>
                      </label>
                    <% }) %>
                  </details>
                <% } %>
              </fieldset>
            </details>
          <% } %>

          <details class="filter-group" data-filter-group="rating"<%- openIf(true) %>>
            <summary class="filter-group-head"><span>Customer rating</span><%- icon('chevron-down', 'i-xs filter-caret') %></summary>
            <fieldset class="filter-group-body">
              <legend class="sr-only">Customer rating</legend>
              <label class="choice"><input type="radio" name="rating" value="" <%= !filters.rating ? 'checked' : '' %>><span>Any rating</span></label>
              <% ratingSteps.forEach(function (step) { %>
                <label class="choice">
                  <input type="radio" name="rating" value="<%= step %>" <%= filters.rating === step ? 'checked' : '' %>>
                  <span class="rating" style="--rating: <%= step %>" aria-hidden="true"></span><span><%= step %>★ and up</span>
                </label>
              <% }) %>
            </fieldset>
          </details>

          <details class="filter-group" data-filter-group="discount"<%- openIf(Boolean(filters.discount)) %>>
            <summary class="filter-group-head"><span>Discount</span><%- icon('chevron-down', 'i-xs filter-caret') %></summary>
            <fieldset class="filter-group-body">
              <legend class="sr-only">Discount</legend>
              <label class="choice"><input type="radio" name="discount" value="" <%= !filters.discount ? 'checked' : '' %>><span>Any discount</span></label>
              <% discountSteps.forEach(function (step) { %>
                <label class="choice"><input type="radio" name="discount" value="<%= step %>" <%= filters.discount === step ? 'checked' : '' %>><span><%= step %>% off or more</span></label>
              <% }) %>
            </fieldset>
          </details>

          <details class="filter-group" data-filter-group="availability"<%- openIf(true) %>>
            <summary class="filter-group-head"><span>Availability</span><%- icon('chevron-down', 'i-xs filter-caret') %></summary>
            <fieldset class="filter-group-body">
              <legend class="sr-only">Availability</legend>
              <label class="choice choice-switch">
                <input type="checkbox" name="inStock" value="1" <%= filters.inStock ? 'checked' : '' %>>
                <span>Hide out-of-stock items</span>
              </label>
            </fieldset>
          </details>

          <%# Without JavaScript every choice still works: this submits the form as a plain GET. %>
          <noscript><button type="submit" class="btn btn-primary btn-block">Apply filters</button></noscript>
        </form>
      </div>
    </aside>

    <section class="results" aria-labelledby="results-heading" data-results>
      <div class="results-head">
        <h1 id="results-heading" tabindex="-1"><%= heading %></h1>
        <p class="muted result-count" aria-live="polite" data-results-summary>
          <% if (pagination.total) { %>
            Showing <%= firstItem %>–<%= lastItem %> of <strong><%= pagination.total %></strong> <%= pagination.total === 1 ? 'result' : 'results' %>
          <% } else { %>
            0 results
          <% } %>
        </p>
      </div>
      <% if (category && category.offerPercent) { %>
        <p class="offer-banner"><%- icon('tag', 'i-sm') %> <strong><%= category.offerPercent %>% <%= category.name %> offer</strong> is already applied to the prices below.</p>
      <% } %>

      <div class="toolbar-sticky" data-sticky-toolbar>
        <button type="button" class="btn btn-ghost btn-sm filter-open" data-filter-open aria-controls="filter-drawer" aria-expanded="false">
          <%- icon('sliders', 'i-sm') %> Filters<span class="count-badge" data-filter-count <%= chips.length ? '' : 'hidden' %>><%= chips.length %></span>
        </button>
        <ul class="chips" aria-label="Active filters" data-active-chips <%= chips.length ? '' : 'hidden' %>>
          <% chips.forEach(function (chip) { %>
            <li><a class="chip" href="<%= chip.href %>" aria-label="Remove filter: <%= chip.label %>"><%= chip.label %> <%- icon('x', 'i-xs') %></a></li>
          <% }) %>
          <% if (chips.length) { %><li><a class="chip chip-clear" href="/products" data-clear-filters>Clear all</a></li><% } %>
        </ul>
        <span class="toolbar-hint" <%= chips.length ? 'hidden' : '' %>>Narrow down by sport, brand, price, rating or availability.</span>
        <label class="sort">
          <span>Sort by</span>
          <span class="select-wrap">
            <select name="sort" data-filter-field>
              <% Object.entries(sorts).forEach(function ([key, option]) { %>
                <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            </select>
            <%- icon('chevron-down', 'i-xs') %>
          </span>
        </label>
        <div class="view-toggle" role="group" aria-label="Layout">
          <a class="view-btn <%= filters.view === 'grid' ? 'is-active' : '' %>" href="<%= link({ view: '' }) %>" <%- filters.view === 'grid' ? 'aria-current="true"' : '' %> data-view-link="grid"><%- icon('grid', 'i-sm') %><span class="sr-only">Grid view</span></a>
          <a class="view-btn <%= filters.view === 'list' ? 'is-active' : '' %>" href="<%= link({ view: 'list' }) %>" <%- filters.view === 'list' ? 'aria-current="true"' : '' %> data-view-link="list"><%- icon('menu', 'i-sm') %><span class="sr-only">List view</span></a>
        </div>
        <span class="loading-bar" aria-hidden="true"></span>
      </div>

      <div data-results-content>
      <% if (products.length) { %>
        <div class="product-grid product-grid-3 <%= filters.view === 'list' ? 'is-list' : '' %>">
          <% products.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <%- include('../partials/empty-art', { art: 'search' }) %>
          <h2>No gear matches <%= filters.q ? '"' + filters.q + '"' : 'those filters' %></h2>
          <p>Check the spelling, try a more general word, or remove a filter.</p>
          <a class="btn btn-primary" href="/products">Browse all gear</a>
        </div>
      <% } %>

      <%- include('../partials/pagination') %>
      </div>
    </section>
  </div>
</main>

<%- include('../partials/footer', { scripts: ['catalog'] }) %>
