{
  "name": "nexthlon",
  "version": "1.0.0",
  "private": true,
  "description": "Nexthlon sports e-commerce: Express, EJS, MongoDB and JWT authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "stop": "taskkill /F /IM node.exe",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:products": "node scripts/seedProducts.js",
    "seed:coupons": "node scripts/seedCoupons.js",
    "db:check": "node scripts/checkDb.js",
    "db:indexes": "node scripts/dbIndexes.js",
    "setup:check": "node scripts/setupCheck.js",
    "worker": "node scripts/worker.js",
    "jobs:status": "node scripts/jobsStatus.js",
    "jobs:retry": "node scripts/jobsStatus.js --retry",
    "emails:preview": "node scripts/previewEmails.js",
    "images:migrate": "node scripts/migrateImages.js",
    "load:test": "node scripts/loadTest.js",
    "test": "node --test",
    "db:backup": "node scripts/backup.js backup",
    "db:restore": "node scripts/backup.js restore",
    "screenshots": "node scripts/screenshots.js",
    "push:keys": "node scripts/pushKeys.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:css:fix": "stylelint \"public/**/*.css\" --fix",
    "check": "npm run lint && npm run lint:css && npm run format:check && npm test",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@sentry/node": "11.12.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "qrcode": "1.5.4",
    "razorpay": "^2.9.6",
    "redis": "6.3.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,webmanifest}": [
      "prettier --write"
    ]
  }
}
