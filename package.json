{
  "name": "nexthlon",
  "version": "1.0.0",
  "private": true,
  "description": "Nexthlon sports e-commerce: Express, EJS, MongoDB and JWT authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "stop": "taskkill /F /IM node.exe",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:products": "node scripts/seedProducts.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^7.0.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
